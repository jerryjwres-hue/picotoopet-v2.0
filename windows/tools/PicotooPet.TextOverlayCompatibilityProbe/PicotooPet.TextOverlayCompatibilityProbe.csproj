<Project Sdk="Microsoft.NET.Sdk">
  <!--
    S004 isolated spike. Not referenced by PicotooPet.Desktop.sln or any shipped package.
    No NuGet packages: only fixed ffmpeg.exe / ffprobe.exe from PATH (same policy as the Desktop renderers).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PicotooPet.TextOverlayCompatibilityProbe</RootNamespace>
    <AssemblyName>PicotooPet.TextOverlayCompatibilityProbe</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Authored without a local .NET SDK; analyzers must not mask real Windows results. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
