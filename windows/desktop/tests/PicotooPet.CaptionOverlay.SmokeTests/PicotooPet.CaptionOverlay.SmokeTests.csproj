<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Isolated C008B harness: NOT part of PicotooPet.Desktop.sln and independent of the shared
    PicotooPet.Desktop.Core.SmokeTests/Program.cs, so parallel Production work cannot conflict.
    Run: dotnet run --project windows/desktop/tests/PicotooPet.CaptionOverlay.SmokeTests -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PicotooPet.CaptionOverlay.SmokeTests</RootNamespace>
    <!-- Harness authored without a local .NET SDK; analyzers must not mask real results. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PicotooPet.Desktop.Core\PicotooPet.Desktop.Core.csproj" />
    <ProjectReference Include="..\..\src\PicotooPet.Desktop\PicotooPet.Desktop.csproj" />
    <None Include="SamplePlanResponse.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
