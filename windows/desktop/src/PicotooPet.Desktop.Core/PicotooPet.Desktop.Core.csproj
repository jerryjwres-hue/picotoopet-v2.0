    <RootNamespace>PicotooPet.Desktop.Core</RootNamespace>
    <AssemblyName>PicotooPet.Desktop.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- CPU image decoding belongs to shared Core rather than UI/tray startup. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <EmbeddedResource Include="../../../production/workflows/wan22-ti2v5b-t2v-api-v1.json"
                      LogicalName="PicotooPet.Production.Workflows.wan22-ti2v5b-t2v-api-v1.json" />
    <EmbeddedResource Include="../../../production/workflows/wan22-ti2v5b-i2v-api-v1.json"
                      LogicalName="PicotooPet.Production.Workflows.wan22-ti2v5b-i2v-api-v1.json" />
    <EmbeddedResource Include="../../../bootstrap/model_manifest.json"
                      LogicalName="PicotooPet.Desktop.Core.Production.Resources.model_manifest.json" />
  </ItemGroup>
</Project>
