<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- 颜色令牌：统一 Simple Mode 与高级页面的视觉语义。 -->
  <SolidColorBrush x:Key="PicoPageBackgroundBrush" Color="#FFF6F9FE" />
  <SolidColorBrush x:Key="PicoSurfaceBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="PicoSurfaceSoftBrush" Color="#FFF8FBFF" />
  <SolidColorBrush x:Key="PicoBorderBrush" Color="#FFDDE6F2" />
  <SolidColorBrush x:Key="PicoBorderStrongBrush" Color="#FFC8D7EA" />
  <SolidColorBrush x:Key="PicoTextBrush" Color="#FF152033" />
  <SolidColorBrush x:Key="PicoTextMutedBrush" Color="#FF6B7890" />
  <SolidColorBrush x:Key="PicoPrimaryBrush" Color="#FF1478FF" />
  <SolidColorBrush x:Key="PicoPrimarySoftBrush" Color="#FFEAF3FF" />
  <SolidColorBrush x:Key="PicoSuccessBrush" Color="#FF11A978" />
  <SolidColorBrush x:Key="PicoSuccessSoftBrush" Color="#FFE9FBF4" />
  <SolidColorBrush x:Key="PicoWarningBrush" Color="#FFF08A24" />
  <SolidColorBrush x:Key="PicoWarningSoftBrush" Color="#FFFFF5E6" />
  <SolidColorBrush x:Key="PicoDangerBrush" Color="#FFE34C5E" />
  <SolidColorBrush x:Key="PicoDangerSoftBrush" Color="#FFFFEEF0" />
  <SolidColorBrush x:Key="PicoSidebarBrush" Color="#FF08234B" />
  <SolidColorBrush x:Key="PicoSidebarSoftBrush" Color="#FF103768" />

  <!-- 字体：优先使用 Windows 默认中文 UI 字体，避免额外字体依赖。 -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="Foreground" Value="{StaticResource PicoTextBrush}" />
  </Style>

  <!-- 全局按钮：去掉默认灰色 WPF 外观，同时保持所有既有 Click 行为不变。 -->
  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PicoTextBrush}" />
    <Setter Property="Background" Value="{StaticResource PicoSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PicoBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
              <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5" />
              <Setter TargetName="ButtonBorder" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource PicoPrimaryBrush}" />
              <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PicoPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource PicoPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PicoPrimaryBrush}" />
  </Style>

  <Style x:Key="PicoSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource PicoPrimaryBrush}" />
    <Setter Property="Background" Value="{StaticResource PicoPrimarySoftBrush}" />
    <Setter Property="BorderBrush" Value="#FFCCE0FF" />
  </Style>

  <Style x:Key="PicoDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource PicoDangerBrush}" />
    <Setter Property="Background" Value="{StaticResource PicoDangerSoftBrush}" />
    <Setter Property="BorderBrush" Value="#FFFFCCD2" />
  </Style>

  <!-- 输入控件：只调整安全的基础属性，不重写行为模板。 -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource PicoTextBrush}" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource PicoBorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource PicoBorderStrongBrush}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Margin" Value="4" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="Foreground" Value="{StaticResource PicoTextBrush}" />
    <Setter Property="Margin" Value="5" />
  </Style>

  <!-- 表格统一为清爽的浅色产品风格；不改变选择或编辑逻辑。 -->
  <Style TargetType="DataGrid">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource PicoBorderBrush}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#FFEDF2F8" />
    <Setter Property="RowBackground" Value="White" />
    <Setter Property="AlternatingRowBackground" Value="#FFFAFCFF" />
    <Setter Property="HeadersVisibility" Value="Column" />
  </Style>

  <!-- 可复用卡片和文本层级。 -->
  <Style x:Key="PicoCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PicoSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource PicoBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <Style x:Key="PicoSoftCardStyle" TargetType="Border" BasedOn="{StaticResource PicoCardStyle}">
    <Setter Property="Background" Value="{StaticResource PicoSurfaceSoftBrush}" />
  </Style>

  <Style x:Key="PicoPageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource PicoTextBrush}" />
  </Style>

  <Style x:Key="PicoSectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PicoTextBrush}" />
  </Style>

  <Style x:Key="PicoMutedTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PicoTextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="PicoPillTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</ResourceDictionary>
