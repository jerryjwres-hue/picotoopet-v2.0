<Window x:Class="PicotooPet.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PicotooPet.Desktop.Views"
        Title="Picotoo Pet AI"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="36" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FF161A22" Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Picotoo Pet AI" Foreground="White" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Phase 2 性能优先双机控制链" Foreground="#FFB7C0D0" FontSize="13" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="连接：" Foreground="#FFB7C0D0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ConnectionText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="20">
      <TabItem Header="总览">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="4">
              <StackPanel>
                <TextBlock Text="Mac Core" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HealthText}" FontSize="18" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="4">
              <StackPanel>
                <TextBlock Text="链路延迟" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LatencyText}" FontSize="18" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="4">
              <StackPanel>
                <TextBlock Text="任务数量" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Tasks.Count}" FontSize="18" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="14" Margin="4,0,4,16">
            <StackPanel Orientation="Horizontal">
              <TextBox Width="300" Text="{Binding TaskType, UpdateSourceTrigger=PropertyChanged}" ToolTip="任务类型，例如 analysis" />
              <Button Content="创建任务" Command="{Binding SubmitTaskCommand}" />
              <Button Content="刷新" Command="{Binding RefreshCommand}" />
              <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <ListView Grid.Row="2"
                    ItemsSource="{Binding Tasks}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.IsDeferredScrollingEnabled="True">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="任务类型" Width="180" DisplayMemberBinding="{Binding TaskType}" />
                <GridViewColumn Header="状态" Width="140" DisplayMemberBinding="{Binding Status}" />
                <GridViewColumn Header="更新时间" Width="190" DisplayMemberBinding="{Binding UpdatedAt}" />
                <GridViewColumn Header="任务 ID" Width="330" DisplayMemberBinding="{Binding TaskId}" />
                <GridViewColumn Header="错误" Width="220" DisplayMemberBinding="{Binding Error}" />
              </GridView>
            </ListView.View>
          </ListView>
        </Grid>
      </TabItem>

      <TabItem Header="生产" IsSelected="{Binding Production.IsActive, Mode=TwoWay}">
        <views:ProductionView DataContext="{Binding Production}" />
      </TabItem>

      <TabItem Header="创作台">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="粘贴 Claude、Muse 或 ChatGPT 输出的 StoryPack v1 JSON" FontSize="16"
                     FontWeight="SemiBold" Margin="0,0,0,12" />
          <!-- 本页只预览故事包；模型生成和 GPU 任务均由后续受控审批启用。 -->
          <TextBox Grid.Row="1" Text="{Binding StoryPackInput, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                   FontFamily="Consolas" FontSize="13" Padding="12"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   ToolTip="粘贴 picotoo.storypack.v1 JSON；不会执行生成" />
          <Button Grid.Row="2" Content="验证 StoryPack（只读）"
                  Command="{Binding PreviewStoryPackCommand}"
                  HorizontalAlignment="Left" Padding="18,8" Margin="0,12,0,12" />
          <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="12"
                  CornerRadius="8">
            <!-- 镜头计划较长时允许独立滚动，避免撑开整个控制中心窗口。 -->
            <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding StoryPackPreviewText}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="连接设置">
        <Grid Margin="20" MaxWidth="720" HorizontalAlignment="Left">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Mac Core 安全地址（SSH 隧道：http://127.0.0.1:18766 或可信 HTTPS）" FontWeight="SemiBold" />
          <TextBox Grid.Row="1" x:Name="MacBaseUrlTextBox" Text="{Binding MacBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Grid.Row="2" Text="设备令牌（仅保存到 Windows Credential Manager）" FontWeight="SemiBold" Margin="0,12,0,0" />
          <StackPanel Grid.Row="3" Orientation="Horizontal">
            <PasswordBox x:Name="TokenPasswordBox" Width="420" Margin="4" Padding="8,6" />
            <Button Content="保存并连接" Click="SaveAndConnect_Click" />
          </StackPanel>
          <!-- 仅在桌面显示一次性验证码；手机浏览器永远不接触设备 Token。 -->
          <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <TextBlock Text="手机只读控制台（需要 HTTPS）" FontWeight="SemiBold" />
            <Button Content="生成手机配对码" Command="{Binding PairMobileCommand}"
                    HorizontalAlignment="Left" Padding="14,8" Margin="0,8,0,8" />
            <TextBlock Text="{Binding MobilePairingText}" TextWrapping="Wrap"
                       Foreground="#FF475569" />
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#FFF1F3F6" Padding="12,6">
      <TextBlock Text="任务和事件均经 SQLite + Outbox 耐久提交；断线恢复按事件序号续传。" Foreground="#FF4B5563" />
    </Border>
  </Grid>
</Window>
