<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PicotooPet.Desktop</RootNamespace>
    <AssemblyName>Picotoo Pet AI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>PicotooPet.Desktop.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- #162 controller exception: exact managed Ed25519 primitive; no runtime download. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="[2.7.0]" />
    <ProjectReference Include="..\PicotooPet.Desktop.Core\PicotooPet.Desktop.Core.csproj" />
    <!-- Preview-only managed CPU WebP codec: separate from zero-package Core and built-in system tray. -->
    <ProjectReference Include="..\PicotooPet.ReferencePreview.Codecs\PicotooPet.ReferencePreview.Codecs.csproj" />
    <Resource Include="Assets\Pet\Husky\V1\*.png" />

    <!-- Maotai v2 art : independent transparent raster parts are copied into the published payload unchanged. -->
    <Content Include="Assets\Maotai\V2\**\*.png">
      <Link>ui-assets\maotai\v2\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>

    <Content Include="..\..\..\..\src\picotoopet_core\product-version.txt"
             Link="product-version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
