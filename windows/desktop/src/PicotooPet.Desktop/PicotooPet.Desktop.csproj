<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PicotooPet.Desktop</RootNamespace>
    <AssemblyName>Picotoo Pet AI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>PicotooPet.Desktop.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PicotooPet.Desktop.Core\PicotooPet.Desktop.Core.csproj" />
    <Content Include="..\..\..\..\src\picotoopet_core\product-version.txt"
             Link="product-version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- 茅台素材保持为独立 WPF Resource；缺失素材由组件自身静默降级，不影响主程序。 -->
    <Resource Include="Assets\PetMascot\*.png" />
  </ItemGroup>
</Project>
