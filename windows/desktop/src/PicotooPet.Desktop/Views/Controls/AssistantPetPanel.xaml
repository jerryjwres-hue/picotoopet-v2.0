<UserControl x:Class="PicotooPet.Desktop.Views.Controls.AssistantPetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="Transparent"
             Loaded="PetSurface_Loaded"
             Unloaded="PetSurface_Unloaded"
             IsVisibleChanged="PetSurface_IsVisibleChanged"
             MouseEnter="PetSurface_MouseEnter"
             MouseLeave="PetSurface_MouseLeave"
             MouseMove="PetSurface_MouseMove"
             MouseLeftButtonDown="PetSurface_MouseLeftButtonDown"
             MouseLeftButtonUp="PetSurface_MouseLeftButtonUp"
             MouseDoubleClick="PetSurface_MouseDoubleClick"
             KeyDown="PetSurface_KeyDown">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="PetCardBackground" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF082B4C" Offset="0" />
      <GradientStop Color="#FF07385F" Offset="0.54" />
      <GradientStop Color="#FF092947" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="PetMiniButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#183A88C7" />
      <Setter Property="BorderBrush" Value="#425F9BC8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#FFCFE9FF" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Background" Value="#314D9DE0" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border x:Name="CardBorder"
          CornerRadius="14"
          Padding="12"
          Background="{StaticResource PetCardBackground}"
          BorderBrush="#FF176AA9"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="170" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid x:Name="HeaderPanel" Grid.Row="0" Margin="0,0,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="AI 助手状态"
                     Foreground="White"
                     FontSize="12"
                     FontWeight="SemiBold" />
          <Border Margin="7,0,0,0"
                  Padding="5,1"
                  CornerRadius="5"
                  Background="#253FA7E8">
            <TextBlock Text="茅台"
                       Foreground="#FF8ED0FF"
                       FontSize="7.5"
                       FontWeight="SemiBold" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="IndicatorDot"
                   Width="8"
                   Height="8"
                   Fill="#FF8A9AAD"
                   Margin="0,0,7,0" />
          <Button x:Name="FloatButton"
                  Content="↗"
                  ToolTip="放到桌面"
                  Style="{StaticResource PetMiniButtonStyle}"
                  Padding="5,2"
                  Click="FloatButton_Click" />
        </StackPanel>
      </Grid>

      <TextBlock x:Name="DetailText"
                 Grid.Row="1"
                 Text="正在读取系统状态…"
                 Foreground="#FF9FC6E5"
                 FontSize="9.5"
                 TextTrimming="CharacterEllipsis"
                 Margin="0,0,0,2" />

      <Canvas x:Name="PetStage"
              Grid.Row="2"
              Width="184"
              Height="170"
              HorizontalAlignment="Center"
              ClipToBounds="False">
        <Ellipse Width="142"
                 Height="24"
                 Canvas.Left="21"
                 Canvas.Top="137"
                 Fill="#54030E1B" />

        <Canvas x:Name="PetMotionLayer"
                Width="150"
                Height="150"
                Canvas.Left="17"
                Canvas.Top="2"
                RenderTransformOrigin="0.5,0.64">
          <Canvas.RenderTransform>
            <TransformGroup>
              <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
              <RotateTransform x:Name="PetRotate" Angle="0" />
              <TranslateTransform x:Name="PetTranslate" X="0" Y="0" />
            </TransformGroup>
          </Canvas.RenderTransform>

          <!-- Q-version Maotai raster rig: the visible character is illustrated PNG art, not WPF dog geometry. -->
          <Grid x:Name="MaotaiRasterLayer" Width="150" Height="150">
            <Image x:Name="MaotaiBody"
                   Width="150"
                   Height="150"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Image x:Name="MaotaiTail"
                   Width="150"
                   Height="150"
                   Stretch="Uniform"
                   Opacity="0"
                   RenderTransformOrigin="0.24,0.62"
                   RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip>
                <RectangleGeometry Rect="0,38,58,88" RadiusX="18" RadiusY="18" />
              </Image.Clip>
              <Image.RenderTransform>
                <RotateTransform x:Name="MaotaiTailRotate" Angle="0" />
              </Image.RenderTransform>
            </Image>

            <Image x:Name="MaotaiHead"
                   Width="150"
                   Height="150"
                   Stretch="Uniform"
                   Opacity="0"
                   RenderTransformOrigin="0.55,0.47"
                   RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip>
                <RectangleGeometry Rect="27,0,116,105" RadiusX="34" RadiusY="34" />
              </Image.Clip>
              <Image.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="MaotaiHeadRotate" Angle="0" />
                  <TranslateTransform x:Name="MaotaiHeadTranslate" X="0" Y="0" />
                </TransformGroup>
              </Image.RenderTransform>
            </Image>

            <Image x:Name="MaotaiLeftPawImage"
                   Width="150"
                   Height="150"
                   Stretch="Uniform"
                   Opacity="0"
                   RenderTransformOrigin="0.43,0.76"
                   RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip>
                <RectangleGeometry Rect="38,82,54,55" RadiusX="18" RadiusY="18" />
              </Image.Clip>
              <Image.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="MaotaiLeftPawRotate" Angle="0" />
                  <TranslateTransform x:Name="MaotaiLeftPawTranslate" X="0" Y="0" />
                </TransformGroup>
              </Image.RenderTransform>
            </Image>

            <Image x:Name="MaotaiRightPawImage"
                   Width="150"
                   Height="150"
                   Stretch="Uniform"
                   Opacity="0"
                   RenderTransformOrigin="0.60,0.74"
                   RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Clip>
                <RectangleGeometry Rect="72,80,50,55" RadiusX="18" RadiusY="18" />
              </Image.Clip>
              <Image.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="MaotaiRightPawRotate" Angle="0" />
                  <TranslateTransform x:Name="MaotaiRightPawTranslate" X="0" Y="0" />
                </TransformGroup>
              </Image.RenderTransform>
            </Image>

            <!-- Named face surfaces remain image layers for the v1.3 rig contract and future fine-grained exports. -->
            <Image x:Name="FaceEyes" Width="150" Height="150" Opacity="0" IsHitTestVisible="False" />
            <Image x:Name="FaceBrows" Width="150" Height="150" Opacity="0" IsHitTestVisible="False" />
            <Image x:Name="FaceMouth" Width="150" Height="150" Opacity="0" IsHitTestVisible="False" />
          </Grid>

          <!-- Compatibility-only vector controls keep v1.2 animation/test contracts alive but are never rendered. -->
          <Canvas x:Name="LegacyCharacterLayer"
                  Width="100"
                  Height="132"
                  Canvas.Left="25"
                  Canvas.Top="9"
                  Opacity="0"
                  IsHitTestVisible="False">
            <Canvas x:Name="HeadLayer" Width="100" Height="92" RenderTransformOrigin="0.5,0.55">
              <Canvas.RenderTransform>
                <TransformGroup>
                  <RotateTransform x:Name="HeadRotate" Angle="0" />
                  <TranslateTransform x:Name="HeadTranslate" X="0" Y="0" />
                </TransformGroup>
              </Canvas.RenderTransform>
              <Path x:Name="LeftEar" Data="M 20,30 L 18,2 L 42,25 Z" Fill="#FF172433" />
              <Path x:Name="RightEar" Data="M 58,25 L 82,2 L 80,30 Z" Fill="#FF172433" />
              <Ellipse Width="72" Height="67" Canvas.Left="14" Canvas.Top="22" Fill="#FF1C2A3B" />
              <Ellipse x:Name="LeftEye" Width="16" Height="18" Canvas.Left="32" Canvas.Top="43" Fill="White" />
              <Ellipse x:Name="RightEye" Width="16" Height="18" Canvas.Left="56" Canvas.Top="43" Fill="White" />
              <Ellipse x:Name="LeftPupil" Width="7" Height="8" Canvas.Left="36" Canvas.Top="48" Fill="#FF17202B" />
              <Ellipse x:Name="RightPupil" Width="7" Height="8" Canvas.Left="64" Canvas.Top="48" Fill="#FF17202B" />
              <Path x:Name="LeftBrow" Data="M 30,39 Q 38,34 46,39" Stroke="#FF111821" StrokeThickness="2" />
              <Path x:Name="RightBrow" Data="M 56,39 Q 64,34 72,39" Stroke="#FF111821" StrokeThickness="2" />
              <Ellipse x:Name="LeftBlush" Width="12" Height="5" Canvas.Left="25" Canvas.Top="64" Fill="#FFFF8EA1" />
              <Ellipse x:Name="RightBlush" Width="12" Height="5" Canvas.Left="68" Canvas.Top="64" Fill="#FFFF8EA1" />
              <Ellipse x:Name="Muzzle" Width="39" Height="27" Canvas.Left="34" Canvas.Top="57" Fill="#FFF0F3F5" />
              <Path x:Name="Mouth" Data="M 44,72 Q 52,79 60,72" Stroke="#FF2A1A18" StrokeThickness="2" Fill="Transparent" />
              <Ellipse x:Name="Tongue" Width="12" Height="10" Canvas.Left="47" Canvas.Top="71" Fill="#FFFF8EA1" />
            </Canvas>
            <Ellipse x:Name="LeftPaw" Width="25" Height="35" Canvas.Left="21" Canvas.Top="87" Fill="#FFEDF1F4" />
            <Ellipse x:Name="RightPaw" Width="25" Height="35" Canvas.Left="58" Canvas.Top="87" Fill="#FFEDF1F4" />
            <Path x:Name="LegacyTail" Data="M 82,96 C 112,84 111,115 88,118" Stroke="#FF1B2939" StrokeThickness="14" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.85,0.85">
              <Path.RenderTransform>
                <RotateTransform x:Name="TailRotate" Angle="-28" />
              </Path.RenderTransform>
            </Path>
            <Border x:Name="Laptop" Width="61" Height="34" Canvas.Left="23" Canvas.Top="94" Background="#FF718096" CornerRadius="4" />
            <Border x:Name="BathTub" Width="92" Height="38" Canvas.Left="5" Canvas.Top="92" Background="#FF4A9FF5" CornerRadius="10" Visibility="Collapsed" />
            <Ellipse x:Name="BathDuck" Width="15" Height="15" Canvas.Left="70" Canvas.Top="87" Fill="#FFFFD83D" RenderTransformOrigin="0.5,0.8">
              <Ellipse.RenderTransform>
                <RotateTransform x:Name="BathDuckRotate" Angle="0" />
              </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="BathBubbleOne" Width="10" Height="10" Canvas.Left="13" Canvas.Top="85" Fill="#99FFFFFF" />
            <Ellipse x:Name="BathBubbleTwo" Width="8" Height="8" Canvas.Left="88" Canvas.Top="81" Fill="#99FFFFFF" />
            <TextBlock x:Name="SleepZzz" Text="Zzz" Canvas.Left="68" Canvas.Top="35" Foreground="#FF83C9FF" FontWeight="Bold" Visibility="Collapsed" />
            <TextBlock x:Name="WaitBubble" Text="?" Canvas.Left="86" Canvas.Top="38" Foreground="#FFFFC34D" FontSize="20" FontWeight="Bold" Visibility="Collapsed" />
          </Canvas>

          <TextBlock x:Name="EmotionGlyph"
                     Text="✨"
                     FontSize="17"
                     Foreground="#FFFFD86B"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,11,5,0"
                     Opacity="0"
                     IsHitTestVisible="False" />
        </Canvas>

        <Ellipse x:Name="FloatingIndicatorDot"
                 Width="10"
                 Height="10"
                 Canvas.Left="158"
                 Canvas.Top="14"
                 Fill="#FF8A9AAD"
                 Stroke="#CFFFFFFF"
                 StrokeThickness="1.5"
                 Visibility="Collapsed" />
        <TextBlock x:Name="ReactionText"
                   Text=""
                   Canvas.Left="22"
                   Canvas.Top="4"
                   Width="140"
                   TextAlignment="Center"
                   Foreground="White"
                   FontSize="10"
                   FontWeight="SemiBold"
                   Opacity="0"
                   IsHitTestVisible="False" />
      </Canvas>

      <Grid x:Name="FooterPanel" Grid.Row="3" Margin="0,2,0,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="ModeTitleText"
                     Text="状态读取中"
                     Foreground="White"
                     FontSize="11"
                     FontWeight="SemiBold" />
          <TextBlock Text="Q版阿拉斯加 · 茅台"
                     Foreground="#FF75ACD5"
                     FontSize="8"
                     Margin="0,1,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="放到桌面 ↗"
                   Foreground="#FF8FC5ED"
                   FontSize="8.5"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False" />
      </Grid>

      <UniformGrid x:Name="StateStrip" Grid.Row="4" Columns="3">
        <Border x:Name="RestingCard" Margin="0,0,3,0" Padding="4" CornerRadius="8" Background="#1018273B" BorderBrush="#334C6078" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="☕" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Text="休息" Foreground="#FFDDEBFA" FontSize="8" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border x:Name="WorkingCard" Margin="2,0" Padding="4" CornerRadius="8" Background="#1018273B" BorderBrush="#334C6078" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="⌨" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Text="工作" Foreground="#FFDDEBFA" FontSize="8" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border x:Name="OfflineCard" Margin="3,0,0,0" Padding="4" CornerRadius="8" Background="#1018273B" BorderBrush="#334C6078" BorderThickness="1">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Zz" FontSize="10" Foreground="#FF9AB7D0" HorizontalAlignment="Center" />
            <TextBlock Text="离线" Foreground="#FFDDEBFA" FontSize="8" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </UniformGrid>
    </Grid>
  </Border>
</UserControl>
