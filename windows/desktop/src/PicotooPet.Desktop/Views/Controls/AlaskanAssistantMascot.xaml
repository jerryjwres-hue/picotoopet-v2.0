<UserControl x:Class="PicotooPet.Desktop.Views.Controls.AlaskanAssistantMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PicotooPet.Desktop.Views.Controls"
             IsHitTestVisible="False">
  <Grid x:Name="MascotRoot" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TranslateTransform />
    </Grid.RenderTransform>

    <!--
      alaskan-working.png / alaskan-resting.png / alaskan-sleeping.png
      使用已确认参考稿裁切并随程序集封装的真实感阿拉斯加视觉；不再使用上一版卡通矢量犬。
    -->
    <Border CornerRadius="18" ClipToBounds="True" Background="#0AFFFFFF">
      <Image x:Name="AssistantImage"
             Stretch="Uniform"
             SnapsToDevicePixels="True"
             RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Style>
          <Style TargetType="Image">
            <Setter Property="Source" Value="{x:Static controls:AssistantArtworkData.Sleeping}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding AssistantStateKey, Mode=OneWay}" Value="Working">
                <Setter Property="Source" Value="{x:Static controls:AssistantArtworkData.Working}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding AssistantStateKey, Mode=OneWay}" Value="Resting">
                <Setter Property="Source" Value="{x:Static controls:AssistantArtworkData.Resting}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding AssistantStateKey, Mode=OneWay}" Value="OfflineSleeping">
                <Setter Property="Source" Value="{x:Static controls:AssistantArtworkData.Sleeping}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Image.Style>
      </Image>
    </Border>
  </Grid>

  <!-- 轻微呼吸动效保留互动感，但不改变业务状态。 -->
  <UserControl.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard>
        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
          <DoubleAnimation Storyboard.TargetName="MascotRoot"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="0"
                           To="-2"
                           Duration="0:0:2.8" />
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </UserControl.Triggers>
</UserControl>
