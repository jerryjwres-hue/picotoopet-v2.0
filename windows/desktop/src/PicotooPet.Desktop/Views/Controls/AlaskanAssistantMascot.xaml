<UserControl x:Class="PicotooPet.Desktop.Views.Controls.AlaskanAssistantMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
  <UserControl.Resources>
    <Style x:Key="WorkingAccessoryStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding AssistantStateKey, Mode=OneWay}" Value="Working">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RestingAccessoryStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding AssistantStateKey, Mode=OneWay}" Value="Resting">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="SleepingAccessoryStyle" TargetType="Grid">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding AssistantStateKey, Mode=OneWay}" Value="OfflineSleeping">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="MascotRoot" RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <TranslateTransform />
    </Grid.RenderTransform>

    <Viewbox Stretch="Uniform">
      <Canvas Width="240" Height="230">
        <!-- 背景光晕：只增强亲和感，不表达业务状态。 -->
        <Ellipse Canvas.Left="30" Canvas.Top="15" Width="180" Height="180" Fill="#183B82F6" />
        <Ellipse Canvas.Left="45" Canvas.Top="30" Width="150" Height="150" Fill="#12FFFFFF" />

        <!-- 阿拉斯加耳朵：深色外耳 + 暖色内耳。 -->
        <Path Data="M58,74 L75,18 L106,67 Z" Fill="#FF263142" Stroke="#FF172033" StrokeThickness="3" />
        <Path Data="M134,67 L167,18 L184,76 Z" Fill="#FF263142" Stroke="#FF172033" StrokeThickness="3" />
        <Path Data="M70,61 L77,34 L95,62 Z" Fill="#FFDFA879" />
        <Path Data="M145,61 L164,34 L173,63 Z" Fill="#FFDFA879" />

        <!-- 阿拉斯加蓬松头部。 -->
        <Ellipse Canvas.Left="54" Canvas.Top="45" Width="132" Height="128" Fill="#FFE8C89F" Stroke="#FF293447" StrokeThickness="3" />
        <Path Data="M66,78 C73,50 96,43 118,58 C96,72 91,93 92,116 C77,108 68,95 66,78 Z" Fill="#FF2A3341" />
        <Path Data="M174,78 C167,50 144,43 122,58 C144,72 149,93 148,116 C163,108 172,95 174,78 Z" Fill="#FF2A3341" />
        <Path Data="M119,56 C106,72 104,91 110,110 L130,110 C136,91 134,72 121,56 Z" Fill="#FFF7F3EA" />

        <!-- 眼睛、眉点与鼻口。 -->
        <Ellipse Canvas.Left="88" Canvas.Top="88" Width="15" Height="17" Fill="#FF171A20" />
        <Ellipse Canvas.Left="137" Canvas.Top="88" Width="15" Height="17" Fill="#FF171A20" />
        <Ellipse Canvas.Left="92" Canvas.Top="91" Width="4" Height="4" Fill="White" />
        <Ellipse Canvas.Left="141" Canvas.Top="91" Width="4" Height="4" Fill="White" />
        <Ellipse Canvas.Left="80" Canvas.Top="75" Width="27" Height="8" Fill="#FFF4E3C5" />
        <Ellipse Canvas.Left="133" Canvas.Top="75" Width="27" Height="8" Fill="#FFF4E3C5" />
        <Ellipse Canvas.Left="91" Canvas.Top="111" Width="58" Height="43" Fill="#FFF7EFE2" />
        <Path Data="M109,119 C115,113 126,113 132,119 C130,129 125,133 120,133 C115,133 110,129 109,119 Z" Fill="#FF1C2028" />
        <Path Data="M119,133 C118,145 108,145 103,139 M121,133 C122,145 132,145 137,139" Stroke="#FF5B4032" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <Path Data="M109,144 C117,153 126,153 134,144 C132,159 112,159 109,144 Z" Fill="#FFE97778" />

        <!-- 胸前白毛让阿拉斯加轮廓更明显。 -->
        <Path Data="M81,158 C94,143 108,151 120,165 C132,151 147,143 160,158 L176,211 L64,211 Z" Fill="#FFF6EFE5" Stroke="#FF293447" StrokeThickness="3" />
        <Ellipse Canvas.Left="74" Canvas.Top="178" Width="35" Height="28" Fill="#FFE7C49A" Stroke="#FF293447" StrokeThickness="2" />
        <Ellipse Canvas.Left="131" Canvas.Top="178" Width="35" Height="28" Fill="#FFE7C49A" Stroke="#FF293447" StrokeThickness="2" />

        <!-- 在线工作：耳机、麦克风和小电脑。 -->
        <Grid Style="{StaticResource WorkingAccessoryStyle}">
          <Path Data="M61,95 C58,49 182,49 179,95" Stroke="#FF2D7FF9" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          <Border Canvas.Left="51" Canvas.Top="87" Width="18" Height="36" CornerRadius="8" Background="#FF1677FF" />
          <Border Canvas.Left="171" Canvas.Top="87" Width="18" Height="36" CornerRadius="8" Background="#FF1677FF" />
          <Path Data="M180,117 C194,123 194,137 181,141" Stroke="#FF1677FF" StrokeThickness="4" StrokeStartLineCap="Round" />
          <Ellipse Canvas.Left="176" Canvas.Top="137" Width="10" Height="10" Fill="#FF29D391" />
          <Border Canvas.Left="57" Canvas.Top="174" Width="126" Height="47" CornerRadius="8" Background="#FF45546A" BorderBrush="#FF273448" BorderThickness="2">
            <Grid>
              <TextBlock Text="🐾" FontSize="20" Foreground="#FFDCE9FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Ellipse Canvas.Left="194" Canvas.Top="43" Width="11" Height="11" Fill="#FF7DE7C4" />
          <Ellipse Canvas.Left="207" Canvas.Top="61" Width="6" Height="6" Fill="#FFFFD76A" />
        </Grid>

        <!-- 在线空闲：泡澡 + 小黄鸭，明确表示“休息”而非掉线。 -->
        <Grid Style="{StaticResource RestingAccessoryStyle}">
          <Border Canvas.Left="48" Canvas.Top="174" Width="144" Height="46" CornerRadius="12,12,28,28" Background="#FFD8F3FF" BorderBrush="#FF75C8ED" BorderThickness="3" />
          <Ellipse Canvas.Left="62" Canvas.Top="161" Width="34" Height="23" Fill="White" Opacity="0.92" />
          <Ellipse Canvas.Left="88" Canvas.Top="155" Width="28" Height="26" Fill="White" Opacity="0.9" />
          <Ellipse Canvas.Left="112" Canvas.Top="162" Width="42" Height="22" Fill="White" Opacity="0.92" />
          <Ellipse Canvas.Left="164" Canvas.Top="150" Width="22" Height="20" Fill="#FFFFD34E" />
          <Ellipse Canvas.Left="170" Canvas.Top="144" Width="14" Height="14" Fill="#FFFFD34E" />
          <Path Data="M184,150 L196,154 L184,158 Z" Fill="#FFFF8C42" />
          <Ellipse Canvas.Left="179" Canvas.Top="148" Width="3" Height="3" Fill="#FF1F2937" />
        </Grid>

        <!-- 掉线：枕头和 Zzz，仅用于清晰表达连接已不可用。 -->
        <Grid Style="{StaticResource SleepingAccessoryStyle}">
          <Border Canvas.Left="62" Canvas.Top="180" Width="118" Height="35" CornerRadius="18" Background="#FFE6EAF0" BorderBrush="#FFC7D0DC" BorderThickness="2" />
          <TextBlock Canvas.Left="171" Canvas.Top="48" Text="Z" FontSize="28" FontWeight="Bold" Foreground="#FF8B9AAF" />
          <TextBlock Canvas.Left="195" Canvas.Top="30" Text="z" FontSize="20" FontWeight="Bold" Foreground="#FFA8B4C3" />
          <TextBlock Canvas.Left="211" Canvas.Top="17" Text="z" FontSize="14" FontWeight="Bold" Foreground="#FFC0C8D3" />
          <Path Data="M87,96 C92,101 98,101 103,96" Stroke="#FF333B48" StrokeThickness="3" StrokeStartLineCap="Round" />
          <Path Data="M137,96 C142,101 148,101 153,96" Stroke="#FF333B48" StrokeThickness="3" StrokeStartLineCap="Round" />
        </Grid>
      </Canvas>
    </Viewbox>
  </Grid>

  <UserControl.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard>
        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
          <DoubleAnimation Storyboard.TargetName="MascotRoot"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="0"
                           To="-4"
                           Duration="0:0:2.4" />
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </UserControl.Triggers>
</UserControl>
