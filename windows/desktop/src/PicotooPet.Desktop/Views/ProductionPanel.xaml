<UserControl x:Class="PicotooPet.Desktop.Views.ProductionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Panel_Loaded">
  <Border BorderThickness="1" BorderBrush="#33000000" Padding="14">
    <StackPanel>
      <TextBlock Text="本地生产 · ComfyUI Production" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,5,0,0"
                 Text="只消费 Core 已验证的 creative_ready/PASS Creative Package；Windows 仅执行源码 allowlist 的 Wan2.2 TI2V 5B workflow。"
                 TextWrapping="Wrap" />
      <TextBlock Margin="0,3,0,0" FontWeight="SemiBold"
                 Text="{Binding BoundaryText, Mode=OneWay}" />
      <TextBlock Margin="0,3,0,0"
                 Text="{Binding RendererText, Mode=OneWay}"
                 TextWrapping="Wrap" />
      <TextBlock Margin="0,3,0,8"
                 Text="{Binding PreflightStatus, Mode=OneWay}"
                 TextWrapping="Wrap" />

      <TextBlock FontWeight="SemiBold" Text="1. 选择 creative_ready Creative Package" />
      <DataGrid Margin="0,5,0,8" Height="135"
                ItemsSource="{Binding EligibleCreativePackages, Mode=OneWay}"
                SelectedItem="{Binding SelectedCreativePackage, Mode=TwoWay}"
                AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="项目" Binding="{Binding ProjectKey, Mode=OneWay}" Width="1.3*" />
          <DataGridTextColumn Header="Creative Package" Binding="{Binding CreativePackageId, Mode=OneWay}" Width="2.0*" />
          <DataGridTextColumn Header="Digest" Binding="{Binding PackageDigest, Mode=OneWay}" Width="2.0*" />
          <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, Mode=OneWay}" Width="175" />
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
        <Button Content="创建 Production Job" Click="Create_Click"
                IsEnabled="{Binding CanCreate, Mode=OneWay}" />
        <Button Content="刷新生产状态" Click="Refresh_Click" />
        <Button Content="本机 Preflight" Click="Preflight_Click"
                IsEnabled="{Binding CanPreflight, Mode=OneWay}" />
        <Button Content="启动本地渲染" Click="Start_Click"
                IsEnabled="{Binding CanStart, Mode=OneWay}" />
        <Button Content="取消所选生产任务" Click="Cancel_Click"
                IsEnabled="{Binding CanCancel, Mode=OneWay}" />
      </StackPanel>

      <TextBlock FontWeight="SemiBold" Text="2. Production Job / Production Package" />
      <DataGrid Margin="0,5,0,0" Height="150"
                ItemsSource="{Binding Jobs, Mode=OneWay}"
                SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="项目" Binding="{Binding ProjectKey, Mode=OneWay}" Width="1.2*" />
          <DataGridTextColumn Header="状态" Binding="{Binding Status, Mode=OneWay}" Width="120" />
          <DataGridTextColumn Header="Production Job" Binding="{Binding ProductionJobId, Mode=OneWay}" Width="2.0*" />
          <DataGridTextColumn Header="Plan Digest" Binding="{Binding PlanDigest, Mode=OneWay}" Width="2.0*" />
          <DataGridTextColumn Header="Failure" Binding="{Binding FailureCode, Mode=OneWay}" Width="1.1*" />
          <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, Mode=OneWay}" Width="175" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Margin="0,7,0,0"
                 Text="{Binding StatusMessage, Mode=OneWay}"
                 TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"
                 Text="不接受 Workflow JSON / Node Class / Model / Endpoint / URL / Command / 自定义路径输入；不自动下载模型，不切换云渲染，不自动发布。"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
