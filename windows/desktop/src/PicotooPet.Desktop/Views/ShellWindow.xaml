<Window x:Class="PicotooPet.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PicotooPet.Desktop.Views"
        xmlns:controls="clr-namespace:PicotooPet.Desktop.Views.Controls"
        xmlns:pages="clr-namespace:PicotooPet.Desktop.Views.Pages"
        xmlns:viewModels="clr-namespace:PicotooPet.Desktop.ViewModels"
        xmlns:navigation="clr-namespace:PicotooPet.Desktop.Navigation"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#FFF4F8FD"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        mc:Ignorable="d">
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static pages:SettingsPage.SaveAndConnectCommand}"
                    Executed="SaveAndConnect_Click" />
  </Window.CommandBindings>

  <Window.Resources>
    <SolidColorBrush x:Key="BrandBlue" Color="#FF2478E6" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FF1D2B3E" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF64758B" />
    <SolidColorBrush x:Key="SidebarText" Color="#FFF2F7FD" />
    <SolidColorBrush x:Key="SidebarMuted" Color="#FF96B8D6" />

    <Style x:Key="SimpleNavigationItemStyle" TargetType="ListBoxItem">
      <Setter Property="IsEnabled" Value="{Binding IsAvailable, Mode=OneWay}" />
      <Setter Property="ToolTip" Value="{Binding AvailabilityMessage, Mode=OneWay}" />
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="NavBorder"
                    Padding="13,10"
                    CornerRadius="11"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="NavDot"
                         Width="6"
                         Height="6"
                         VerticalAlignment="Center"
                         Fill="#FF7898B5" />
                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#283D8FEF" />
                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#335CA8E7" />
                <Setter TargetName="NavDot" Property="Fill" Value="#FFB8DCFA" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#553E8CE8" />
                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#666BB8F0" />
                <Setter TargetName="NavDot" Property="Fill" Value="#FF78C4FF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="NavBorder" Property="BorderBrush" Value="#FF65B8F3" />
                <Setter TargetName="NavBorder" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="NavBorder" Property="Opacity" Value="0.42" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="SimpleNavigationTemplate">
      <TextBlock Text="{Binding Title, Mode=OneWay}"
                 FontSize="15"
                 FontWeight="SemiBold"
                 Foreground="{StaticResource SidebarText}" />
    </DataTemplate>

    <Style x:Key="AdvancedRouteButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#FF2C4058" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#FFDCE6F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="ShellStatusBadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="#FFF8FBFF" />
      <Setter Property="BorderBrush" Value="#FFDDE7F2" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                     Value="{x:Static viewModels:AssistantPetIndicator.Green}">
          <Setter Property="Background" Value="#FFEAF8F1" />
          <Setter Property="BorderBrush" Value="#FFC9EBD9" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                     Value="{x:Static viewModels:AssistantPetIndicator.Orange}">
          <Setter Property="Background" Value="#FFFFF3E6" />
          <Setter Property="BorderBrush" Value="#FFFFD7AD" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ShellStatusDotStyle" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="#FF94A3B8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                     Value="{x:Static viewModels:AssistantPetIndicator.Green}">
          <Setter Property="Fill" Value="#FF19A968" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                     Value="{x:Static viewModels:AssistantPetIndicator.Orange}">
          <Setter Property="Fill" Value="#FFF59E0B" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="88" />
      <RowDefinition Height="*" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>

    <!-- One NavigationItems source, rendered inside the approved dark Picotoo brand rail. -->
    <Border Grid.RowSpan="3" Grid.Column="0" Padding="14,16">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF04172D" Offset="0" />
          <GradientStop Color="#FF073C68" Offset="0.52" />
          <GradientStop Color="#FF06192F" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="4,2,4,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="42" Height="42" CornerRadius="21">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF43B5FF" Offset="0" />
                <GradientStop Color="#FF2478E6" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="🐾"
                       FontSize="19"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Picotoo Pet AI"
                       Foreground="White"
                       FontSize="17"
                       FontWeight="Bold" />
            <TextBlock Text="{Binding ControlCenterSubtitle, Mode=OneWay}"
                       Margin="0,2,0,0"
                       Foreground="{StaticResource SidebarMuted}"
                       FontSize="10.5"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>

        <Border x:Name="HeaderModePill"
                Grid.Row="1"
                Margin="4,0,4,12"
                Padding="10,6"
                HorizontalAlignment="Left"
                CornerRadius="10"
                Background="#1F70B6E8"
                BorderBrush="#335CA8E7"
                BorderThickness="1">
          <TextBlock Text="SIMPLE MODE · 简单模式"
                     FontSize="11.5"
                     FontWeight="SemiBold"
                     Foreground="#FFD8ECFC" />
        </Border>

        <ListBox x:Name="SimpleNavigationList"
                 Grid.Row="2"
                 ItemsSource="{Binding NavigationItems, Mode=OneWay}"
                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ItemTemplate="{StaticResource SimpleNavigationTemplate}"
                 ItemContainerStyle="{StaticResource SimpleNavigationItemStyle}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <!-- Maotai remains a dedicated integration surface. This pass does not replace its animation internals. -->
        <ScrollViewer Grid.Row="3"
                      Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
          <controls:AssistantPetPanel x:Name="AssistantPet"
                                      Presentation="{Binding PetPresentation, Mode=OneWay}" />
        </ScrollViewer>

        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="#221F6CA5"
                BorderBrush="#334B93C7"
                BorderThickness="1"
                CornerRadius="13">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="17" Background="#FFEAF4FF">
              <TextBlock Text="🐾"
                         FontSize="17"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Picotoo Pet AI"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold" />
              <TextBlock Text="本地优先 · 安全控制"
                         Margin="0,2,0,0"
                         Foreground="#FF8FB7D8"
                         FontSize="9.5" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="1" Grid.Row="0" Background="White" BorderBrush="#FFE2EAF4" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding CurrentPage.Title, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
            <Border Margin="10,2,0,0" Padding="8,3" CornerRadius="8" Background="#FFF1F6FC">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="HeaderStatusDot"
                         Tag="{Binding PetPresentation.Indicator, Mode=OneWay}"
                         Style="{StaticResource ShellStatusDotStyle}"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding PetPresentation.Title, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#FF3976BE" />
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Margin="0,5,0,0" FontSize="13" Foreground="{StaticResource TextMuted}" MaxWidth="500" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Border Tag="{Binding PetPresentation.Indicator, Mode=OneWay}" Style="{StaticResource ShellStatusBadgeStyle}" CornerRadius="11" Padding="10,7" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Tag="{Binding PetPresentation.Indicator, Mode=OneWay}" Style="{StaticResource ShellStatusDotStyle}" Margin="0,0,7,0" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock Text="系统" FontSize="12" Foreground="#FF6C7F93" />
                <TextBlock Text="{Binding PetPresentation.Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#FF2D5D50" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Tag="{Binding PetPresentation.Indicator, Mode=OneWay}" Style="{StaticResource ShellStatusBadgeStyle}" CornerRadius="11" Padding="10,7" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Tag="{Binding PetPresentation.Indicator, Mode=OneWay}" Style="{StaticResource ShellStatusDotStyle}" Margin="0,0,7,0" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock Text="Mac Core" FontSize="12" Foreground="#FF6C7F93" />
                <TextBlock Text="{Binding ConnectionText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#FF2C3F55" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ShellStatusBadgeStyle}" CornerRadius="11" Padding="10,7" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="#FF19A968" Margin="0,0,7,0" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock Text="Windows" FontSize="12" Foreground="#FF6C7F93" />
                <TextBlock Text="正常" FontSize="13" FontWeight="SemiBold" Foreground="#FF16825A" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Background="#FFEEF5FF" BorderBrush="#FFD7E7FB" BorderThickness="1" CornerRadius="11" Padding="10,8">
            <TextBlock Text="{Binding ApprovalText, Mode=OneWay}" Foreground="#FF236CCB" FontSize="13" FontWeight="SemiBold" />
          </Border>
        </WrapPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1" Grid.Row="1" Background="#FFF4F8FD">
      <views:NavigationContentHost x:Name="ContentHost"
                                   Content="{Binding CurrentPage, Mode=OneWay}"
                                   NavigationFaulted="ContentHost_NavigationFaulted" />
    </Border>

    <Border x:Name="AdvancedHomePanel" Grid.Column="1" Grid.Row="1" Background="#FFF4F8FD" Padding="28">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding CurrentRoute, Mode=OneWay}" Value="{x:Static navigation:NavigationRoute.AdvancedHome}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
          <TextBlock Text="高级功能" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
          <TextBlock Text="日常任务无需进入这里。工程、治理、诊断与设置完整保留，并且每个入口都有明确动作。" Margin="0,7,0,22" FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
          <TextBlock Text="业务与执行" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
          <WrapPanel Margin="0,0,0,20">
            <Button Content="项目" Tag="Projects" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="任务中心" Tag="TaskCenter" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="结果" Tag="Results" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="业务自动化" Tag="BusinessAutomation" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="自动化" Tag="Automation" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
          </WrapPanel>
          <TextBlock Text="人工治理" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
          <WrapPanel Margin="0,0,0,20">
            <Button Content="审批" Tag="Approvals" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="质量 / Shadow / Promotion" Tag="BusinessAutomation" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="250" />
          </WrapPanel>
          <TextBlock Text="系统与运维" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
          <WrapPanel Margin="0,0,0,20">
            <Button Content="健康" Tag="Health" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="诊断" Tag="Diagnostics" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
          </WrapPanel>
          <TextBlock Text="开发与配置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
          <WrapPanel>
            <Button Content="云端开发" Tag="CloudDevelopment" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="设置" Tag="Settings" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Column="1" Grid.Row="2" Background="#FFFBFDFF" BorderBrush="#FFE2EAF4" BorderThickness="0,1,0,0" Padding="18,9">
      <StackPanel Orientation="Horizontal">
        <Ellipse Tag="{Binding PetPresentation.Indicator, Mode=OneWay}"
                 Style="{StaticResource ShellStatusDotStyle}"
                 VerticalAlignment="Center"
                 Margin="0,0,8,0" />
        <TextBlock Text="{Binding ConnectionMessage, Mode=OneWay}"
                   Foreground="#FF64758B"
                   FontSize="13"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
