<Window x:Class="PicotooPet.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:PicotooPet.Desktop.Views.Pages"
        xmlns:views="clr-namespace:PicotooPet.Desktop.Views"
        xmlns:controls="clr-namespace:PicotooPet.Desktop.Views.Controls"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1448"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PicoPageBackgroundBrush}">
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static pages:SettingsPage.SaveAndConnectCommand}"
                    Executed="SaveAndConnect_Click" />
  </Window.CommandBindings>

  <Window.Resources>
    <Style x:Key="SimpleNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#FFD9E6F5" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="MinHeight" Value="46" />
    </Style>
    <Style x:Key="SimpleNavSelectedButtonStyle" TargetType="Button" BasedOn="{StaticResource SimpleNavButtonStyle}">
      <Setter Property="Background" Value="#FF1678FF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#FF5EA4FF" />
    </Style>
    <Style x:Key="AdvancedRouteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="15,13" />
      <Setter Property="Margin" Value="5" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource PicoBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="MinHeight" Value="54" />
    </Style>

    <!-- 工作=绿、休息=琥珀、掉线=灰；所有状态灯复用同一真实状态键。 -->
    <Style x:Key="AssistantStateDotStyle" TargetType="Ellipse">
      <Setter Property="Fill" Value="#FF7F8EA4" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding AssistantStateKey, Mode=OneWay}" Value="Working">
          <Setter Property="Fill" Value="#FF37D99A" />
        </DataTrigger>
        <DataTrigger Binding="{Binding AssistantStateKey, Mode=OneWay}" Value="Resting">
          <Setter Property="Fill" Value="#FFF2A43C" />
        </DataTrigger>
        <DataTrigger Binding="{Binding AssistantStateKey, Mode=OneWay}" Value="OfflineSleeping">
          <Setter Property="Fill" Value="#FF7F8EA4" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource PicoPageBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="82" />
      <RowDefinition Height="*" />
      <RowDefinition Height="32" />
    </Grid.RowDefinitions>

    <!-- 参考图左侧栏：品牌、固定入口、助手状态和用户卡。 -->
    <Border x:Name="ReferenceSidebar"
            Grid.Column="0"
            Grid.RowSpan="3"
            Background="{StaticResource PicoSidebarBrush}"
            Padding="15,18,15,14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="5,1,4,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="46" Height="46" CornerRadius="23" Background="#FF1678FF" VerticalAlignment="Top">
            <TextBlock Text="🐾" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="4,0,0,0">
            <TextBlock Text="Picotoo Pet AI" Foreground="White" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="{Binding ControlCenterSubtitle, Mode=OneWay}" Margin="0,3,0,0" Foreground="#FFA9B9D0" FontSize="10" />
            <TextBlock Text="简单模式 · 简单高效" Margin="0,3,0,0" Foreground="#FF72B4FF" FontSize="10" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
          <Button x:Name="SimpleHomeButton" Style="{StaticResource SimpleNavSelectedButtonStyle}" Click="SimpleHome_Click">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="首页" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="SimpleReviewButton" Style="{StaticResource SimpleNavButtonStyle}" Click="SimpleReview_Click">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="待我审核" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="SimpleActiveButton" Style="{StaticResource SimpleNavButtonStyle}" Click="SimpleActive_Click">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="进行中" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="SimpleCompletedButton" Style="{StaticResource SimpleNavButtonStyle}" Click="SimpleCompleted_Click">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="已完成" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <Button x:Name="SimpleAdvancedButton" Style="{StaticResource SimpleNavButtonStyle}" Click="SimpleAdvanced_Click">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="高级" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
            </Grid>
          </Button>
          <!-- 设置是参考图中的次级工具入口，不改变五项 Simple Mode 导航合同。 -->
          <Button Style="{StaticResource SimpleNavButtonStyle}" Tag="Settings" Click="AdvancedRoute_Click" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FFB8C9DE" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="设置" Foreground="#FFB8C9DE" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>

        <Border x:Name="AssistantStatusPanel"
                Grid.Row="3"
                Background="#FF0D315F"
                BorderBrush="#FF214C7C"
                BorderThickness="1"
                CornerRadius="17"
                Padding="11"
                Margin="1,10,1,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="AI 助手状态" Foreground="#FFDCE9F8" FontSize="12" FontWeight="SemiBold" />
              <Ellipse x:Name="AssistantStatusDot"
                       Grid.Column="1"
                       Width="8"
                       Height="8"
                       Style="{StaticResource AssistantStateDotStyle}"
                       VerticalAlignment="Center" />
            </Grid>

            <controls:AlaskanAssistantMascot Height="118" Margin="0,2,0,4" />

            <Border Background="#FF123E72" BorderBrush="#FF2566A8" BorderThickness="1" CornerRadius="11" Padding="9,7">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="8" Height="8" Style="{StaticResource AssistantStateDotStyle}" Margin="0,0,7,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding AssistantTitle, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Text="{Binding AssistantSubtitle, Mode=OneWay}" Foreground="#FFB7CAE1" FontSize="10" Margin="15,3,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- 参考图三态预览：只做视觉说明，不允许点击伪造状态。 -->
            <Grid Margin="0,9,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" CornerRadius="9" Background="#142EC98D" Margin="0,0,3,0" Padding="3">
                <StackPanel>
                  <Image Source="{x:Static controls:AssistantArtworkData.Working}" Height="43" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock Text="工作" Foreground="#FFD9E8F8" FontSize="9" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" CornerRadius="9" Background="#22F2A43C" Margin="2,0" Padding="3">
                <StackPanel>
                  <Image Source="{x:Static controls:AssistantArtworkData.Resting}" Height="43" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock Text="休息" Foreground="#FFD9E8F8" FontSize="9" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" CornerRadius="9" Background="#187F8EA4" Margin="3,0,0,0" Padding="3">
                <StackPanel>
                  <Image Source="{x:Static controls:AssistantArtworkData.Sleeping}" Height="43" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                  <TextBlock Text="睡觉" Foreground="#FFD9E8F8" FontSize="9" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <Border x:Name="ReferenceProfileCard"
                Grid.Row="4"
                Background="#FF0D315F"
                BorderBrush="#FF214C7C"
                BorderThickness="1"
                CornerRadius="14"
                Padding="11,9"
                Margin="1,10,1,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="17" Background="#FFF3F7FC">
              <TextBlock Text="●" FontSize="19" Foreground="#FF173A65" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="王小安" Foreground="White" FontSize="12" FontWeight="SemiBold" />
              <TextBlock Text="标准版" Foreground="#FFA9B9D0" FontSize="9" Margin="0,2,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="⌄" Foreground="#FFD9E6F5" FontSize="16" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- 参考图顶部：页面标题 + 运行状态/能力胶囊。 -->
    <Border x:Name="ReferenceHeader"
            Grid.Column="1"
            Grid.Row="0"
            Background="#FCFFFFFF"
            BorderBrush="{StaticResource PicoBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="22,11">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentPage.Title, Mode=OneWay}" FontSize="25" FontWeight="Bold" />
          <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                     Margin="0,3,0,0"
                     Foreground="{StaticResource PicoTextMutedBrush}"
                     FontSize="11"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{StaticResource PicoSuccessSoftBrush}" BorderBrush="#FFC6ECDD" BorderThickness="1" CornerRadius="12" Padding="11,7" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="✓" Foreground="{StaticResource PicoSuccessBrush}" FontWeight="Bold" Margin="0,0,6,0" />
              <TextBlock Text="系统链路已连接" Foreground="{StaticResource PicoSuccessBrush}" FontSize="11" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Background="#FFF8FBFF" BorderBrush="{StaticResource PicoBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,7" Margin="0,0,8,0">
            <TextBlock Text="{Binding ConnectionText, StringFormat=Mac Core · {0}, Mode=OneWay}" Foreground="#FF33465F" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Border Background="{StaticResource PicoPrimarySoftBrush}" BorderBrush="#FFCCE0FF" BorderThickness="1" CornerRadius="12" Padding="10,7">
            <TextBlock Text="{Binding ApprovalText, Mode=OneWay}" Foreground="{StaticResource PicoPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <views:NavigationContentHost x:Name="ContentHost"
                                 Grid.Column="1"
                                 Grid.Row="1"
                                 Background="{StaticResource PicoPageBackgroundBrush}"
                                 Content="{Binding CurrentPage, Mode=OneWay}"
                                 NavigationFaulted="ContentHost_NavigationFaulted" />

    <!-- 高级入口同样产品化；进入具体高级页后继续继承全局主题。 -->
    <Border x:Name="AdvancedHomePanel"
            Grid.Column="1"
            Grid.Row="1"
            Background="{StaticResource PicoPageBackgroundBrush}"
            Visibility="Collapsed"
            Padding="24">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">
          <Border Style="{StaticResource PicoCardStyle}" Padding="20" Margin="0,0,0,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource PicoPrimarySoftBrush}">
                <TextBlock Text="⚙" FontSize="22" Foreground="{StaticResource PicoPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" Margin="4,0,18,0">
                <TextBlock Text="高级功能" Style="{StaticResource PicoPageTitleStyle}" FontSize="26" />
                <TextBlock Text="工程、治理、诊断与配置能力完整保留；日常使用仍建议留在简单模式。" Margin="0,5,0,0" Style="{StaticResource PicoMutedTextStyle}" />
              </StackPanel>
              <Border Grid.Column="2" Background="#FFFFF6E8" BorderBrush="#FFF3D9A7" BorderThickness="1" CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
                <TextBlock Text="高级操作" Foreground="#FFA76B12" Style="{StaticResource PicoPillTextStyle}" />
              </Border>
            </Grid>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,7,0">
              <Border Style="{StaticResource PicoCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="业务与执行" Style="{StaticResource PicoSectionTitleStyle}" />
                  <TextBlock Text="项目、任务、结果和自动化执行入口。" Margin="0,4,0,9" Style="{StaticResource PicoMutedTextStyle}" FontSize="11" />
                  <WrapPanel>
                    <Button Content="📁  项目" Tag="Projects" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                    <Button Content="☷  任务中心" Tag="TaskCenter" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                    <Button Content="✓  结果" Tag="Results" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                    <Button Content="▥  业务自动化" Tag="BusinessAutomation" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                    <Button Content="↻  自动化" Tag="Automation" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource PicoCardStyle}">
                <StackPanel>
                  <TextBlock Text="人工治理" Style="{StaticResource PicoSectionTitleStyle}" />
                  <TextBlock Text="审批与质量治理继续保持显式人工决定。" Margin="0,4,0,9" Style="{StaticResource PicoMutedTextStyle}" FontSize="11" />
                  <WrapPanel>
                    <Button Content="🛡  审批" Tag="Approvals" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                    <Button Content="◇  质量 / Shadow / Promotion" Tag="BusinessAutomation" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="260" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="7,0,0,0">
              <Border Style="{StaticResource PicoCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="系统与运维" Style="{StaticResource PicoSectionTitleStyle}" />
                  <TextBlock Text="健康与诊断保持只读事实优先和故障隔离。" Margin="0,4,0,9" Style="{StaticResource PicoMutedTextStyle}" FontSize="11" />
                  <WrapPanel>
                    <Button Content="♥  健康" Tag="Health" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                    <Button Content="⌕  诊断" Tag="Diagnostics" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource PicoCardStyle}">
                <StackPanel>
                  <TextBlock Text="开发与配置" Style="{StaticResource PicoSectionTitleStyle}" />
                  <TextBlock Text="Handoff 和本地设置仍受原安全边界约束。" Margin="0,4,0,9" Style="{StaticResource PicoMutedTextStyle}" FontSize="11" />
                  <WrapPanel>
                    <Button Content="☁  云端开发" Tag="CloudDevelopment" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                    <Button Content="⚙  设置" Tag="Settings" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="190" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Column="1"
            Grid.Row="2"
            Background="#FFF1F5FA"
            BorderBrush="{StaticResource PicoBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="15,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="7" Height="7" Fill="{StaticResource PicoSuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding ConnectionMessage, Mode=OneWay}"
                   Foreground="{StaticResource PicoTextMutedBrush}"
                   FontSize="10"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
