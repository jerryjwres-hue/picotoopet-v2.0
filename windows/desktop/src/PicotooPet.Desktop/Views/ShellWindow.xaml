<Window x:Class="PicotooPet.Desktop.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PicotooPet.Desktop.Views.Controls"
        xmlns:pages="clr-namespace:PicotooPet.Desktop.Views.Pages"
        xmlns:views="clr-namespace:PicotooPet.Desktop.Views"
        Title="{Binding WindowTitle, Mode=OneWay}"
        Width="1440"
        Height="900"
        MinWidth="1120"
        MinHeight="700"
        Background="#FFF7FAFF"
        WindowStartupLocation="CenterScreen">
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static pages:SettingsPage.SaveAndConnectCommand}"
                    Executed="SaveAndConnect_Click" />
  </Window.CommandBindings>

  <Window.Resources>
    <SolidColorBrush x:Key="BrandBlue" Color="#FF1E78F0" />
    <SolidColorBrush x:Key="TextPrimary" Color="#FF142033" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF6B7C93" />

    <Style x:Key="SimpleNavButtonStyle" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="#FFEAF3FF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavBorder"
                    CornerRadius="10"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#233E8CE8" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="NavBorder" Property="Background" Value="#553E8CE8" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AdvancedRouteButtonStyle" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="BorderBrush" Value="#FFDCE6F2" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Resources>

  <Grid Background="#FFF7FAFF">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Column="0"
            Grid.RowSpan="3"
            Padding="14,16">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF061C35" Offset="0" />
          <GradientStop Color="#FF06345B" Offset="0.56" />
          <GradientStop Color="#FF071A31" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom"
                Margin="0,14,0,0"
                Padding="12,10"
                Background="#221F6CA5"
                BorderBrush="#334B93C7"
                BorderThickness="1"
                CornerRadius="12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="36"
                    Height="36"
                    CornerRadius="18"
                    Background="#FFEAF4FF">
              <TextBlock Text="🐾"
                         FontSize="18"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Picotoo Pet AI"
                         Foreground="White"
                         FontSize="12"
                         FontWeight="SemiBold" />
              <TextBlock Text="本地优先 · 安全控制"
                         Margin="0,2,0,0"
                         Foreground="#FF8FB7D8"
                         FontSize="9.5" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Top">
          <Grid Margin="4,2,4,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="40"
                    Height="40"
                    CornerRadius="20">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#FF36A2FF" Offset="0" />
                  <GradientStop Color="#FF1262EA" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="🐾"
                         FontSize="21"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="7,1,0,0">
              <TextBlock Text="Picotoo Pet AI"
                         Foreground="White"
                         FontSize="17"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding ControlCenterSubtitle, Mode=OneWay}"
                         Margin="0,2,0,0"
                         Foreground="#FF9FC3E4"
                         FontSize="9.5" />
              <TextBlock Text="Simple Mode · 简单模式"
                         Margin="0,1,0,0"
                         Foreground="#FF65AEFF"
                         FontSize="9" />
            </StackPanel>
          </Grid>

          <!-- Simple Mode contract: keep exact user-visible entry text while styling via the shared template. -->
          <Button x:Name="SimpleHomeButton"
                  Content="首页"
                  Background="#FF1D78F0"
                  Style="{StaticResource SimpleNavButtonStyle}"
                  Click="SimpleHome_Click" />
          <Button x:Name="SimpleReviewButton"
                  Content="待我审核"
                  Style="{StaticResource SimpleNavButtonStyle}"
                  Click="SimpleReview_Click" />
          <Button x:Name="SimpleActiveButton"
                  Content="进行中"
                  Style="{StaticResource SimpleNavButtonStyle}"
                  Click="SimpleActive_Click" />
          <Button x:Name="SimpleCompletedButton"
                  Content="已完成"
                  Style="{StaticResource SimpleNavButtonStyle}"
                  Click="SimpleCompleted_Click" />
          <Button x:Name="SimpleAdvancedButton"
                  Content="高级"
                  Style="{StaticResource SimpleNavButtonStyle}"
                  Click="SimpleAdvanced_Click" />

          <Separator Margin="6,10" Opacity="0.18" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">
          <controls:AssistantPetPanel x:Name="AssistantPet"
                                      Margin="0,0,0,2" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border Grid.Column="1"
            Grid.Row="0"
            Background="#FFFDFEFF"
            BorderBrush="#FFE2EAF4"
            BorderThickness="0,0,0,1"
            Padding="22,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding CurrentPage.Title, Mode=OneWay}"
                     FontSize="23"
                     FontWeight="Bold"
                     Foreground="{StaticResource TextPrimary}" />
          <TextBlock Text="{Binding StatusMessage, Mode=OneWay}"
                     Margin="0,2,0,0"
                     Foreground="{StaticResource TextMuted}"
                     FontSize="11"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Border Background="#FFE8F8EF"
                  BorderBrush="#FFC8EED8"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="12,7"
                  Margin="0,0,9,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="#FF18A86B" Margin="0,0,7,0" />
              <TextBlock Text="{Binding ConnectionText, Mode=OneWay}"
                         Foreground="#FF178354"
                         FontSize="11"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <Border Background="#FFEEF5FF"
                  BorderBrush="#FFD7E7FB"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="12,7">
            <TextBlock Text="{Binding ApprovalText, Mode=OneWay}"
                       Foreground="#FF236CCB"
                       FontSize="11"
                       FontWeight="SemiBold" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Grid.Row="1"
            Background="#FFF7FAFF">
      <views:NavigationContentHost x:Name="ContentHost"
                                   Content="{Binding CurrentPage, Mode=OneWay}"
                                   NavigationFaulted="ContentHost_NavigationFaulted" />
    </Border>

    <Border x:Name="AdvancedHomePanel"
            Grid.Column="1"
            Grid.Row="1"
            Background="#FFF7FAFF"
            Visibility="Collapsed"
            Padding="28">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
          <TextBlock Text="高级功能"
                     FontSize="28"
                     FontWeight="Bold"
                     Foreground="{StaticResource TextPrimary}" />
          <TextBlock Text="日常使用不需要进入这里。工程、治理、诊断与设置仍完整保留。"
                     Margin="0,7,0,22"
                     Foreground="{StaticResource TextMuted}" />

          <TextBlock Text="业务与执行" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
          <WrapPanel Margin="0,0,0,20">
            <Button Content="项目" Tag="Projects" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="任务中心" Tag="TaskCenter" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="结果" Tag="Results" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="业务自动化" Tag="BusinessAutomation" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="自动化" Tag="Automation" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
          </WrapPanel>

          <TextBlock Text="人工治理" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
          <WrapPanel Margin="0,0,0,20">
            <Button Content="审批" Tag="Approvals" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="质量 / Shadow / Promotion" Tag="BusinessAutomation" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="250" />
          </WrapPanel>

          <TextBlock Text="系统与运维" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
          <WrapPanel Margin="0,0,0,20">
            <Button Content="健康" Tag="Health" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="诊断" Tag="Diagnostics" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
          </WrapPanel>

          <TextBlock Text="开发与配置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
          <WrapPanel>
            <Button Content="云端开发" Tag="CloudDevelopment" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
            <Button Content="设置" Tag="Settings" Click="AdvancedRoute_Click" Style="{StaticResource AdvancedRouteButtonStyle}" Width="180" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Column="1"
            Grid.Row="2"
            Background="#FFFBFDFF"
            BorderBrush="#FFE2EAF4"
            BorderThickness="0,1,0,0"
            Padding="14,7">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="7" Height="7" Fill="#FF19A968" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock Text="{Binding ConnectionMessage, Mode=OneWay}"
                   Foreground="#FF64758B"
                   FontSize="10.5"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
