<Window x:Class="PicotooPet.Desktop.Views.FloatingPetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PicotooPet.Desktop.Views.Controls"
        Width="214"
        Height="220"
        MinWidth="214"
        MinHeight="220"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        Loaded="FloatingPetWindow_Loaded"
        LocationChanged="FloatingPetWindow_LocationChanged">
  <Grid Background="Transparent">
    <!-- Pet surface   : same articulated renderer and same read-only Shell presentation. -->
    <controls:AssistantPetPanel x:Name="FloatingPet"
                                Margin="10,30,10,8"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Presentation="{Binding PetPresentation, Mode=OneWay}"
                                IsFloatingMode="True" />

    <!-- Window chrome : explicit handle keeps character clicks available for pet interaction. -->
    <Border x:Name="WindowTools"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,4,5,0"
            Padding="4,3"
            Background="#D02A3442"
            BorderBrush="#704A5C72"
            BorderThickness="1"
            CornerRadius="11">
      <Border.Effect>
        <DropShadowEffect BlurRadius="10"
                          ShadowDepth="1"
                          Opacity="0.18"
                          Color="#FF07111C" />
      </Border.Effect>
      <StackPanel Orientation="Horizontal">
        <Border Padding="5,1"
                Background="Transparent"
                Cursor="SizeAll"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
          <TextBlock Text="⋮⋮"
                     Foreground="#FFE8F3FF"
                     FontSize="11"
                     FontWeight="Bold"
                     ToolTip="拖动桌宠；松开后可吸附屏幕边缘" />
        </Border>
        <Button x:Name="SizeButton"
                Content="100%"
                Margin="2,0,0,0"
                Padding="5,1"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#FF9FD0FF"
                FontSize="9"
                Cursor="Hand"
                ToolTip="切换桌宠尺寸"
                Click="SizeButton_Click" />
        <Button x:Name="PinButton"
                Content="置顶"
                Margin="2,0,0,0"
                Padding="5,1"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#FFB9D9FA"
                FontSize="9"
                Cursor="Hand"
                ToolTip="切换置顶"
                Click="PinButton_Click" />
        <Button Content="收回"
                Margin="2,0,0,0"
                Padding="5,1"
                Background="Transparent"
                BorderThickness="0"
                Foreground="#FFE8F3FF"
                FontSize="9"
                Cursor="Hand"
                ToolTip="关闭悬浮桌宠，侧栏桌宠仍保留"
                Click="ReturnButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
