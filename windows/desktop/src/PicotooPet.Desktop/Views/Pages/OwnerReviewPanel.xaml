<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OwnerReviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PicotooPet.Desktop.ViewModels"
             AutomationProperties.AutomationId="OwnerReviewPanel">
    <UserControl.Resources>
        <DataTemplate x:Key="FieldRowTemplate" DataType="{x:Type vm:OwnerReviewFieldRowViewModel}">
            <Border BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding StatusText}" Margin="12,0,0,0" Foreground="#FF8A5A00"/>
                    </DockPanel>
                    <TextBlock Text="{Binding FieldPath}" Foreground="#FF777777" FontSize="11"/>
                    <TextBlock Text="Core 建议值（未经主人确认前不可信）：" Margin="0,6,0,0" Foreground="#FF555555"/>
                    <TextBlock Text="{Binding ValueText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#FF555555"/>
                    <TextBlock Text="{Binding TrustText}" TextWrapping="Wrap" Foreground="#FF555555"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton Content="确认" GroupName="{Binding FieldPath}" IsChecked="{Binding IsConfirm, Mode=TwoWay}"
                                     IsEnabled="{Binding CanConfirm}" Margin="0,0,16,0"/>
                        <RadioButton Content="更正" GroupName="{Binding FieldPath}" IsChecked="{Binding IsCorrect, Mode=TwoWay}" Margin="0,0,16,0"/>
                        <RadioButton Content="未知" GroupName="{Binding FieldPath}" IsChecked="{Binding IsUnknown, Mode=TwoWay}"/>
                    </StackPanel>
                    <TextBox Text="{Binding CorrectedText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"
                             ToolTip="选择“更正”时填写更正值；列表类字段用分号或换行分隔。"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="主人结构化审核（Owner Structured Review）" FontSize="20" FontWeight="SemiBold"/>
            <Border Background="#FFFFF4D6" Padding="8" Margin="0,8,0,8">
                <TextBlock Text="{Binding TransportBanner}" TextWrapping="Wrap" AutomationProperties.AutomationId="OwnerReviewTransportBanner"/>
            </Border>
            <TextBlock Text="{Binding CredentialStatus}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <PasswordBox x:Name="CredentialBox" Width="260" AutomationProperties.AutomationId="OwnerReviewCredentialBox"/>
                <Button x:Name="SaveCredentialButton" Content="保存主人凭据" Margin="8,0,0,0" Click="SaveCredentialButton_Click"/>
                <Button x:Name="ClearCredentialButton" Content="清除凭据" Margin="8,0,0,0" Click="ClearCredentialButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Goal ID：" VerticalAlignment="Center"/>
                <TextBox Text="{Binding GoalId, UpdateSourceTrigger=PropertyChanged}" Width="320" AutomationProperties.AutomationId="OwnerReviewGoalId"/>
                <Button Content="1. 加载提案" Command="{Binding LoadProposalCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="OwnerReviewLoad"/>
                <Button Content="离开审核" Command="{Binding CancelCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="OwnerReviewCancel"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.AutomationId="OwnerReviewStatus"/>
            <TextBlock Text="{Binding ErrorText}" Foreground="#FFB00020" TextWrapping="Wrap" AutomationProperties.AutomationId="OwnerReviewError"/>
            <TextBlock Text="{Binding ProposalHeader}" Margin="0,8,0,0" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding EvidenceNotice}" TextWrapping="Wrap" Foreground="#FF8A5A00"/>

            <TextBlock Text="一、身份与场景事实（来自照片/主人声明，不是创作意图）" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <ItemsControl ItemsSource="{Binding IdentityFields}" ItemTemplate="{StaticResource FieldRowTemplate}"
                          AutomationProperties.AutomationId="OwnerReviewIdentityFields"/>

            <TextBlock Text="二、创作意图（主人想要的动作，不是已验证事实）" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <ItemsControl ItemsSource="{Binding IntentFields}" ItemTemplate="{StaticResource FieldRowTemplate}"
                          AutomationProperties.AutomationId="OwnerReviewIntentFields"/>

            <Button Content="2. 生成预览（不写入）" Command="{Binding PreviewCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="OwnerReviewPreview"/>
            <TextBox Text="{Binding PreviewSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0"
                     AutomationProperties.AutomationId="OwnerReviewPreviewSummary"/>

            <CheckBox Content="我已逐项核对 Core 预览，并同意提交这份主人审核" IsChecked="{Binding OwnerConfirmed, Mode=TwoWay}" Margin="0,12,0,0"
                      AutomationProperties.AutomationId="OwnerReviewConfirm"/>
            <Button Content="3. 提交主人审核" Command="{Binding CommitCommand}" Margin="0,8,0,0" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="OwnerReviewCommit"/>
            <TextBox Text="{Binding CommitSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,8,0,0"
                     AutomationProperties.AutomationId="OwnerReviewCommitSummary"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
