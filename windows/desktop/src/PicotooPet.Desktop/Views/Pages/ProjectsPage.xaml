<UserControl x:Class="PicotooPet.Desktop.Views.Pages.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="项目" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0" Text="项目元数据由 Mac Core + SQLite 管理；不会自动扫描工作目录。" TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="标题" />
        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="类型" />
        <TextBox Text="{Binding NewProjectType, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="来源" />
        <TextBox Text="{Binding NewSourceApp, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
      <Button Grid.Column="3"
              Margin="12,20,0,0"
              Content="创建项目"
              Click="Create_Click"
              IsEnabled="{Binding CanCreate, Mode=OneWay}"
              ToolTip="{Binding CreateActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True" />
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
      <Button Content="刷新"
              Click="Refresh_Click"
              IsEnabled="{Binding CanRefresh, Mode=OneWay}"
              ToolTip="{Binding RefreshActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True" />
      <Button Content="归档所选"
              Click="Archive_Click"
              IsEnabled="{Binding CanArchive, Mode=OneWay}"
              ToolTip="{Binding ArchiveActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True" />
    </StackPanel>

    <DataGrid Grid.Row="3"
              ItemsSource="{Binding Projects}"
              SelectedItem="{Binding SelectedProject}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="标题" Binding="{Binding Title, Mode=OneWay}" Width="2*" />
        <DataGridTextColumn Header="类型" Binding="{Binding ProjectType, Mode=OneWay}" Width="*" />
        <DataGridTextColumn Header="来源" Binding="{Binding SourceApp, Mode=OneWay}" Width="*" />
        <DataGridTextColumn Header="状态" Binding="{Binding Status, Mode=OneWay}" Width="100" />
        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, Mode=OneWay}" Width="180" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="4" Margin="0,10,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
