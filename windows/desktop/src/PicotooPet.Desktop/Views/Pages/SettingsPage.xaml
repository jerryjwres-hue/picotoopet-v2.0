<UserControl x:Class="PicotooPet.Desktop.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PicotooPet.Desktop.Views.Pages">
  <Grid Background="White" Margin="32">
    <Border MaxWidth="760"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{StaticResource PanelBrush}"
            CornerRadius="16"
            Padding="28">
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="Mac Core 地址" Margin="0,24,0,6" FontWeight="SemiBold" />
        <TextBox Text="{Binding MacBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                 MinWidth="520"
                 ToolTip="例如 http://192.168.1.161:8766" />
        <TextBlock Text="设备令牌" Margin="0,18,0,6" FontWeight="SemiBold" />
        <PasswordBox x:Name="TokenPasswordBox"
                     MinWidth="520"
                     Padding="8,6"
                     ToolTip="令牌只会保存到 Windows Credential Manager" />
        <TextBlock Text="设备令牌不会写入 settings.json、日志或 ViewModel。"
                   Margin="4,8,0,0"
                   Foreground="#FF6B7280" />
        <Button Content="保存并连接"
                HorizontalAlignment="Left"
                Margin="0,22,0,0"
                Command="{x:Static local:SettingsPage.SaveAndConnectCommand}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
