<Window x:Class="PicotooPet.Desktop.Views.Pages.NewTaskWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建任务"
        Width="720"
        Height="600"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="新建任务" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Text="只显示当前真实能力；尚未接入的能力不能执行。" Margin="0,6,0,16" Foreground="#FF6B7280" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="TaskOptionList"
               ItemsSource="{Binding Options, Mode=OneWay}"
               SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Padding="10" Margin="2" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description, Mode=OneWay}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="#FF4B5563" />
                <TextBlock Text="{Binding AvailabilityText, Mode=OneWay}" Margin="0,4,0,0" FontSize="12" Foreground="#FF1D4ED8" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Column="1" Margin="20,0,0,0">
        <TextBlock Text="你的目标" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="用于帮助你记住这次任务要做什么；不会成为任意 Provider / Model / Workflow 指令。"
                   Margin="0,5,0,8" Foreground="#FF6B7280" TextWrapping="Wrap" />
        <TextBox Text="{Binding Objective, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Height="130"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
        <Border Margin="0,16,0,0" Padding="12" Background="#FFF8FAFC" CornerRadius="8">
          <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="2"
               Text="Research 2.3.27.1 已接入只读网络搜索；发帖、回复、点赞、关注等写操作仍不可用。"
               Margin="0,14,0,8"
               Foreground="#FF6B7280" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="返回" IsEnabled="{Binding CanGoBack, Mode=OneWay}" Click="Back_Click" />
      <Button Content="下一步" IsEnabled="{Binding CanGoNext, Mode=OneWay}" Click="Next_Click" />
      <Button Content="{Binding SubmitText, Mode=OneWay}" IsEnabled="{Binding CanSubmit, Mode=OneWay}" Click="Submit_Click" />
      <Button Content="取消" Click="Cancel_Click" />
    </StackPanel>
  </Grid>
</Window>
