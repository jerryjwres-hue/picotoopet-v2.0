<Window x:Class="PicotooPet.Desktop.Views.Pages.NewTaskWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建任务"
        Width="760"
        Height="640"
        MinWidth="660"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource PicoPageBackgroundBrush}">
  <Border x:Name="WizardSurface" Margin="22" Style="{StaticResource PicoCardStyle}" Padding="22">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource PicoPrimarySoftBrush}">
          <TextBlock Text="＋" FontSize="24" Foreground="{StaticResource PicoPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="4,0,18,0">
          <TextBlock Text="新建任务" Style="{StaticResource PicoPageTitleStyle}" FontSize="26" />
          <TextBlock Text="只显示当前真实能力；尚未接入的能力不能执行。" Margin="0,4,0,0" Style="{StaticResource PicoMutedTextStyle}" />
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource PicoSuccessSoftBrush}" CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
          <TextBlock Text="受控向导" Foreground="{StaticResource PicoSuccessBrush}" Style="{StaticResource PicoPillTextStyle}" />
        </Border>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource PicoSurfaceSoftBrush}" BorderBrush="{StaticResource PicoBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="8">
          <ListBox x:Name="TaskOptionList"
                   Background="Transparent"
                   BorderThickness="0"
                   ItemsSource="{Binding Options, Mode=OneWay}"
                   SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="12" Margin="2,3" BorderBrush="{StaticResource PicoBorderBrush}" BorderThickness="1" CornerRadius="11" Background="White">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource PicoPrimarySoftBrush}" VerticalAlignment="Top">
                      <TextBlock Text="🐾" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="3,0,0,0">
                      <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Description, Mode=OneWay}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource PicoTextMutedBrush}" FontSize="12" />
                      <Border Margin="0,6,0,0" Padding="8,3" Background="{StaticResource PicoPrimarySoftBrush}" CornerRadius="8" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding AvailabilityText, Mode=OneWay}" Foreground="{StaticResource PicoPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <StackPanel Grid.Column="1" Margin="20,0,0,0">
          <TextBlock Text="你的目标" Style="{StaticResource PicoSectionTitleStyle}" />
          <TextBlock Text="这里是业务目标说明，不会被当成任意 Provider / Model / Workflow 指令。"
                     Margin="0,5,0,10"
                     Style="{StaticResource PicoMutedTextStyle}" />
          <TextBox Text="{Binding Objective, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Height="148"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" />
          <Border Margin="4,14,4,0" Padding="13" Background="{StaticResource PicoPrimarySoftBrush}" BorderBrush="#FFCFE1FF" BorderThickness="1" CornerRadius="10">
            <StackPanel>
              <TextBlock Text="当前状态" FontWeight="SemiBold" Foreground="{StaticResource PicoPrimaryBrush}" />
              <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource PicoTextMutedBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <Border Grid.Row="2" Margin="0,16,0,10" Padding="12,9" Background="#FFFFF8E9" BorderBrush="#FFF4DCB0" BorderThickness="1" CornerRadius="10">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="ⓘ" Foreground="{StaticResource PicoWarningBrush}" Margin="0,0,8,0" />
          <TextBlock Text="网络 Search / 爬虫尚未在 26.1 接入；不会显示成可执行任务。"
                     Foreground="#FF8A611E"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="所有高风险动作仍需既有精确审批。" VerticalAlignment="Center" Style="{StaticResource PicoMutedTextStyle}" FontSize="11" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="返回" IsEnabled="{Binding CanGoBack, Mode=OneWay}" Click="Back_Click" />
          <Button Content="下一步" IsEnabled="{Binding CanGoNext, Mode=OneWay}" Style="{StaticResource PicoSecondaryButtonStyle}" Click="Next_Click" />
          <Button Content="{Binding SubmitText, Mode=OneWay}" IsEnabled="{Binding CanSubmit, Mode=OneWay}" Style="{StaticResource PicoPrimaryButtonStyle}" Click="Submit_Click" />
          <Button Content="取消" Click="Cancel_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
