<UserControl x:Class="PicotooPet.Desktop.Views.Pages.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="诊断" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0" Text="只显示结构化故障元数据、重试上下文和 Trace ID；不查询日志正文、Token 或用户文件。" TextWrapping="Wrap" />
    </StackPanel>

    <Button Grid.Row="1"
            HorizontalAlignment="Left"
            Margin="0,14,0,10"
            Content="刷新诊断事实"
            Click="Refresh_Click"
            IsEnabled="{Binding CanRefresh, Mode=OneWay}"
            ToolTip="{Binding RefreshActionReason, Mode=OneWay}"
            ToolTipService.ShowOnDisabled="True" />

    <DataGrid Grid.Row="2"
              ItemsSource="{Binding Facts}"
              SelectedItem="{Binding SelectedFact}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="工作流" Binding="{Binding WorkflowId, Mode=OneWay}" Width="*" />
        <DataGridTextColumn Header="步骤" Binding="{Binding StepKey, Mode=OneWay}" Width="*" />
        <DataGridTextColumn Header="状态" Binding="{Binding Status, Mode=OneWay}" Width="120" />
        <DataGridTextColumn Header="错误码" Binding="{Binding ErrorCode, Mode=OneWay}" Width="*" />
        <DataGridTextColumn Header="安全错误信息" Binding="{Binding ErrorMessage, Mode=OneWay}" Width="2*" />
        <DataGridTextColumn Header="Trace ID" Binding="{Binding TraceId, Mode=OneWay}" Width="*" />
        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, Mode=OneWay}" Width="180" />
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
