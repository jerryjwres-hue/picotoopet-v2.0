<UserControl x:Class="PicotooPet.Desktop.Views.Pages.HealthPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="健康" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0" Text="显示数据库、任务、工作流和 Worker 类型能力的结构化健康事实。" TextWrapping="Wrap" />
    </StackPanel>

    <Button Grid.Row="1"
            HorizontalAlignment="Left"
            Margin="0,14,0,10"
            Content="刷新健康快照"
            Click="Refresh_Click"
            IsEnabled="{Binding CanRefresh, Mode=OneWay}"
            ToolTip="{Binding RefreshActionReason, Mode=OneWay}"
            ToolTipService.ShowOnDisabled="True" />

    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Header="工作流" Margin="0,0,8,0">
        <TextBlock Margin="12" Text="{Binding WorkflowSummary}" TextWrapping="Wrap" />
      </GroupBox>
      <GroupBox Grid.Column="1" Header="任务队列" Margin="8,0">
        <TextBlock Margin="12" Text="{Binding TaskSummary}" TextWrapping="Wrap" />
      </GroupBox>
      <GroupBox Grid.Column="2" Header="数据库" Margin="8,0,0,0">
        <TextBlock Margin="12" Text="{Binding DatabaseSchemaText}" />
      </GroupBox>
    </Grid>

    <GroupBox Grid.Row="3" Header="Worker / Capability">
      <DataGrid ItemsSource="{Binding Capabilities}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Worker" Binding="{Binding WorkerId, Mode=OneWay}" Width="*" />
          <DataGridTextColumn Header="Capability" Binding="{Binding Capability, Mode=OneWay}" Width="2*" />
          <DataGridCheckBoxColumn Header="健康" Binding="{Binding Healthy, Mode=OneWay}" Width="70" />
          <DataGridTextColumn Header="心跳" Binding="{Binding HeartbeatAt, Mode=OneWay}" Width="180" />
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>

    <TextBlock Grid.Row="4" Margin="0,10,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
