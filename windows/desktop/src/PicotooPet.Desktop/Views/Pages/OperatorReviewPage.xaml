<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border Padding="14" Margin="0,0,0,12" Background="#FFFFFBEB" BorderBrush="#FFFDE68A" BorderThickness="1" CornerRadius="10">
      <TextBlock Text="{Binding Explanation, Mode=OneWay}" Foreground="#FF92400E" TextWrapping="Wrap" />
    </Border>
    <ContentControl Grid.Row="1" Content="{Binding ApprovalCenter, Mode=OneWay}" />
  </Grid>
</UserControl>
