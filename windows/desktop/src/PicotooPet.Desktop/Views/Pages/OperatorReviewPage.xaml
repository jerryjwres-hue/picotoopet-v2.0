<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <DropShadowEffect x:Key="ReviewCardShadow"
                      BlurRadius="14"
                      ShadowDepth="2"
                      Opacity="0.08"
                      Color="#FF63768E" />
  </UserControl.Resources>

  <Grid Margin="22,18,22,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Attention card : orange is reserved for explicit user attention. -->
    <Border Padding="16,13"
            Margin="0,0,0,13"
            Background="#FFFFF9F1"
            BorderBrush="#FFFFD7AD"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource ReviewCardShadow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="36"
                Height="36"
                CornerRadius="18"
                Background="#FFFFE7C7"
                VerticalAlignment="Top">
          <TextBlock Text="!"
                     Foreground="#FFE36B12"
                     FontSize="18"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="4,0,15,0">
          <TextBlock Text="需要你的确认"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="#FF7C3E12" />
          <TextBlock Text="{Binding Explanation, Mode=OneWay}"
                     Margin="0,4,0,0"
                     Foreground="#FF9A5A24"
                     FontSize="10.5"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="2"
                Padding="8,4"
                VerticalAlignment="Top"
                Background="#FFFFEDDA"
                BorderBrush="#FFFFD3A3"
                BorderThickness="1"
                CornerRadius="9">
          <TextBlock Text="人工审核"
                     Foreground="#FFB86624"
                     FontSize="8.5"
                     FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <!-- Approval center : existing approval implementation remains authoritative and unchanged. -->
    <Border Grid.Row="1"
            Padding="2"
            Background="White"
            BorderBrush="#FFDCE6F2"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True"
            Effect="{StaticResource ReviewCardShadow}">
      <ContentControl Content="{Binding ApprovalCenter, Mode=OneWay}" />
    </Border>
  </Grid>
</UserControl>
