<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="ReviewSurface" Background="{StaticResource PicoPageBackgroundBrush}" Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Style="{StaticResource PicoCardStyle}" Margin="0,0,0,14" Padding="20" Background="#FFFFFBF4" BorderBrush="#FFFFD9A8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="56" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="23" Background="#FFFFE9C5" VerticalAlignment="Top">
          <TextBlock Text="◷" FontSize="23" Foreground="{StaticResource PicoWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="4,0,20,0">
          <TextBlock Text="待我审核" Style="{StaticResource PicoPageTitleStyle}" FontSize="25" />
          <TextBlock Text="需要决定的事项集中在这里；批准和拒绝仍严格绑定原请求摘要。"
                     Margin="0,5,0,0"
                     Style="{StaticResource PicoMutedTextStyle}" />
        </StackPanel>
        <Border Grid.Column="2" Background="#FFFFEFD6" CornerRadius="10" Padding="11,7" VerticalAlignment="Center">
          <TextBlock Text="人工决定" Foreground="#FFB96810" Style="{StaticResource PicoPillTextStyle}" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource PicoCardStyle}" Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#FFFFF8E9" BorderBrush="#FFF8DBA8" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="🛡" Margin="0,0,8,0" />
            <TextBlock Text="{Binding Explanation, Mode=OneWay}" Foreground="#FF8B5A15" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource PicoBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4">
          <ContentControl Content="{Binding ApprovalCenter, Mode=OneWay}" />
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
