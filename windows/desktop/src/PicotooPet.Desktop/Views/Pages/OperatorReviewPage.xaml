<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorReviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="22,18,22,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Attention card : orange is reserved for explicit user attention. -->
    <Border Padding="16,13"
            Margin="0,0,0,13"
            Background="#FFFFF8EF"
            BorderBrush="#FFFFD7AD"
            BorderThickness="1"
            CornerRadius="13">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="34"
                Height="34"
                CornerRadius="17"
                Background="#FFFFE7C7"
                VerticalAlignment="Top">
          <TextBlock Text="!"
                     Foreground="#FFE36B12"
                     FontSize="18"
                     FontWeight="Bold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="3,0,0,0">
          <TextBlock Text="需要你的确认"
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="#FF7C3E12" />
          <TextBlock Text="{Binding Explanation, Mode=OneWay}"
                     Margin="0,4,0,0"
                     Foreground="#FF9A5A24"
                     FontSize="10.5"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Approval center : existing approval implementation remains authoritative and unchanged. -->
    <Border Grid.Row="1"
            Padding="2"
            Background="White"
            BorderBrush="#FFDCE6F2"
            BorderThickness="1"
            CornerRadius="13"
            ClipToBounds="True">
      <ContentControl Content="{Binding ApprovalCenter, Mode=OneWay}" />
    </Border>
  </Grid>
</UserControl>
