<UserControl x:Class="PicotooPet.Desktop.Views.Pages.CodingEscalationDecisionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Border Margin="0,14,0,0"
            Padding="18"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="抠门 Coding 仲裁" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="#475569"
                               Text="Mac Core 先用本地质量分、置信带和历史 95% 区间判断是否值得调用 Codex / Claude Code。Windows 只读查看结果，不能强制选择 Provider、模型或预算。"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        Margin="16,0,0,0"
                        Padding="9,5"
                        VerticalAlignment="Top"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="999">
                    <TextBlock Foreground="#065F46"
                               FontWeight="SemiBold"
                               Text="READ ONLY" />
                </Border>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox MinHeight="38"
                         Padding="10,7"
                         VerticalContentAlignment="Center"
                         ToolTip="Coding Goal ID"
                         Text="{Binding GoalId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        MinWidth="96"
                        Content="查看决策"
                        Command="{Binding RefreshCommand, Mode=OneWay}" />
            </Grid>

            <Border Margin="0,12,0,0"
                    Padding="12"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="7">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1E3A8A"
                               Text="{Binding DecisionSummary, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="#334155"
                               Text="{Binding ReasonSummary, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="#475569"
                               Text="{Binding HistorySummary, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0"
                    Padding="10"
                    Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="6">
                <TextBlock Foreground="#7C2D12"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
