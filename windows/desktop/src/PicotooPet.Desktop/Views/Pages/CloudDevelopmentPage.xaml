<UserControl x:Class="PicotooPet.Desktop.Views.Pages.CloudDevelopmentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760"
             d:DesignWidth="1040"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <Border Padding="18"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Handoff / Return Contract"
                                   FontSize="21"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,0"
                                   Foreground="#475569"
                                   Text="{Binding CurrentDelivery, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="12"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Foreground="#64748B" Text="合同版本" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding ContractVersion, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2"
                                Padding="12"
                                Background="White"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Foreground="#64748B" Text="合同状态" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Text="{Binding ContractStatus, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Margin="0,14,0,0"
                    Padding="16"
                    Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="外部执行状态"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#9A3412"
                               Text="{Binding ProviderStatus, Mode=OneWay}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#7C2D12"
                               Text="此页面只展示合同，不会上传文件、创建沙盒、运行命令或启动外部会话。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="18"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="冻结信任链"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,12"
                                   Foreground="#64748B"
                                   Text="缺少任一阶段，都不得自动进入下一高风险阶段。"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding TrustChain, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7"
                                            Padding="10,8"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBlock Text="{Binding Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="18"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="安全与数据边界"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,12"
                                   Foreground="#64748B"
                                   Text="默认拒绝；Provider 不是事实源、权限门或发布系统。"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SecurityBoundaries, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <TextBlock Text="{Binding Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,14,0,0"
                    Padding="18"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="实施阶段"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    <ItemsControl Margin="0,12,0,0"
                                  ItemsSource="{Binding PhaseMilestones, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,9"
                                        Padding="12"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Phase, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="#475569"
                                                   Text="{Binding Status, Mode=OneWay}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Description, Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
