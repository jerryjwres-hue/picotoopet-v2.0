<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="White" Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding Title}"
               FontSize="28"
               FontWeight="SemiBold"
               Foreground="#FF111827" />

    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,20,0,20">
      <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="连接" Foreground="#FF6B7280" />
          <TextBlock Text="{Binding ConnectionText}" Margin="0,8,0,0" FontSize="21" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Mac Core" Foreground="#FF6B7280" />
          <TextBlock Text="{Binding HealthText}" Margin="0,8,0,0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Background="#FFF7ED" CornerRadius="12" Padding="18" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="任务执行器" Foreground="#FF9A3412" />
          <TextBlock Text="{Binding WorkerText}" Margin="0,8,0,0" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="{Binding WorkerReason}" Margin="0,5,0,0" Foreground="#FF7C2D12" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="18">
        <StackPanel>
          <TextBlock Text="任务" Foreground="#FF6B7280" />
          <TextBlock Text="{Binding TaskCount}" Margin="0,8,0,0" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="{Binding WaitingForWorkerCount, StringFormat=等待执行器 {0}}"
                     Margin="0,5,0,0"
                     Foreground="#FF6B7280" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Border Grid.Row="2" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="当前任务快照" Margin="18,14" FontWeight="SemiBold" />
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Tasks}"
                  BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="任务类型" Width="180" DisplayMemberBinding="{Binding TaskType}" />
              <GridViewColumn Header="状态" Width="130" DisplayMemberBinding="{Binding DisplayStatus}" />
              <GridViewColumn Header="更新时间" Width="190" DisplayMemberBinding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
              <GridViewColumn Header="任务 ID" Width="330" DisplayMemberBinding="{Binding TaskId}" />
              <GridViewColumn Header="错误" Width="220" DisplayMemberBinding="{Binding Error}" />
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>
    </Border>

    <Expander Grid.Row="3" Header="技术诊断" IsExpanded="False" Margin="0,16,0,0">
      <StackPanel Margin="12">
        <TextBlock Text="{Binding LatencyText}" />
        <TextBlock Text="{Binding StatusMessage}" Margin="0,8,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Expander>
  </Grid>
</UserControl>
