<UserControl x:Class="PicotooPet.Desktop.Views.Pages.ResultsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760"
             d:DesignWidth="1040"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Text="筛选" />
            <ComboBox Width="180"
                      ItemsSource="{Binding FilterOptions, Mode=OneWay}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedFilter, Mode=TwoWay}" />
            <TextBlock Margin="18,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#64748B"
                       Text="{Binding VisibleResults.Count, Mode=OneWay, StringFormat=当前 {0} 项}" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="500" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" MinWidth="310" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding VisibleResults, Mode=OneWay}"
                      SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="结果类型"
                                        Width="150"
                                        DisplayMemberBinding="{Binding DisplayType, Mode=OneWay}" />
                        <GridViewColumn Header="状态"
                                        Width="90"
                                        DisplayMemberBinding="{Binding DisplayStatus, Mode=OneWay}" />
                        <GridViewColumn Header="完成时间"
                                        Width="170"
                                        DisplayMemberBinding="{Binding UpdatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        <GridViewColumn Header="任务 ID"
                                        Width="240"
                                        DisplayMemberBinding="{Binding TaskId, Mode=OneWay}" />
                        <GridViewColumn Header="结果 ID"
                                        Width="240"
                                        DisplayMemberBinding="{Binding ResultId, Mode=OneWay}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="安全结果预览"
                               FontSize="20"
                               FontWeight="SemiBold" />

                    <ScrollViewer Grid.Row="1" Margin="0,16,0,16">
                        <StackPanel>
                            <StackPanel DataContext="{Binding SelectedResult, Mode=OneWay}">
                                <TextBlock FontWeight="SemiBold" Text="结果类型" />
                                <TextBlock Margin="0,3,0,12"
                                           Text="{Binding DisplayType, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Text="任务 ID" />
                                <TextBlock Margin="0,3,0,12"
                                           Text="{Binding TaskId, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Text="结果 ID" />
                                <TextBlock Margin="0,3,0,12"
                                           Text="{Binding ResultId, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Text="预览边界" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding PreviewUnavailableReason, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Margin="0,18,0,0"
                                    Padding="12"
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    DataContext="{Binding DataContext.DiagnosticPreview, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                    Visibility="{Binding DataContext.IsPreviewVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="系统诊断结果"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,12"
                                               Foreground="#475569"
                                               Text="{Binding StatusText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="生成时间" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding GeneratedAtText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Core" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding CoreText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Worker" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding WorkerText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Queue" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding QueueText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Checks" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding ChecksText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Warnings" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding WarningsText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2">
                        <Button Width="132"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"
                                Click="LoadPreview_Click"
                                IsEnabled="{Binding CanLoadSelectedPreview, Mode=OneWay}"
                                Content="加载安全预览" />
                        <TextBlock Foreground="#475569"
                                   Text="{Binding PreviewActionReason, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Foreground="#475569"
                   Text="{Binding StatusMessage, Mode=OneWay}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
