<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760"
             d:DesignWidth="1040"
             mc:Ignorable="d">
  <UserControl.Resources>
    <SolidColorBrush x:Key="HomeText" Color="#FF1D2B3E" />
    <SolidColorBrush x:Key="HomeMuted" Color="#FF64758B" />
    <SolidColorBrush x:Key="HomeBorder" Color="#FFDDE7F2" />

    <Style x:Key="TaskBucketButtonStyle" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="MinHeight" Value="112" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource HomeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="BucketBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BucketBorder" Property="Background" Value="#FFF7FAFF" /><Setter TargetName="BucketBorder" Property="BorderBrush" Value="#FFBFD8F6" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="BucketBorder" Property="Background" Value="#FFEAF3FF" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BucketBorder" Property="BorderBrush" Value="#FF2478E6" /><Setter TargetName="BucketBorder" Property="BorderThickness" Value="2" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RecentTaskButtonStyle" TargetType="Button">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#FFE5ECF4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RowBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="12,10">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#FFF3F8FF" /><Setter TargetName="RowBorder" Property="BorderBrush" Value="#FFBDD7F7" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="#FFE9F2FD" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowBorder" Property="BorderBrush" Value="#FF2478E6" /><Setter TargetName="RowBorder" Property="BorderThickness" Value="2" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HealthDotStyle" TargetType="Ellipse">
      <Setter Property="Width" Value="9" /><Setter Property="Height" Value="9" /><Setter Property="Fill" Value="#FF94A3B8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Green"><Setter Property="Fill" Value="#FF19A968" /></DataTrigger>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Orange"><Setter Property="Fill" Value="#FFF59E0B" /></DataTrigger>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Gray"><Setter Property="Fill" Value="#FF94A3B8" /></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="500" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" MinWidth="260" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <Border x:Name="HeroCard" Padding="20" CornerRadius="16" Background="#FFEEF6FF" BorderBrush="#FFD3E6FC" BorderThickness="1" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="今天想让 PicotooPet 做什么？" FontSize="24" FontWeight="Bold" Foreground="{StaticResource HomeText}" />
              <TextBlock Text="从这里创建受控任务；任务创建后会进入真实队列，并可在进行中 / 已完成 / 已删除里持续管理。" Margin="0,7,24,0" FontSize="14" Foreground="{StaticResource HomeMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="＋ 新建任务" Width="132" Height="44" VerticalAlignment="Center" Click="NewTask_Click" />
          </Grid>
        </Border>

        <Border x:Name="HomeGreetingStrip"
                Margin="0,0,0,16"
                Padding="13,10"
                Background="White"
                BorderBrush="{StaticResource HomeBorder}"
                BorderThickness="1"
                CornerRadius="12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Tag="{Binding SystemIndicator, Mode=OneWay}" Style="{StaticResource HealthDotStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock Text="{Binding SystemSummary, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource HomeText}" TextWrapping="Wrap" />
                <TextBlock Text="任务、审核与执行状态来自当前会话快照" Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource HomeMuted}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
              <Border Padding="9,5" Margin="0,0,6,0" CornerRadius="9" Background="#FFFFF6EA" BorderBrush="#FFFFE0B9" BorderThickness="1">
                <TextBlock FontSize="12" Foreground="#FF9A6C35"><Run Text="待审核 " /><Run Text="{Binding PendingReviewCount, Mode=OneWay}" FontWeight="Bold" Foreground="#FFE56D12" /></TextBlock>
              </Border>
              <Border Padding="9,5" Margin="0,0,6,0" CornerRadius="9" Background="#FFEDF5FF" BorderBrush="#FFD7E7FA" BorderThickness="1">
                <TextBlock FontSize="12" Foreground="#FF547AA7"><Run Text="进行中 " /><Run Text="{Binding InProgressCount, Mode=OneWay}" FontWeight="Bold" Foreground="#FF2875D6" /></TextBlock>
              </Border>
              <Border Padding="9,5" CornerRadius="9" Background="#FFECF8F1" BorderBrush="#FFD1EBDD" BorderThickness="1">
                <TextBlock FontSize="12" Foreground="#FF5C8A72"><Run Text="已完成 " /><Run Text="{Binding CompletedCount, Mode=OneWay}" FontWeight="Bold" Foreground="#FF18865B" /></TextBlock>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <Grid x:Name="TaskOverviewCard" Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource TaskBucketButtonStyle}" Click="Review_Click">
            <StackPanel><TextBlock Text="待我审核" FontSize="14" FontWeight="SemiBold" Foreground="#FF9A5D17" /><TextBlock Text="{Binding PendingReviewCount, Mode=OneWay}" Margin="0,8,0,2" FontSize="30" FontWeight="Bold" Foreground="#FFE56D12" /><TextBlock Text="需要你确认的任务" FontSize="12" Foreground="#FF8B735C" /></StackPanel>
          </Button>
          <Button Grid.Column="2" Style="{StaticResource TaskBucketButtonStyle}" Click="Active_Click">
            <StackPanel><TextBlock Text="进行中" FontSize="14" FontWeight="SemiBold" Foreground="#FF2869B8" /><TextBlock Text="{Binding InProgressCount, Mode=OneWay}" Margin="0,8,0,2" FontSize="30" FontWeight="Bold" Foreground="#FF2478E6" /><TextBlock Text="系统正在处理的任务" FontSize="12" Foreground="#FF657C98" /></StackPanel>
          </Button>
          <Button Grid.Column="4" Style="{StaticResource TaskBucketButtonStyle}" Click="Completed_Click">
            <StackPanel><TextBlock Text="已完成" FontSize="14" FontWeight="SemiBold" Foreground="#FF277B58" /><TextBlock Text="{Binding CompletedCount, Mode=OneWay}" Margin="0,8,0,2" FontSize="30" FontWeight="Bold" Foreground="#FF19A968" /><TextBlock Text="点击直接查看结果" FontSize="12" Foreground="#FF5F7E70" /></StackPanel>
          </Button>
        </Grid>

        <Border x:Name="RecentTasksCard" Padding="16" CornerRadius="14" Background="White" BorderBrush="{StaticResource HomeBorder}" BorderThickness="1">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="最近任务" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource HomeText}" /><TextBlock Text="点击任意任务直接打开详情和已有结果" Margin="0,3,0,0" FontSize="13" Foreground="{StaticResource HomeMuted}" /></StackPanel>
              <TextBlock Grid.Column="1" Text="真实任务事实" FontSize="12" Foreground="{StaticResource HomeMuted}" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding RecentTasks, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource RecentTaskButtonStyle}" Click="RecentTask_Click">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="0.7*" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#FF283548" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}" FontSize="13" Foreground="#FF2872D0" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding StageText, Mode=OneWay}" FontSize="13" Foreground="#FF64758B" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" Text="{Binding UpdatedAtText, Mode=OneWay}" FontSize="12" Foreground="#FF7C899A" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="4" Text="查看 ›" FontSize="13" FontWeight="SemiBold" Foreground="#FF2478E6" Margin="10,0,0,0" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Grid.Column="2">
        <Border x:Name="SystemStatusCard" Padding="16" CornerRadius="14" Background="White" BorderBrush="{StaticResource HomeBorder}" BorderThickness="1" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="系统状态" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource HomeText}" Margin="0,0,0,12" />
            <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Mac Core" FontSize="14" FontWeight="SemiBold" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Ellipse Tag="{Binding CoreIndicator, Mode=OneWay}" Style="{StaticResource HealthDotStyle}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="{Binding CoreStatus, Mode=OneWay}" FontSize="13" Foreground="{StaticResource HomeMuted}" /></StackPanel></Grid>
            <Separator Opacity="0.35" />
            <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Mac Worker" FontSize="14" FontWeight="SemiBold" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Ellipse Tag="{Binding WorkerIndicator, Mode=OneWay}" Style="{StaticResource HealthDotStyle}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="{Binding WorkerStatus, Mode=OneWay}" FontSize="13" Foreground="{StaticResource HomeMuted}" MaxWidth="130" TextTrimming="CharacterEllipsis" /></StackPanel></Grid>
            <Separator Opacity="0.35" />
            <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Windows" FontSize="14" FontWeight="SemiBold" /><StackPanel Grid.Column="1" Orientation="Horizontal"><Ellipse Tag="{Binding WindowsIndicator, Mode=OneWay}" Style="{StaticResource HealthDotStyle}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="{Binding WindowsStatus, Mode=OneWay}" FontSize="13" Foreground="{StaticResource HomeMuted}" /></StackPanel></Grid>
            <TextBlock Text="{Binding SystemSummary, Mode=OneWay}" Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource HomeMuted}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Padding="16" CornerRadius="14" Background="White" BorderBrush="{StaticResource HomeBorder}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Windows 资源" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource HomeText}" />
            <TextBlock Text="只读本地采样，不会改变任务。" Margin="0,3,0,14" FontSize="12" Foreground="{StaticResource HomeMuted}" />
            <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold" /><Grid Margin="0,5,0,12"><ProgressBar Height="8" Maximum="100" Value="{Binding CpuPercent, Mode=OneWay}" /><TextBlock Text="{Binding CpuText, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-7,0,0" FontSize="12" Foreground="{StaticResource HomeMuted}" /></Grid>
            <TextBlock Text="内存" FontSize="13" FontWeight="SemiBold" /><Grid Margin="0,5,0,12"><ProgressBar Height="8" Maximum="100" Value="{Binding MemoryPercent, Mode=OneWay}" /><TextBlock Text="{Binding MemoryText, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-7,0,0" FontSize="12" Foreground="{StaticResource HomeMuted}" /></Grid>
            <TextBlock Text="磁盘" FontSize="13" FontWeight="SemiBold" /><Grid Margin="0,5,0,0"><ProgressBar Height="8" Maximum="100" Value="{Binding DiskPercent, Mode=OneWay}" /><TextBlock Text="{Binding DiskText, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,-7,0,0" FontSize="12" Foreground="{StaticResource HomeMuted}" /></Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>