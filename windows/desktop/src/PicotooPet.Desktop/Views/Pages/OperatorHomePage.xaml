<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PicotooPet.Desktop.Views.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Background="{StaticResource PicoPageBackgroundBrush}">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Hero：只提供受控新任务入口；阿拉斯加是互动视觉，不代表新的执行权限。 -->
      <Border x:Name="HeroNewTaskCard"
              Grid.Row="0"
              CornerRadius="22"
              Padding="24,18"
              Margin="0,0,0,18">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF1478FF" Offset="0" />
            <GradientStop Color="#FF438DF8" Offset="0.58" />
            <GradientStop Color="#FF70A9FF" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid MinHeight="178">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
          </Grid.ColumnDefinitions>

          <StackPanel VerticalAlignment="Center" Margin="8,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="52" Height="52" CornerRadius="26" Background="#33FFFFFF" Margin="0,0,14,0">
                <TextBlock Text="+" FontSize="32" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="新建任务" FontSize="29" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="从真实能力开始，让 Picotoo 陪你把事情做完。" Margin="0,4,0,0" FontSize="14" Foreground="#EFFFFFFF" />
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="66,18,0,0">
              <Button x:Name="NewTaskButton"
                      Content="＋ 新建任务  →"
                      Background="White"
                      BorderBrush="White"
                      Foreground="#FF146DE0"
                      Padding="18,10"
                      Click="NewTask_Click" />
              <Border Margin="10,4,0,4" Padding="12,7" CornerRadius="10" Background="#22FFFFFF">
                <TextBlock Text="Search 尚未接入 · 不会假装可执行" Foreground="White" FontSize="12" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </StackPanel>

          <Grid Grid.Column="1" Margin="0,-12,-6,-18">
            <Ellipse Width="180" Height="180" Fill="#17FFFFFF" />
            <controls:AlaskanAssistantMascot Width="205" Height="198" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
          </Grid>
        </Grid>
      </Border>

      <!-- 任务摘要：只展示真实桶计数，不制造百分比。 -->
      <Grid Grid.Row="1" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource PicoCardStyle}" Margin="0,0,7,0" Background="#FFFFFBF4" BorderBrush="#FFFFD9A8">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17" Background="#FFFFEACB" Margin="0,0,9,0">
                  <TextBlock Text="◷" FontSize="18" Foreground="{StaticResource PicoWarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="待我审核" Style="{StaticResource PicoSectionTitleStyle}" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="1" Content="查看" Padding="10,5" MinHeight="30" FontSize="12" Click="Review_Click" />
            </Grid>
            <TextBlock Text="{Binding PendingReviewCount, Mode=OneWay}" FontSize="34" FontWeight="Bold" Margin="0,13,0,0" />
            <TextBlock Text="需要你明确决定的事项" Style="{StaticResource PicoMutedTextStyle}" Margin="0,1,0,8" />
            <ItemsControl ItemsSource="{Binding PendingReview, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#88FFFFFF" CornerRadius="9" Padding="9" Margin="0,3,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource PicoWarningBrush}" FontSize="11" Margin="0,2,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="›" FontSize="19" Foreground="#FFB77926" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PicoCardStyle}" Margin="7,0" Background="#FFF5F9FF" BorderBrush="#FFCFE0FF">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17" Background="#FFE4EFFF" Margin="0,0,9,0">
                  <TextBlock Text="▶" FontSize="13" Foreground="{StaticResource PicoPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="进行中" Style="{StaticResource PicoSectionTitleStyle}" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="1" Content="查看" Padding="10,5" MinHeight="30" FontSize="12" Click="Active_Click" />
            </Grid>
            <TextBlock Text="{Binding InProgressCount, Mode=OneWay}" FontSize="34" FontWeight="Bold" Margin="0,13,0,0" />
            <TextBlock Text="系统现在正在处理的真实任务" Style="{StaticResource PicoMutedTextStyle}" Margin="0,1,0,8" />
            <ItemsControl ItemsSource="{Binding InProgress, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#88FFFFFF" CornerRadius="9" Padding="9" Margin="0,3,0,0">
                    <StackPanel>
                      <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource PicoPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StageText, Mode=OneWay}" Foreground="{StaticResource PicoPrimaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource PicoCardStyle}" Margin="7,0,0,0" Background="#FFF3FCF8" BorderBrush="#FFC8EDDD">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="17" Background="#FFDFF7EC" Margin="0,0,9,0">
                  <TextBlock Text="✓" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PicoSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="已完成" Style="{StaticResource PicoSectionTitleStyle}" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="1" Content="查看" Padding="10,5" MinHeight="30" FontSize="12" Click="Completed_Click" />
            </Grid>
            <TextBlock Text="{Binding CompletedCount, Mode=OneWay}" FontSize="34" FontWeight="Bold" Margin="0,13,0,0" />
            <TextBlock Text="已结束并可以安全查看的任务" Style="{StaticResource PicoMutedTextStyle}" Margin="0,1,0,8" />
            <ItemsControl ItemsSource="{Binding Completed, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#88FFFFFF" CornerRadius="9" Padding="9" Margin="0,3,0,0">
                    <StackPanel>
                      <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource PicoSuccessBrush}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- 最近任务：采用事实表格感，但不显示无法证明的进度百分比。 -->
        <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <Border Style="{StaticResource PicoCardStyle}" Margin="0,0,0,14">
            <StackPanel>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PicoPrimarySoftBrush}" Margin="0,0,9,0">
                    <TextBlock Text="☷" Foreground="{StaticResource PicoPrimaryBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="最近任务" Style="{StaticResource PicoSectionTitleStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="来自 Mac Core 的耐久事实" Foreground="{StaticResource PicoTextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding RecentTasks, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#FFEDF2F8" BorderThickness="0,0,0,1" Padding="8,9">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding StageText, Mode=OneWay}" Foreground="{StaticResource PicoTextMutedBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="8,4" CornerRadius="9" Background="{StaticResource PicoPrimarySoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource PicoPrimaryBrush}" Style="{StaticResource PicoPillTextStyle}" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding UpdatedAtText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource PicoTextMutedBrush}" FontSize="11" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource PicoSoftCardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="系统状态" Style="{StaticResource PicoSectionTitleStyle}" />
                <TextBlock Text="{Binding SystemSummary, Mode=OneWay}" Margin="0,5,0,10" Style="{StaticResource PicoMutedTextStyle}" />
                <WrapPanel>
                  <Border Background="{StaticResource PicoSuccessSoftBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,6">
                    <TextBlock Text="{Binding CoreStatus, StringFormat=Mac Core · {0}, Mode=OneWay}" Foreground="{StaticResource PicoSuccessBrush}" Style="{StaticResource PicoPillTextStyle}" />
                  </Border>
                  <Border Background="{StaticResource PicoSuccessSoftBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,6">
                    <TextBlock Text="{Binding WorkerStatus, StringFormat=Mac Worker · {0}, Mode=OneWay}" Foreground="{StaticResource PicoSuccessBrush}" Style="{StaticResource PicoPillTextStyle}" />
                  </Border>
                  <Border Background="{StaticResource PicoPrimarySoftBrush}" CornerRadius="10" Padding="10,6" Margin="0,0,8,6">
                    <TextBlock Text="{Binding WindowsStatus, StringFormat=Windows · {0}, Mode=OneWay}" Foreground="{StaticResource PicoPrimaryBrush}" Style="{StaticResource PicoPillTextStyle}" />
                  </Border>
                </WrapPanel>
              </StackPanel>
              <Border Grid.Column="1" Width="48" Height="48" CornerRadius="24" Background="{StaticResource PicoSuccessSoftBrush}" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="✓" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PicoSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </Border>
        </StackPanel>

        <!-- 可扩展工作组件：固定目录 + 本地显隐/排序，禁止任意代码插件。 -->
        <Border x:Name="WidgetBoard"
                Grid.Column="1"
                Style="{StaticResource PicoCardStyle}"
                Padding="16">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="工作组件区" Style="{StaticResource PicoSectionTitleStyle}" />
                <TextBlock Text="固定白名单 · 可显示/隐藏/排序" Margin="0,3,0,0" Foreground="{StaticResource PicoTextMutedBrush}" FontSize="11" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="＋ 自定义"
                      Style="{StaticResource PicoSecondaryButtonStyle}"
                      Padding="10,6"
                      MinHeight="32"
                      FontSize="12"
                      Click="CustomizeWidgets_Click" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Widgets, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="12" Padding="12" Margin="0,0,0,9" BorderThickness="1">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFF8FBFF" />
                        <Setter Property="BorderBrush" Value="{StaticResource PicoBorderBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding ToneKey, Mode=OneWay}" Value="Active">
                            <Setter Property="Background" Value="#FFF0F6FF" />
                            <Setter Property="BorderBrush" Value="#FFBFD8FF" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ToneKey, Mode=OneWay}" Value="Success">
                            <Setter Property="Background" Value="{StaticResource PicoSuccessSoftBrush}" />
                            <Setter Property="BorderBrush" Value="#FFBFE8D7" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding ToneKey, Mode=OneWay}" Value="Disabled">
                            <Setter Property="Background" Value="#FFF5F6F8" />
                            <Setter Property="BorderBrush" Value="#FFE4E7EC" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource PicoPrimarySoftBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Glyph, Mode=OneWay}" Foreground="{StaticResource PicoPrimaryBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description, Mode=OneWay}" Margin="0,3,8,0" Foreground="{StaticResource PicoTextMutedBrush}" FontSize="10" TextWrapping="Wrap" MaxHeight="31" />
                      </StackPanel>
                      <Border Grid.Column="2" Padding="8,4" CornerRadius="8" Background="#FFEAF3FF" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="{StaticResource PicoPrimaryBrush}" Style="{StaticResource PicoPillTextStyle}" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border BorderBrush="#FFBCD2F2" BorderThickness="1" CornerRadius="12" Padding="12" Background="#FFF6FAFF" Margin="0,2,0,0">
              <StackPanel>
                <TextBlock Text="＋ 添加 / 管理组件" Foreground="{StaticResource PicoPrimaryBrush}" FontWeight="SemiBold" />
                <TextBlock Text="未来能力通过固定目录扩展，不允许任意 DLL、脚本或 Provider 注入。" Margin="0,4,0,0" Foreground="{StaticResource PicoTextMutedBrush}" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding WidgetLayoutMessage, Mode=OneWay}" Margin="2,9,2,0" Foreground="{StaticResource PicoTextMutedBrush}" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
