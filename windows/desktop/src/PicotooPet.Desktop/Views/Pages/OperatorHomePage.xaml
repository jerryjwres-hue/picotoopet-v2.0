<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pet="clr-namespace:PicotooPet.Desktop.Controls.PetMascot">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="312" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,24,0">
        <Grid Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="今天要做什么？" FontSize="30" FontWeight="SemiBold" Foreground="#FF111827" />
            <TextBlock Text="任务、审核、进度和结果都从这里开始。" Margin="0,7,0,0" Foreground="#FF6B7280" />
          </StackPanel>
          <Button Grid.Column="1"
                  x:Name="NewTaskButton"
                  Content="+ 新建任务"
                  FontSize="16"
                  FontWeight="SemiBold"
                  Padding="20,11"
                  Click="NewTask_Click" />
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Margin="0,0,10,0" Padding="18" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <Button Content="待我审核" HorizontalContentAlignment="Left" FontSize="17" FontWeight="SemiBold" Click="Review_Click" />
              <TextBlock Text="{Binding PendingReviewCount, Mode=OneWay}" FontSize="30" FontWeight="Bold" Margin="4,8,0,4" />
              <TextBlock Text="需要你明确决定的事项" Foreground="#FF6B7280" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding PendingReview, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="4,6">
                      <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="#FF92400E" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Margin="5,0" Padding="18" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <Button Content="进行中" HorizontalContentAlignment="Left" FontSize="17" FontWeight="SemiBold" Click="Active_Click" />
              <TextBlock Text="{Binding InProgressCount, Mode=OneWay}" FontSize="30" FontWeight="Bold" Margin="4,8,0,4" />
              <TextBlock Text="系统现在正在处理的任务" Foreground="#FF6B7280" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding InProgress, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="4,6">
                      <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding StageText, Mode=OneWay}" Foreground="#FF1D4ED8" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Margin="10,0,0,0" Padding="18" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12">
            <StackPanel>
              <Button Content="已完成" HorizontalContentAlignment="Left" FontSize="17" FontWeight="SemiBold" Click="Completed_Click" />
              <TextBlock Text="{Binding CompletedCount, Mode=OneWay}" FontSize="30" FontWeight="Bold" Margin="4,8,0,4" />
              <TextBlock Text="已结束并可查看的任务" Foreground="#FF6B7280" Margin="4,0,0,8" />
              <ItemsControl ItemsSource="{Binding Completed, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="4,6">
                      <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="#FF047857" FontSize="12" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>

      <StackPanel Grid.Column="1" VerticalAlignment="Top">
        <!-- 茅台只读取首页已经存在的计数，并通过事件调用现有入口；不接触任务核心。 -->
        <pet:PetMascotControl x:Name="MaotaiMascot"
                              Margin="0,0,0,20"
                              PendingReviewCount="{Binding PendingReviewCount, Mode=OneWay}"
                              InProgressCount="{Binding InProgressCount, Mode=OneWay}"
                              CompletedCount="{Binding CompletedCount, Mode=OneWay}"
                              NewTaskRequested="Maotai_NewTaskRequested"
                              ProgressRequested="Maotai_ProgressRequested" />

        <Border Padding="18" Background="#FFF8FAFC" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12">
          <StackPanel>
            <TextBlock Text="系统状态" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding SystemSummary, Mode=OneWay}" Margin="0,7,0,16" Foreground="#FF6B7280" TextWrapping="Wrap" />
            <TextBlock Text="Mac Core" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CoreStatus, Mode=OneWay}" Margin="0,3,0,12" Foreground="#FF047857" />
            <TextBlock Text="Mac Worker" FontWeight="SemiBold" />
            <TextBlock Text="{Binding WorkerStatus, Mode=OneWay}" Margin="0,3,0,12" Foreground="#FF047857" TextWrapping="Wrap" />
            <TextBlock Text="Windows" FontWeight="SemiBold" />
            <TextBlock Text="{Binding WindowsStatus, Mode=OneWay}" Margin="0,3,0,0" Foreground="#FF047857" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
