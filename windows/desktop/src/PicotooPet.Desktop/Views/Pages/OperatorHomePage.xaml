<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorHomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <SolidColorBrush x:Key="HomeText" Color="#FF142033" />
    <SolidColorBrush x:Key="HomeMuted" Color="#FF718197" />

    <Style x:Key="CardButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20,16,20,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="292" />
      </Grid.ColumnDefinitions>

      <!-- Main column  : hero, real task buckets and recent real task facts. -->
      <StackPanel Grid.Column="0" Margin="0,0,16,0">
        <Border x:Name="HeroCard"
                Height="168"
                CornerRadius="16"
                Margin="0,0,0,14"
                ClipToBounds="True">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF3AA0FF" Offset="0" />
              <GradientStop Color="#FF1475F2" Offset="0.54" />
              <GradientStop Color="#FF2E8FF7" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="24,22,0,18" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Border Width="56"
                        Height="56"
                        CornerRadius="28"
                        Background="#38FFFFFF"
                        BorderBrush="#88FFFFFF"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                  <TextBlock Text="+"
                             Foreground="White"
                             FontSize="35"
                             FontWeight="Light"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="新建任务"
                             Foreground="White"
                             FontSize="27"
                             FontWeight="Bold" />
                  <TextBlock Text="从一个真实任务开始，让本地 AI 帮你完成执行与分析"
                             Margin="0,4,0,0"
                             Foreground="#E8FFFFFF"
                             FontSize="11" />
                </StackPanel>
              </StackPanel>

              <Button x:Name="NewTaskButton"
                      Content="＋  新建任务   →"
                      Margin="0,13,0,0"
                      Width="150"
                      HorizontalAlignment="Left"
                      Padding="14,8"
                      Background="White"
                      Foreground="#FF175FC2"
                      BorderBrush="#C8FFFFFF"
                      BorderThickness="1"
                      FontWeight="SemiBold"
                      Cursor="Hand"
                      Click="NewTask_Click" />
            </StackPanel>

            <Grid Grid.Column="1" ClipToBounds="True">
              <Ellipse Width="250"
                       Height="126"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,-48,-43"
                       Fill="#18FFFFFF" />
              <Ellipse Width="185"
                       Height="100"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,-18,-24"
                       Stroke="#3AFFFFFF"
                       StrokeThickness="2" />
              <Image Source="/Picotoo Pet AI;component/Assets/Pet/Husky/V1/idle_0.png"
                     Width="190"
                     Height="160"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Bottom"
                     Margin="0,0,6,-5"
                     Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
          </Grid>
        </Border>

        <Grid x:Name="TaskOverviewCard" Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0"
                  Margin="0,0,7,0"
                  Padding="14"
                  CornerRadius="13"
                  Background="#FFFFFBF6"
                  BorderBrush="#FFFFD9B2"
                  BorderThickness="1">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="◷  待我审核"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FF2A2F39"
                        Style="{StaticResource CardButtonStyle}"
                        Click="Review_Click" />
                <Border Grid.Column="1" Background="#FFFF7A1A" CornerRadius="10" Padding="7,2">
                  <TextBlock Text="{Binding PendingReviewCount, Mode=OneWay}"
                             Foreground="White"
                             FontSize="10"
                             FontWeight="Bold" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding PendingReviewCount, Mode=OneWay}"
                         Margin="0,10,0,0"
                         FontSize="27"
                         FontWeight="Bold"
                         Foreground="#FF182234" />
              <TextBlock Text="需要你明确决定的任务"
                         Margin="0,1,0,8"
                         Foreground="#FF9A7A5F"
                         FontSize="10" />
              <ItemsControl ItemsSource="{Binding PendingReview, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="7,5" Margin="0,2" CornerRadius="7" Background="#B8FFFFFF">
                      <StackPanel>
                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="#FFE36B12" FontSize="9" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Column="1"
                  Margin="3,0"
                  Padding="14"
                  CornerRadius="13"
                  Background="#FFF7FAFF"
                  BorderBrush="#FFCEE1FB"
                  BorderThickness="1">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="▶  进行中"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FF2A2F39"
                        Style="{StaticResource CardButtonStyle}"
                        Click="Active_Click" />
                <Border Grid.Column="1" Background="#FF2279EA" CornerRadius="10" Padding="7,2">
                  <TextBlock Text="{Binding InProgressCount, Mode=OneWay}"
                             Foreground="White"
                             FontSize="10"
                             FontWeight="Bold" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding InProgressCount, Mode=OneWay}"
                         Margin="0,10,0,0"
                         FontSize="27"
                         FontWeight="Bold"
                         Foreground="#FF182234" />
              <TextBlock Text="系统正在实际处理的任务"
                         Margin="0,1,0,8"
                         Foreground="#FF6682A6"
                         FontSize="10" />
              <ItemsControl ItemsSource="{Binding InProgress, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="7,5" Margin="0,2" CornerRadius="7" Background="White">
                      <StackPanel>
                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StageText, Mode=OneWay}" Foreground="#FF2776D8" FontSize="9" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Grid.Column="2"
                  Margin="7,0,0,0"
                  Padding="14"
                  CornerRadius="13"
                  Background="#FFF7FCF9"
                  BorderBrush="#FFCBEAD8"
                  BorderThickness="1">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="●  已完成"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FF2A2F39"
                        Style="{StaticResource CardButtonStyle}"
                        Click="Completed_Click" />
                <Border Grid.Column="1" Background="#FF17A568" CornerRadius="10" Padding="7,2">
                  <TextBlock Text="{Binding CompletedCount, Mode=OneWay}"
                             Foreground="White"
                             FontSize="10"
                             FontWeight="Bold" />
                </Border>
              </Grid>
              <TextBlock Text="{Binding CompletedCount, Mode=OneWay}"
                         Margin="0,10,0,0"
                         FontSize="27"
                         FontWeight="Bold"
                         Foreground="#FF182234" />
              <TextBlock Text="已结束并可查看的任务"
                         Margin="0,1,0,8"
                         Foreground="#FF5F8E78"
                         FontSize="10" />
              <ItemsControl ItemsSource="{Binding Completed, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="7,5" Margin="0,2" CornerRadius="7" Background="White">
                      <StackPanel>
                        <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusText, Mode=OneWay}" Foreground="#FF16825A" FontSize="9" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <Border x:Name="RecentTasksCard"
                Padding="14,12"
                CornerRadius="13"
                Background="White"
                BorderBrush="#FFDCE6F2"
                BorderThickness="1">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="▤"
                           Foreground="#FF2478E6"
                           FontSize="15"
                           Margin="0,0,7,0" />
                <TextBlock Text="最近任务"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HomeText}" />
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="来自现有任务事实"
                         Foreground="{StaticResource HomeMuted}"
                         FontSize="9.5" />
            </Grid>

            <Border Background="#FFF7F9FC" CornerRadius="7" Padding="8,6" Margin="0,0,0,3">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.45*" />
                  <ColumnDefinition Width="0.65*" />
                  <ColumnDefinition Width="1.05*" />
                  <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="任务名称" FontSize="9" Foreground="#FF718197" />
                <TextBlock Grid.Column="1" Text="状态" FontSize="9" Foreground="#FF718197" />
                <TextBlock Grid.Column="2" Text="阶段" FontSize="9" Foreground="#FF718197" />
                <TextBlock Grid.Column="3" Text="更新时间" FontSize="9" Foreground="#FF718197" />
              </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding RecentTasks, Mode=OneWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#FFF0F3F7" BorderThickness="0,0,0,1" Padding="8,7">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*" />
                        <ColumnDefinition Width="0.65*" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.8*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Title, Mode=OneWay}"
                                 FontSize="10.5"
                                 FontWeight="SemiBold"
                                 Foreground="#FF283548"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding StatusText, Mode=OneWay}"
                                 FontSize="9.5"
                                 Foreground="#FF2872D0"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding StageText, Mode=OneWay}"
                                 FontSize="9.5"
                                 Foreground="#FF64758B"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding UpdatedAtText, Mode=OneWay}"
                                 FontSize="9"
                                 Foreground="#FF7C899A"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Right column : real system facts plus truthful, non-fabricated supporting cards. -->
      <StackPanel Grid.Column="1">
        <Border x:Name="SystemStatusCard"
                Padding="14"
                CornerRadius="13"
                Background="White"
                BorderBrush="#FFDCE6F2"
                BorderThickness="1"
                Margin="0,0,0,12">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="🛡  系统状态"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource HomeText}" />
              <Border Grid.Column="1" Background="#FFE8F8EF" CornerRadius="9" Padding="7,3">
                <TextBlock Text="{Binding SystemSummary, Mode=OneWay}"
                           Foreground="#FF178354"
                           FontSize="8.5"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="90" />
              </Border>
            </Grid>

            <Grid Margin="0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="⚙  Mac Core" FontSize="10.5" FontWeight="SemiBold" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#FF19A968" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CoreStatus, Mode=OneWay}" FontSize="9.5" Foreground="#FF16825A" />
              </StackPanel>
            </Grid>
            <Separator Opacity="0.35" />
            <Grid Margin="0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="⚙  Mac Worker" FontSize="10.5" FontWeight="SemiBold" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#FF19A968" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding WorkerStatus, Mode=OneWay}" FontSize="9.5" Foreground="#FF16825A" TextTrimming="CharacterEllipsis" MaxWidth="105" />
              </StackPanel>
            </Grid>
            <Separator Opacity="0.35" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="▣  Windows" FontSize="10.5" FontWeight="SemiBold" />
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#FF19A968" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding WindowsStatus, Mode=OneWay}" FontSize="9.5" Foreground="#FF16825A" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Padding="14"
                CornerRadius="13"
                Background="White"
                BorderBrush="#FFDCE6F2"
                BorderThickness="1"
                Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="▥  资源监控"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource HomeText}" />
            <TextBlock Text="当前版本未启用独立资源采样，界面不会伪造 CPU / 内存 / 磁盘百分比。"
                       Margin="0,7,0,10"
                       FontSize="9.5"
                       Foreground="{StaticResource HomeMuted}"
                       TextWrapping="Wrap" />
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="CPU" FontSize="10" />
              <Border Grid.Column="1" Height="7" Background="#FFE7EDF4" CornerRadius="4" Margin="4,3">
                <Border Width="22" HorizontalAlignment="Left" Background="#FFB9C7D7" CornerRadius="4" />
              </Border>
              <TextBlock Grid.Column="2" Text="—" HorizontalAlignment="Right" Foreground="#FF8795A7" />
            </Grid>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="内存" FontSize="10" />
              <Border Grid.Column="1" Height="7" Background="#FFE7EDF4" CornerRadius="4" Margin="4,3">
                <Border Width="22" HorizontalAlignment="Left" Background="#FFB9C7D7" CornerRadius="4" />
              </Border>
              <TextBlock Grid.Column="2" Text="—" HorizontalAlignment="Right" Foreground="#FF8795A7" />
            </Grid>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="26" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="磁盘" FontSize="10" />
              <Border Grid.Column="1" Height="7" Background="#FFE7EDF4" CornerRadius="4" Margin="4,3">
                <Border Width="22" HorizontalAlignment="Left" Background="#FFB9C7D7" CornerRadius="4" />
              </Border>
              <TextBlock Grid.Column="2" Text="—" HorizontalAlignment="Right" Foreground="#FF8795A7" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Padding="14"
                CornerRadius="13"
                Background="White"
                BorderBrush="#FFDCE6F2"
                BorderThickness="1">
          <StackPanel>
            <TextBlock Text="▦  工作组件区"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource HomeText}" />
            <TextBlock Text="沿用现有能力与高级入口，不创建第二套执行面。"
                       Margin="0,4,0,10"
                       Foreground="{StaticResource HomeMuted}"
                       FontSize="9.5"
                       TextWrapping="Wrap" />
            <UniformGrid Columns="2" Rows="2">
              <Border Margin="0,0,4,4" Padding="9" CornerRadius="9" Background="#FFF4F8FF" BorderBrush="#FFD9E8FB" BorderThickness="1">
                <StackPanel><TextBlock Text="⌕" FontSize="19" Foreground="#FF2676DF" /><TextBlock Text="项目 / 调研" FontSize="9.5" FontWeight="SemiBold" /></StackPanel>
              </Border>
              <Border Margin="4,0,0,4" Padding="9" CornerRadius="9" Background="#FFF4FBF7" BorderBrush="#FFD7EFE1" BorderThickness="1">
                <StackPanel><TextBlock Text="▥" FontSize="19" Foreground="#FF1B9A61" /><TextBlock Text="业务分析" FontSize="9.5" FontWeight="SemiBold" /></StackPanel>
              </Border>
              <Border Margin="0,4,4,0" Padding="9" CornerRadius="9" Background="#FFFAF6FF" BorderBrush="#FFE9DDF8" BorderThickness="1">
                <StackPanel><TextBlock Text="▶" FontSize="17" Foreground="#FF7753D8" /><TextBlock Text="自动化" FontSize="9.5" FontWeight="SemiBold" /></StackPanel>
              </Border>
              <Border Margin="4,4,0,0" Padding="9" CornerRadius="9" Background="#FFFFF8F2" BorderBrush="#FFFFE3CB" BorderThickness="1">
                <StackPanel><TextBlock Text="✓" FontSize="19" Foreground="#FFF27A22" /><TextBlock Text="结果 / 审核" FontSize="9.5" FontWeight="SemiBold" /></StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</UserControl>
