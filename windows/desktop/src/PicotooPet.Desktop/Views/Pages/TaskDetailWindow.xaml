<Window x:Class="PicotooPet.Desktop.Views.Pages.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务详情"
        Width="860"
        Height="680"
        MinWidth="680"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#FFF5F8FC"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="{Binding Title}"
                 FontSize="26"
                 FontWeight="SemiBold"
                 Foreground="#FF172236" />
      <TextBlock Text="{Binding TaskType}"
                 Margin="0,5,0,0"
                 FontSize="13"
                 Foreground="#FF66788E" />
    </StackPanel>

    <Border Grid.Row="1"
            Margin="0,18,0,14"
            Padding="18"
            CornerRadius="14"
            Background="White"
            BorderBrush="#FFDCE6F2"
            BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="任务 ID" FontSize="13" Foreground="#FF6A7A90" />
        <TextBlock Grid.Column="1" Text="{Binding TaskId}" FontSize="14" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Text="状态" Margin="0,10,0,0" FontSize="13" Foreground="#FF6A7A90" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" />
        <TextBlock Grid.Row="2" Text="状态说明" Margin="0,10,0,0" FontSize="13" Foreground="#FF6A7A90" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SafeStatusSummaryText}" Margin="0,10,0,0" FontSize="14" Foreground="#FF43546A" TextWrapping="Wrap" />
        <TextBlock Grid.Row="3" Text="创建时间" Margin="0,10,0,0" FontSize="13" Foreground="#FF6A7A90" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CreatedAtText}" Margin="0,10,0,0" FontSize="14" />
        <TextBlock Grid.Row="4" Text="更新时间" Margin="0,10,0,0" FontSize="13" Foreground="#FF6A7A90" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding UpdatedAtText}" Margin="0,10,0,0" FontSize="14" />
        <TextBlock Grid.Row="5" Text="执行次数" Margin="0,10,0,0" FontSize="13" Foreground="#FF6A7A90" />
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding AttemptText}" Margin="0,10,0,0" FontSize="14" />
        <TextBlock Grid.Row="6" Text="任务目标" Margin="0,10,0,0" FontSize="13" Foreground="#FF6A7A90" />
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding GoalText}" Margin="0,10,0,0" FontSize="14" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border Grid.Row="2"
            Padding="18"
            CornerRadius="14"
            Background="White"
            BorderBrush="#FFDCE6F2"
            BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding ResultTitle}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#FF172236" />
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding ResultText}"
                     FontSize="14"
                     LineHeight="22"
                     Foreground="#FF26364B"
                     TextWrapping="Wrap" />
        </ScrollViewer>
      </Grid>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="关闭"
              Width="92"
              Height="38"
              FontSize="14"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
