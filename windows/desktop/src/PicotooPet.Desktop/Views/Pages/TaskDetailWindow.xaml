<Window x:Class="PicotooPet.Desktop.Views.Pages.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务详情"
        Width="1100"
        Height="700"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#FFF4F7FB"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 顶部只保留任务身份；具体元数据、耐久进度和结果分别阅读。 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Title}"
                   FontSize="27"
                   FontWeight="SemiBold"
                   Foreground="#FF172236" />
        <TextBlock Text="{Binding TaskType}"
                   Margin="0,5,0,0"
                   FontSize="14"
                   Foreground="#FF66788E" />
      </StackPanel>
      <Border Grid.Column="1"
              Padding="12,7"
              VerticalAlignment="Center"
              CornerRadius="10"
              Background="#FFEAF3FF"
              BorderBrush="#FFD3E5FB"
              BorderThickness="1">
        <TextBlock Text="{Binding StatusText}"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#FF236BC4" />
      </Border>
    </Grid>

    <!-- 左边理解任务，右边先看 Core 耐久进度再看结果；两区独立滚动。 -->
    <Grid x:Name="DetailWorkspace" Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="330" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="MetadataPane"
              Grid.Column="0"
              Padding="20"
              CornerRadius="15"
              Background="White"
              BorderBrush="#FFDCE6F2"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="任务信息"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FF172236" />
            <TextBlock Text="任务本身的固定安全字段"
                       Margin="0,4,0,0"
                       FontSize="14"
                       Foreground="#FF7A8A9E" />
          </StackPanel>

          <ScrollViewer Grid.Row="1"
                        Margin="0,16,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="任务 ID" FontSize="14" Foreground="#FF7A8A9E" />
              <TextBlock Text="{Binding TaskId}"
                         Margin="0,4,0,0"
                         FontSize="14"
                         Foreground="#FF27384E"
                         TextWrapping="Wrap" />

              <TextBlock Text="状态说明" Margin="0,18,0,0" FontSize="14" Foreground="#FF7A8A9E" />
              <TextBlock Text="{Binding SafeStatusSummaryText}"
                         Margin="0,4,0,0"
                         FontSize="14"
                         LineHeight="21"
                         Foreground="#FF43546A"
                         TextWrapping="Wrap" />

              <Separator Margin="0,18,0,16" Background="#FFE5EBF2" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="88" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="创建时间" FontSize="14" Foreground="#FF7A8A9E" />
                <TextBlock Grid.Column="1" Text="{Binding CreatedAtText}" FontSize="14" Foreground="#FF33465E" />
                <TextBlock Grid.Row="1" Text="更新时间" Margin="0,10,0,0" FontSize="14" Foreground="#FF7A8A9E" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedAtText}" Margin="0,10,0,0" FontSize="14" Foreground="#FF33465E" />
                <TextBlock Grid.Row="2" Text="执行次数" Margin="0,10,0,0" FontSize="14" Foreground="#FF7A8A9E" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AttemptText}" Margin="0,10,0,0" FontSize="14" Foreground="#FF33465E" />
              </Grid>

              <TextBlock Text="任务目标" Margin="0,20,0,0" FontSize="14" Foreground="#FF7A8A9E" />
              <Border Margin="0,6,0,0"
                      Padding="12"
                      CornerRadius="10"
                      Background="#FFF7F9FC"
                      BorderBrush="#FFE5EBF2"
                      BorderThickness="1">
                <TextBlock Text="{Binding GoalText}"
                           FontSize="14"
                           LineHeight="21"
                           Foreground="#FF27384E"
                           TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border x:Name="ResultPane"
              Grid.Column="2"
              Padding="22"
              CornerRadius="15"
              Background="White"
              BorderBrush="#FFDCE6F2"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="结果预览"
                       FontSize="14"
                       Foreground="#FF7A8A9E" />
            <TextBlock Text="{Binding ResultTitle}"
                       Margin="0,4,0,0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#FF172236"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Border Grid.Row="1"
                  Height="1"
                  Margin="0,15,0,0"
                  Background="#FFE5EBF2" />

          <!-- 这里只展示 Mac Core 已经耐久提交的进度事实；没有事实就明确显示“无可验证进度”。 -->
          <Border Grid.Row="2"
                  Margin="0,16,0,0"
                  Padding="14"
                  CornerRadius="11"
                  Background="#FFF7FAFE"
                  BorderBrush="#FFDCE8F7"
                  BorderThickness="1">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="当前处理进度"
                             FontSize="13"
                             Foreground="#FF7A8A9E" />
                  <TextBlock Text="{Binding ProgressStageText}"
                             Margin="0,3,0,0"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Foreground="#FF203854"
                             TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressValueText}"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FF236BC4"
                           TextWrapping="Wrap" />
              </Grid>

              <TextBlock Text="{Binding ProgressMessageText}"
                         Margin="0,10,0,0"
                         FontSize="14"
                         LineHeight="21"
                         Foreground="#FF40536A"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding LastActivityText, StringFormat=最近活动：{0}}"
                         Margin="0,7,0,0"
                         FontSize="12"
                         Foreground="#FF7A8A9E" />

              <TextBlock Text="最近活动"
                         Margin="0,12,0,0"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="#FF66788E" />
              <TextBlock Text="{Binding RecentActivityText}"
                         Margin="0,4,0,0"
                         MaxHeight="116"
                         FontSize="12"
                         LineHeight="19"
                         Foreground="#FF52657B"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="3"
                        Margin="0,16,0,0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding ResultText}"
                       FontSize="14"
                       LineHeight="24"
                       Foreground="#FF26364B"
                       TextWrapping="Wrap" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2"
                Margin="0,14,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="关闭"
              Width="92"
              Height="38"
              FontSize="14"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
