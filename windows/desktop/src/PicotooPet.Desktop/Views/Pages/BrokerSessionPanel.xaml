<UserControl x:Class="PicotooPet.Desktop.Views.Pages.BrokerSessionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Border Margin="0,14,0,0"
            Padding="18"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Phase 10B-B Mock Dev Broker"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="#475569"
                               Text="内置 Mock Provider · 应用自有 LocalAppData 沙盒 · Windows Job Object 进程树隔离"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="10,6"
                        Background="#ECFDF5"
                        BorderBrush="#A7F3D0"
                        BorderThickness="1"
                        CornerRadius="14">
                    <TextBlock Foreground="#047857"
                               FontWeight="SemiBold"
                               Text="无真实 Provider" />
                </Border>
            </Grid>

            <Border Margin="0,12,0,0"
                    Padding="11"
                    Background="#FFF7ED"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    CornerRadius="7">
                <TextBlock Foreground="#7C2D12"
                           Text="{Binding SafetyNotice, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="17"
                               FontWeight="SemiBold"
                               Text="Approved Handoff" />
                    <ListBox Margin="0,8,0,0"
                             MinHeight="120"
                             MaxHeight="190"
                             DisplayMemberPath="Title"
                             ItemsSource="{Binding ApprovedHandoffs, Mode=OneWay}"
                             SelectedItem="{Binding SelectedHandoff, Mode=TwoWay}" />

                    <TextBlock Margin="0,14,0,0"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="最近 Broker Session" />
                    <ListBox Margin="0,8,0,0"
                             MinHeight="150"
                             MaxHeight="240"
                             ItemsSource="{Binding RecentSessions, Mode=OneWay}"
                             SelectedItem="{Binding SelectedRecentSession, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="2,3"
                                        Padding="9"
                                        Background="White"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding SessionId, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="#64748B"
                                                       FontSize="12"
                                                       Text="{Binding UpdatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Margin="12,0,0,0"
                                                   Foreground="#1D4ED8"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Status, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Margin="0,12,0,0"
                               HorizontalAlignment="Right">
                        <Button Content="刷新 Broker 状态"
                                Command="{Binding RefreshCommand, Mode=OneWay}" />
                        <Button Content="启动 Mock Provider 沙盒验证"
                                Command="{Binding StartCommand, Mode=OneWay}" />
                        <Button Content="取消 Broker Session"
                                Command="{Binding CancelCommand, Mode=OneWay}" />
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="16"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewVisible, Mode=OneWay}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Text="Broker 安全预览尚未加载" />
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="#64748B"
                                       Text="选择 approved Handoff 并启动固定 Mock Provider，或从最近 Session 中选择一条记录。"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewVisible, Mode=OneWay}"
                                                     Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="19"
                                           FontWeight="SemiBold"
                                           Text="Broker Session 安全预览" />
                                <Border Grid.Column="1"
                                        Padding="9,5"
                                        Background="#EFF6FF"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="13">
                                    <TextBlock Foreground="#1D4ED8"
                                               FontWeight="SemiBold"
                                               Text="{Binding SelectedSession.Status, Mode=OneWay}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="Session ID" />
                                <TextBlock Grid.Column="1"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedSession.SessionId, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Margin="0,7,0,0" FontWeight="SemiBold" Text="Handoff ID" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedSession.HandoffId, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="2" Margin="0,7,0,0" FontWeight="SemiBold" Text="Provider" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,7,0,0"
                                           Text="{Binding SelectedSession.Provider, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Margin="0,7,0,0" FontWeight="SemiBold" Text="硬超时" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,7,0,0"
                                           Text="{Binding SelectedSession.TimeoutSeconds, Mode=OneWay, StringFormat={}{0} 秒}" />
                                <TextBlock Grid.Row="4" Margin="0,7,0,0" FontWeight="SemiBold" Text="Return ID" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,7,0,0"
                                           FontFamily="Consolas"
                                           Text="{Binding SelectedSession.ReturnId, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Margin="0,7,0,0" FontWeight="SemiBold" Text="事件数量" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,7,0,0"
                                           Text="{Binding SelectedSession.EventCount, Mode=OneWay}" />
                                <TextBlock Grid.Row="6" Margin="0,7,0,0" FontWeight="SemiBold" Text="固定变更" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,7,0,0"
                                           Text="{Binding ChangedFileSummary, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <Border Margin="0,14,0,0"
                                    Padding="11"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="request digest" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Text="{Binding SelectedSession.RequestDigest, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="package digest" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Text="{Binding SelectedSession.PackageDigest, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="sandbox digest" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Text="{Binding SelectedSession.SandboxDigest, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,12,0,0"
                                    Padding="10"
                                    Background="#ECFDF5"
                                    BorderBrush="#A7F3D0"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <TextBlock Foreground="#047857"
                                           Text="{Binding SelectedSession.ExecutionNotice, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Margin="0,12,0,0"
                    Padding="10"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="7">
                <TextBlock Foreground="#334155"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
