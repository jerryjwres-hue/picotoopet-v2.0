<UserControl x:Class="PicotooPet.Desktop.Views.Pages.AutomationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Page_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="2*" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="自动化" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Margin="0,6,0,0" Text="耐久 DAG 工作流建立在现有任务队列之上，支持重启恢复、暂停、恢复、取消和有界重试。" TextWrapping="Wrap" />
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="0,16,0,10">
      <Button Content="刷新"
              Click="Refresh_Click"
              IsEnabled="{Binding CanRefresh, Mode=OneWay}"
              ToolTip="{Binding RefreshActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True" />
      <Button Content="创建本地诊断测试流"
              Click="CreateSafeWorkflow_Click"
              IsEnabled="{Binding CanCreateSafeWorkflow, Mode=OneWay}"
              ToolTip="{Binding CreateActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True" />
      <Button Content="推进所选"
              Click="Reconcile_Click"
              IsEnabled="{Binding CanReconcile, Mode=OneWay}"
              ToolTip="{Binding ReconcileActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True" />
      <Button Content="暂停"
              Click="Pause_Click"
              IsEnabled="{Binding CanPause, Mode=OneWay}"
              ToolTip="{Binding PauseActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True" />
      <Button Content="恢复"
              Click="Resume_Click"
              IsEnabled="{Binding CanResume, Mode=OneWay}"
              ToolTip="{Binding ResumeActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True" />
      <Button Content="取消"
              Click="Cancel_Click"
              IsEnabled="{Binding CanCancel, Mode=OneWay}"
              ToolTip="{Binding CancelActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True" />
    </WrapPanel>

    <DataGrid Grid.Row="2"
              ItemsSource="{Binding Workflows}"
              SelectedItem="{Binding SelectedWorkflow}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn Header="工作流" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
        <DataGridTextColumn Header="状态" Binding="{Binding Status, Mode=OneWay}" Width="130" />
        <DataGridTextColumn Header="优先级" Binding="{Binding Priority, Mode=OneWay}" Width="90" />
        <DataGridTextColumn Header="并发" Binding="{Binding MaxConcurrency, Mode=OneWay}" Width="80" />
        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, Mode=OneWay}" Width="180" />
      </DataGrid.Columns>
    </DataGrid>

    <GroupBox Grid.Row="3" Header="所选工作流步骤" Margin="0,12,0,0">
      <DataGrid ItemsSource="{Binding SelectedSteps}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="步骤" Binding="{Binding StepKey, Mode=OneWay}" Width="*" />
          <DataGridTextColumn Header="Task Type" Binding="{Binding TaskType, Mode=OneWay}" Width="2*" />
          <DataGridTextColumn Header="状态" Binding="{Binding Status, Mode=OneWay}" Width="130" />
          <DataGridTextColumn Header="尝试" Binding="{Binding AttemptCount, Mode=OneWay}" Width="70" />
          <DataGridTextColumn Header="上限" Binding="{Binding MaxAttempts, Mode=OneWay}" Width="70" />
          <DataGridTextColumn Header="Task ID" Binding="{Binding TaskId, Mode=OneWay}" Width="2*" />
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>

    <TextBlock Grid.Row="4" Margin="0,10,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
