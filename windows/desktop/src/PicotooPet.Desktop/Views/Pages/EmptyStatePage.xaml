<UserControl x:Class="PicotooPet.Desktop.Views.Pages.EmptyStatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Background="White" Margin="32">
    <Border MaxWidth="760"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource PanelBrush}"
            CornerRadius="16"
            Padding="32">
      <StackPanel>
        <TextBlock Text="{Binding Title}"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#FF111827" />
        <TextBlock Text="{Binding Reason}"
                   Margin="0,20,0,0"
                   FontSize="16"
                   TextWrapping="Wrap"
                   Foreground="#FF374151" />
        <TextBlock Text="{Binding NextStep}"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Foreground="#FF4B5563" />
        <Border Margin="0,22,0,0"
                Padding="14"
                Background="#FFEFF6FF"
                CornerRadius="8">
          <TextBlock Text="{Binding UserAction}"
                     TextWrapping="Wrap"
                     Foreground="#FF1D4ED8" />
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
