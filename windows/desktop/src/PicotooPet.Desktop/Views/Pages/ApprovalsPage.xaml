<UserControl x:Class="PicotooPet.Desktop.Views.Pages.ApprovalsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="ApprovalsPage_Loaded">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="筛选" VerticalAlignment="Center" Margin="0,0,10,0" />
      <ComboBox Grid.Column="1"
                ItemsSource="{Binding FilterOptions, Mode=OneWay}"
                DisplayMemberPath="Label"
                SelectedValuePath="Value"
                SelectedValue="{Binding SelectedFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Grid.Column="2"
                 Margin="18,0,0,0"
                 VerticalAlignment="Center"
                 Text="{Binding VisibleApprovals.Count, Mode=OneWay, StringFormat=当前 {0} 项}" />
      <Button Grid.Column="4"
              Width="92"
              Content="刷新审批"
              IsEnabled="{Binding CanRefresh, Mode=OneWay}"
              ToolTip="{Binding RefreshActionReason, Mode=OneWay}"
              ToolTipService.ShowOnDisabled="True"
              Click="Refresh_Click" />
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="430" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <DataGrid Grid.Column="0"
                ItemsSource="{Binding VisibleApprovals, Mode=OneWay}"
                SelectedItem="{Binding SelectedApproval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                EnableRowVirtualization="True"
                EnableColumnVirtualization="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="审批类型"
                              Width="1.2*"
                              Binding="{Binding ApprovalTypeText, Mode=OneWay}" />
          <DataGridTextColumn Header="状态"
                              Width="90"
                              Binding="{Binding StatusText, Mode=OneWay}" />
          <DataGridTextColumn Header="申请时间"
                              Width="145"
                              Binding="{Binding RequestedAtText, Mode=OneWay}" />
          <DataGridTextColumn Header="范围摘要"
                              Width="2*"
                              Binding="{Binding ScopeSummary, Mode=OneWay}" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="2"
              Background="#FFF8FAFC"
              BorderBrush="#FFE2E8F0"
              BorderThickness="1"
              CornerRadius="10"
              Padding="18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0"
                     Text="审批详情"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Margin="0,0,0,12" />

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="审批 ID" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedApproval.ApprovalId, Mode=OneWay}"
                         TextWrapping="Wrap"
                         Margin="0,2,0,10" />
              <TextBlock Text="任务 ID" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedApproval.TaskId, Mode=OneWay}"
                         TextWrapping="Wrap"
                         Margin="0,2,0,10" />
              <TextBlock Text="状态" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedApproval.StatusText, Mode=OneWay}"
                         Margin="0,2,0,10" />
              <TextBlock Text="请求范围" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedApproval.ScopeSummary, Mode=OneWay}"
                         TextWrapping="Wrap"
                         Margin="0,2,0,10" />
              <TextBlock Text="请求摘要" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedApproval.DigestShort, Mode=OneWay}"
                         Margin="0,2,0,10" />
              <TextBlock Text="到期时间" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedApproval.ExpiresAtText, Mode=OneWay}"
                         Margin="0,2,0,10" />
              <TextBlock Text="已有决策原因" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedApproval.DecisionReason, Mode=OneWay}"
                         TextWrapping="Wrap"
                         Margin="0,2,0,14" />
              <TextBlock Text="本次决策原因" FontWeight="SemiBold" />
              <TextBox Text="{Binding DecisionReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       MinHeight="72"
                       MaxLength="500"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       Margin="0,5,0,8" />
              <TextBlock Text="每次决策绑定当前摘要并携带幂等键；请求内容变化后必须刷新重新确认。"
                         Foreground="#FF475569"
                         TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0"
                      Content="批准"
                      IsEnabled="{Binding CanApprove, Mode=OneWay}"
                      ToolTip="{Binding ApproveActionReason, Mode=OneWay}"
                      ToolTipService.ShowOnDisabled="True"
                      Click="Approve_Click" />
              <Button Grid.Column="2"
                      Content="拒绝"
                      IsEnabled="{Binding CanReject, Mode=OneWay}"
                      ToolTip="{Binding RejectActionReason, Mode=OneWay}"
                      ToolTipService.ShowOnDisabled="True"
                      Click="Reject_Click" />
            </Grid>
            <TextBlock Text="页面不接收或显示一次性明文令牌、Token、原始路径和任意请求正文。"
                       Margin="0,10,0,0"
                       Foreground="#FF475569"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2"
               Margin="0,12,0,0"
               Text="{Binding StatusMessage, Mode=OneWay}"
               Foreground="#FF475569"
               TextWrapping="Wrap" />
  </Grid>
</UserControl>
