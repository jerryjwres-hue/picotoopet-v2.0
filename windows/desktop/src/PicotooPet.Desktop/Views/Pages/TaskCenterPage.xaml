<UserControl x:Class="PicotooPet.Desktop.Views.Pages.TaskCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="760"
             d:DesignWidth="1040"
             mc:Ignorable="d">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
  </UserControl.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="16" Background="#FFFFF8EC" BorderBrush="#FFF5D6A8" BorderThickness="1" CornerRadius="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding WorkerStatusText, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#FF8A4A16" />
          <TextBlock Text="{Binding WorkerReasonText, Mode=OneWay}" Margin="0,5,20,0" FontSize="14" Foreground="#FF795538" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Width="170"
                Height="40"
                VerticalAlignment="Center"
                Click="CreateDiagnostic_Click"
                IsEnabled="{Binding CanCreateDiagnostic, Mode=OneWay}"
                Content="创建系统诊断快照"
                ToolTip="{Binding DiagnosticCreateReason, Mode=OneWay}"
                ToolTipService.ShowOnDisabled="True" />
      </Grid>
    </Border>

    <DockPanel Grid.Row="1" Margin="0,16,0,12">
      <TextBlock DockPanel.Dock="Left" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="筛选" />
      <ComboBox Width="190"
                ItemsSource="{Binding FilterOptions, Mode=OneWay}"
                DisplayMemberPath="Label"
                SelectedValuePath="Value"
                SelectedValue="{Binding SelectedFilter, Mode=TwoWay}" />
      <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="14" Foreground="#FF64758B" Text="{Binding VisibleTasks.Count, Mode=OneWay, StringFormat=当前 {0} 项}" />
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="470" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <ListView Grid.Column="0"
                ItemsSource="{Binding VisibleTasks, Mode=OneWay}"
                SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                MouseDoubleClick="TaskList_DoubleClick"
                ToolTip="双击任务行可打开统一任务详情和可用结果。"
                ScrollViewer.CanContentScroll="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.View>
          <GridView AllowsColumnReorder="False">
            <GridViewColumn Header="任务类型" Width="175" DisplayMemberBinding="{Binding TaskType, Mode=OneWay}" />
            <GridViewColumn Header="状态" Width="120" DisplayMemberBinding="{Binding DisplayStatus, Mode=OneWay}" />
            <GridViewColumn Header="尝试" Width="70" DisplayMemberBinding="{Binding AttemptText, Mode=OneWay}" />
            <GridViewColumn Header="更新时间" Width="170" DisplayMemberBinding="{Binding UpdatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
            <GridViewColumn Header="任务 ID" Width="250" DisplayMemberBinding="{Binding TaskId, Mode=OneWay}" />
          </GridView>
        </ListView.View>
      </ListView>

      <Border Grid.Column="2" Padding="18" Background="White" BorderBrush="#FFDDE7F2" BorderThickness="1" CornerRadius="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="任务详情" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="保留完整任务元数据；所有任务都可打开统一详情，有结果时会从 Mac Core 固定结果接口加载。"
                       Margin="0,4,0,0"
                       FontSize="14"
                       Foreground="#FF64758B"
                       TextWrapping="Wrap" />
          </StackPanel>

          <ScrollViewer Grid.Row="1" Margin="0,16,0,16">
            <StackPanel>
              <StackPanel DataContext="{Binding SelectedTask, Mode=OneWay}">
                <TextBlock FontWeight="SemiBold" Text="任务 ID" />
                <TextBlock Margin="0,3,0,10" Text="{Binding TaskId, Mode=OneWay}" TextWrapping="Wrap" />

                <TextBlock FontWeight="SemiBold" Text="任务类型" />
                <TextBlock Margin="0,3,0,10" Text="{Binding TaskType, Mode=OneWay}" TextWrapping="Wrap" />

                <TextBlock FontWeight="SemiBold" Text="原始状态" />
                <TextBlock Margin="0,3,0,10" Text="{Binding Status, Mode=OneWay}" />

                <TextBlock FontWeight="SemiBold" Text="用户状态" />
                <TextBlock Margin="0,3,0,10" Text="{Binding DisplayStatus, Mode=OneWay}" />

                <TextBlock FontWeight="SemiBold" Text="创建时间" />
                <TextBlock Margin="0,3,0,10" Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />

                <TextBlock FontWeight="SemiBold" Text="更新时间" />
                <TextBlock Margin="0,3,0,10" Text="{Binding UpdatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />

                <TextBlock FontWeight="SemiBold" Text="优先级 / 超时" />
                <TextBlock Margin="0,3,0,10">
                  <Run Text="{Binding Priority, Mode=OneWay}" />
                  <Run Text=" / " />
                  <Run Text="{Binding TimeoutSeconds, Mode=OneWay}" />
                  <Run Text=" 秒" />
                </TextBlock>

                <TextBlock FontWeight="SemiBold" Text="错误" />
                <TextBlock Margin="0,3,0,0" Text="{Binding Error, Mode=OneWay}" TextWrapping="Wrap" />
              </StackPanel>

              <Border Margin="0,18,0,0"
                      Padding="12"
                      Background="#FFF8FBFF"
                      BorderBrush="#FFD5E3F2"
                      BorderThickness="1"
                      CornerRadius="9"
                      DataContext="{Binding DataContext.DiagnosticResult, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                      Visibility="{Binding DataContext.IsDiagnosticResultVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                  <TextBlock Text="系统诊断安全卡片" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StatusText, Mode=OneWay}" Margin="0,5,0,10" Foreground="#FF475569" TextWrapping="Wrap" />

                  <TextBlock FontWeight="SemiBold" Text="生成时间" />
                  <TextBlock Text="{Binding GeneratedAtText, Mode=OneWay}" Margin="0,3,0,9" TextWrapping="Wrap" />

                  <TextBlock FontWeight="SemiBold" Text="Core" />
                  <TextBlock Text="{Binding CoreText, Mode=OneWay}" Margin="0,3,0,9" TextWrapping="Wrap" />

                  <TextBlock FontWeight="SemiBold" Text="Worker" />
                  <TextBlock Text="{Binding WorkerText, Mode=OneWay}" Margin="0,3,0,9" TextWrapping="Wrap" />

                  <TextBlock FontWeight="SemiBold" Text="Queue" />
                  <TextBlock Text="{Binding QueueText, Mode=OneWay}" Margin="0,3,0,9" TextWrapping="Wrap" />

                  <TextBlock FontWeight="SemiBold" Text="Checks" />
                  <TextBlock Text="{Binding ChecksText, Mode=OneWay}" Margin="0,3,0,9" TextWrapping="Wrap" />

                  <TextBlock FontWeight="SemiBold" Text="Warnings" />
                  <TextBlock Text="{Binding WarningsText, Mode=OneWay}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <WrapPanel Grid.Row="2">
            <Button Width="112"
                    Margin="0,0,8,8"
                    Click="OpenTaskDetail_Click"
                    IsEnabled="{Binding CanOpenSelectedTaskDetail, Mode=OneWay}"
                    ToolTip="{Binding TaskDetailActionReason, Mode=OneWay}"
                    ToolTipService.ShowOnDisabled="True"
                    Content="查看详情 / 结果" />
            <Button Width="92"
                    Margin="0,0,8,8"
                    Click="Cancel_Click"
                    IsEnabled="{Binding CanCancelSelected, Mode=OneWay}"
                    ToolTip="{Binding CancelActionReason, Mode=OneWay}"
                    ToolTipService.ShowOnDisabled="True"
                    Content="取消任务" />
            <Button Width="112"
                    Margin="0,0,8,8"
                    Click="Retry_Click"
                    IsEnabled="{Binding CanRetrySelected, Mode=OneWay}"
                    ToolTip="{Binding RetryActionReason, Mode=OneWay}"
                    ToolTipService.ShowOnDisabled="True"
                    Content="创建重试任务" />
            <Button Width="120"
                    Margin="0,0,0,8"
                    Click="ViewDiagnosticResult_Click"
                    IsEnabled="{Binding CanViewDiagnosticResult, Mode=OneWay}"
                    ToolTip="{Binding DiagnosticResultActionReason, Mode=OneWay}"
                    ToolTipService.ShowOnDisabled="True"
                    Content="诊断安全卡片" />
          </WrapPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,9" Background="#FFF7FAFD" BorderBrush="#FFE0E8F2" BorderThickness="1" CornerRadius="9">
      <TextBlock Foreground="#FF475569" FontSize="14" Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
