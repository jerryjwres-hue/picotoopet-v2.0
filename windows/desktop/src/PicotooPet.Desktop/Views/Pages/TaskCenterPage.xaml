<UserControl x:Class="PicotooPet.Desktop.Views.Pages.TaskCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignHeight="760"
             d:DesignWidth="1040"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16"
                Background="#FFF7ED"
                BorderBrush="#FED7AA"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="{Binding WorkerStatusText, Mode=OneWay}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#9A3412" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding WorkerReasonText, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="#7C2D12" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Width="164"
                    Height="34"
                    Click="CreateDiagnostic_Click"
                    IsEnabled="{Binding CanCreateDiagnostic, Mode=OneWay}"
                    Content="创建系统诊断快照" />
            <TextBlock Grid.Column="1"
                       Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#475569"
                       Text="{Binding DiagnosticCreateReason, Mode=OneWay}"
                       TextWrapping="Wrap" />
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,18,0,12">
            <TextBlock DockPanel.Dock="Left"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Text="筛选" />
            <ComboBox Width="180"
                      ItemsSource="{Binding FilterOptions, Mode=OneWay}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedFilter, Mode=TwoWay}" />
            <TextBlock Margin="18,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#64748B"
                       Text="{Binding VisibleTasks.Count, Mode=OneWay, StringFormat=当前 {0} 项}" />
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="460" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding VisibleTasks, Mode=OneWay}"
                      SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="任务类型"
                                        Width="160"
                                        DisplayMemberBinding="{Binding TaskType, Mode=OneWay}" />
                        <GridViewColumn Header="状态"
                                        Width="120"
                                        DisplayMemberBinding="{Binding DisplayStatus, Mode=OneWay}" />
                        <GridViewColumn Header="尝试"
                                        Width="70"
                                        DisplayMemberBinding="{Binding AttemptText, Mode=OneWay}" />
                        <GridViewColumn Header="更新时间"
                                        Width="170"
                                        DisplayMemberBinding="{Binding UpdatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        <GridViewColumn Header="任务 ID"
                                        Width="260"
                                        DisplayMemberBinding="{Binding TaskId, Mode=OneWay}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="任务详情"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1" Margin="0,16,0,16">
                        <StackPanel>
                            <StackPanel DataContext="{Binding SelectedTask, Mode=OneWay}">
                                <TextBlock FontWeight="SemiBold" Text="任务 ID" />
                                <TextBlock Margin="0,3,0,12"
                                           Text="{Binding TaskId, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Text="原始状态" />
                                <TextBlock Margin="0,3,0,12" Text="{Binding Status, Mode=OneWay}" />
                                <TextBlock FontWeight="SemiBold" Text="用户状态" />
                                <TextBlock Margin="0,3,0,12" Text="{Binding DisplayStatus, Mode=OneWay}" />
                                <TextBlock FontWeight="SemiBold" Text="创建时间" />
                                <TextBlock Margin="0,3,0,12"
                                           Text="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />
                                <TextBlock FontWeight="SemiBold" Text="更新时间" />
                                <TextBlock Margin="0,3,0,12"
                                           Text="{Binding UpdatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />
                                <TextBlock FontWeight="SemiBold" Text="优先级 / 超时" />
                                <TextBlock Margin="0,3,0,12">
                                    <Run Text="{Binding Priority, Mode=OneWay}" />
                                    <Run Text=" / " />
                                    <Run Text="{Binding TimeoutSeconds, Mode=OneWay}" />
                                    <Run Text=" 秒" />
                                </TextBlock>
                                <TextBlock FontWeight="SemiBold" Text="错误" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding Error, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Margin="0,18,0,0"
                                    Padding="12"
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    DataContext="{Binding DataContext.DiagnosticResult, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                    Visibility="{Binding DataContext.IsDiagnosticResultVisible, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="系统诊断结果"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,6,0,12"
                                               Foreground="#475569"
                                               Text="{Binding StatusText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="生成时间" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding GeneratedAtText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Core" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding CoreText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Worker" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding WorkerText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Queue" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding QueueText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Checks" />
                                    <TextBlock Margin="0,3,0,10"
                                               Text="{Binding ChecksText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                    <TextBlock FontWeight="SemiBold" Text="Warnings" />
                                    <TextBlock Margin="0,3,0,0"
                                               Text="{Binding WarningsText, Mode=OneWay}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="2">
                        <Button Width="96"
                                Margin="0,0,10,8"
                                Click="Cancel_Click"
                                IsEnabled="{Binding CanCancelSelected, Mode=OneWay}"
                                Content="取消任务" />
                        <Button Width="110"
                                Margin="0,0,10,8"
                                Click="Retry_Click"
                                IsEnabled="{Binding CanRetrySelected, Mode=OneWay}"
                                Content="创建重试任务" />
                        <Button Width="118"
                                Margin="0,0,0,8"
                                Click="ViewDiagnosticResult_Click"
                                IsEnabled="{Binding CanViewDiagnosticResult, Mode=OneWay}"
                                Content="查看诊断结果" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4"
                   Margin="0,12,0,0"
                   Foreground="#475569"
                   Text="{Binding StatusMessage, Mode=OneWay}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>