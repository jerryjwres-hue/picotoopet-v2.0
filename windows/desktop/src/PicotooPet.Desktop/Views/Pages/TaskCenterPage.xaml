<UserControl x:Class="PicotooPet.Desktop.Views.Pages.TaskCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignHeight="680"
             d:DesignWidth="960"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="16"
                Background="#FFF7ED"
                BorderBrush="#FED7AA"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="{Binding WorkerStatusText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#9A3412" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding WorkerReasonText}"
                           TextWrapping="Wrap"
                           Foreground="#7C2D12" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,18,0,12">
            <TextBlock DockPanel.Dock="Left"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Text="筛选" />
            <ComboBox Width="180"
                      ItemsSource="{Binding FilterOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedFilter, Mode=TwoWay}" />
            <TextBlock Margin="18,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#64748B"
                       Text="{Binding VisibleTasks.Count, StringFormat=当前 {0} 项}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="460" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0"
                      ItemsSource="{Binding VisibleTasks}"
                      SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="任务类型"
                                        Width="130"
                                        DisplayMemberBinding="{Binding TaskType}" />
                        <GridViewColumn Header="状态"
                                        Width="120"
                                        DisplayMemberBinding="{Binding DisplayStatus}" />
                        <GridViewColumn Header="尝试"
                                        Width="70"
                                        DisplayMemberBinding="{Binding AttemptText}" />
                        <GridViewColumn Header="更新时间"
                                        Width="170"
                                        DisplayMemberBinding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                        <GridViewColumn Header="任务 ID"
                                        Width="260"
                                        DisplayMemberBinding="{Binding TaskId}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Column="2"
                    Padding="18"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="任务详情"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1" Margin="0,16,0,16">
                        <StackPanel DataContext="{Binding SelectedTask}">
                            <TextBlock FontWeight="SemiBold" Text="任务 ID" />
                            <TextBlock Margin="0,3,0,12" Text="{Binding TaskId}" TextWrapping="Wrap" />
                            <TextBlock FontWeight="SemiBold" Text="原始状态" />
                            <TextBlock Margin="0,3,0,12" Text="{Binding Status}" />
                            <TextBlock FontWeight="SemiBold" Text="用户状态" />
                            <TextBlock Margin="0,3,0,12" Text="{Binding DisplayStatus}" />
                            <TextBlock FontWeight="SemiBold" Text="创建时间" />
                            <TextBlock Margin="0,3,0,12" Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />
                            <TextBlock FontWeight="SemiBold" Text="更新时间" />
                            <TextBlock Margin="0,3,0,12" Text="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />
                            <TextBlock FontWeight="SemiBold" Text="优先级 / 超时" />
                            <TextBlock Margin="0,3,0,12">
                                <Run Text="{Binding Priority, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding TimeoutSeconds, Mode=OneWay}" />
                                <Run Text=" 秒" />
                            </TextBlock>
                            <TextBlock FontWeight="SemiBold" Text="错误" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding Error}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Width="96"
                                Margin="0,0,10,0"
                                Click="Cancel_Click"
                                IsEnabled="{Binding CanCancelSelected}"
                                Content="取消任务" />
                        <Button Width="110"
                                Click="Retry_Click"
                                IsEnabled="{Binding CanRetrySelected}"
                                Content="创建重试任务" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#475569"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
