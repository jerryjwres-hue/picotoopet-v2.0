<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorTaskListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <SolidColorBrush x:Key="TaskText" Color="#FF172236" />
    <SolidColorBrush x:Key="TaskMuted" Color="#FF718197" />
    <DropShadowEffect x:Key="TaskCardShadow"
                      BlurRadius="13"
                      ShadowDepth="2"
                      Opacity="0.075"
                      Color="#FF63768E" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,18,22,24"
                MaxWidth="1100"
                HorizontalAlignment="Stretch">
      <!-- Summary card : copy stays generic because list contents are the authoritative task facts. -->
      <Border Padding="17,14"
              Margin="0,0,0,13"
              CornerRadius="14"
              Background="White"
              BorderBrush="#FFDCE6F2"
              BorderThickness="1"
              Effect="{StaticResource TaskCardShadow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="42"
                  Height="42"
                  CornerRadius="12"
                  Background="#FFEAF3FF"
                  Margin="0,0,12,0">
            <TextBlock Text="▤"
                       FontSize="20"
                       Foreground="#FF2677E8"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="任务列表"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TaskText}" />
            <TextBlock Text="{Binding EmptyMessage, Mode=OneWay}"
                       Margin="0,3,0,0"
                       Foreground="{StaticResource TaskMuted}"
                       FontSize="10.5"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="2"
                  Padding="8,4"
                  VerticalAlignment="Center"
                  Background="#FFF4F8FD"
                  BorderBrush="#FFDDE8F4"
                  BorderThickness="1"
                  CornerRadius="9">
            <TextBlock Text="实时任务事实"
                       Foreground="#FF65809F"
                       FontSize="8.5" />
          </Border>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#FFDCE6F2"
                    BorderThickness="1"
                    CornerRadius="14"
                    Background="White"
                    Padding="15,13"
                    Margin="0,0,0,9"
                    Effect="{StaticResource TaskCardShadow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34"
                        Height="34"
                        CornerRadius="10"
                        Background="#FFF1F6FD"
                        VerticalAlignment="Top">
                  <TextBlock Text="🐾"
                             FontSize="15"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="3,0,18,0">
                  <TextBlock Text="{Binding Title, Mode=OneWay}"
                             FontSize="14"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TaskText}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding StageText, Mode=OneWay}"
                             Margin="0,4,0,0"
                             Foreground="#FF5F7188"
                             FontSize="10.5"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ErrorText, Mode=OneWay}"
                             Margin="0,5,0,0"
                             Foreground="#FFB42318"
                             FontSize="9.5"
                             TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            MinWidth="110"
                            HorizontalAlignment="Right">
                  <Border Padding="8,4"
                          CornerRadius="9"
                          Background="#FFEEF5FF"
                          BorderBrush="#FFDCEAFB"
                          BorderThickness="1"
                          HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               Foreground="#FF276FCB"
                               FontSize="9.5"
                               FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding UpdatedAtText, Mode=OneWay}"
                             Margin="0,7,0,0"
                             Foreground="{StaticResource TaskMuted}"
                             FontSize="9"
                             HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
