<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorTaskListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
  <UserControl.Resources>
    <SolidColorBrush x:Key="TaskText" Color="#FF172236" />
    <SolidColorBrush x:Key="TaskMuted" Color="#FF61738A" />
    <DropShadowEffect x:Key="TaskCardShadow"
                      BlurRadius="13"
                      ShadowDepth="2"
                      Opacity="0.075"
                      Color="#FF63768E" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,20,24,28"
                MaxWidth="1180"
                HorizontalAlignment="Stretch">
      <Border Padding="18,16"
              Margin="0,0,0,14"
              CornerRadius="14"
              Background="White"
              BorderBrush="#FFDCE6F2"
              BorderThickness="1"
              Effect="{StaticResource TaskCardShadow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="44"
                  Height="44"
                  CornerRadius="12"
                  Background="#FFEAF3FF"
                  Margin="0,0,14,0">
            <TextBlock Text="▤"
                       FontSize="20"
                       Foreground="#FF2677E8"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="任务列表"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TaskText}" />
            <TextBlock Text="{Binding EmptyMessage, Mode=OneWay}"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource TaskMuted}"
                       FontSize="13"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ActionMessage, Mode=OneWay}"
                       Margin="0,4,0,0"
                       Foreground="#FF426489"
                       FontSize="13"
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      VerticalAlignment="Center">
            <Button Content="全选当前页"
                    Click="SelectAll_Click"
                    MinWidth="104"
                    Height="38"
                    Margin="0,0,8,0"
                    Padding="12,0"
                    FontSize="13" />
            <Button Content="取消选择"
                    Click="ClearSelection_Click"
                    MinWidth="92"
                    Height="38"
                    Margin="0,0,8,0"
                    Padding="12,0"
                    FontSize="13" />
            <Button Content="{Binding BulkActionText}"
                    Click="BulkAction_Click"
                    MinWidth="92"
                    Height="38"
                    Padding="12,0"
                    FontSize="13"
                    FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#FFDCE6F2"
                    BorderThickness="1"
                    CornerRadius="14"
                    Background="White"
                    Padding="16,14"
                    Margin="0,0,0,10"
                    Effect="{StaticResource TaskCardShadow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42" />
                  <ColumnDefinition Width="44" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Width="22"
                          Height="22"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          ToolTip="选择此任务" />

                <Border Grid.Column="1"
                        Width="36"
                        Height="36"
                        CornerRadius="10"
                        Background="#FFF1F6FD"
                        VerticalAlignment="Center">
                  <TextBlock Text="🐾"
                             FontSize="16"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>

                <Button Grid.Column="2"
                        Click="OpenTask_Click"
                        Margin="6,0,16,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand">
                  <StackPanel>
                    <TextBlock Text="{Binding Title, Mode=OneWay}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TaskText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StageText, Mode=OneWay}"
                               Margin="0,5,0,0"
                               Foreground="#FF53677F"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorText, Mode=OneWay}"
                               Margin="0,6,0,0"
                               Foreground="#FFB42318"
                               FontSize="13"
                               TextWrapping="Wrap" />
                    <TextBlock Text="点击查看任务详情和结果"
                               Margin="0,6,0,0"
                               Foreground="#FF2677E8"
                               FontSize="12" />
                  </StackPanel>
                </Button>

                <StackPanel Grid.Column="3"
                            MinWidth="150"
                            HorizontalAlignment="Right">
                  <Border Padding="9,5"
                          CornerRadius="9"
                          Background="#FFEEF5FF"
                          BorderBrush="#FFDCEAFB"
                          BorderThickness="1"
                          HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               Foreground="#FF276FCB"
                               FontSize="12"
                               FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding UpdatedAtText, Mode=OneWay}"
                             Margin="0,8,0,0"
                             Foreground="{StaticResource TaskMuted}"
                             FontSize="12"
                             HorizontalAlignment="Right" />
                  <Button Content="{Binding DataContext.SingleActionText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Click="SingleAction_Click"
                          MinWidth="76"
                          Height="34"
                          Margin="0,10,0,0"
                          Padding="12,0"
                          FontSize="12"
                          HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
