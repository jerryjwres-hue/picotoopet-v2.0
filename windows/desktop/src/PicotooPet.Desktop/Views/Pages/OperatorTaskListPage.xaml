<UserControl x:Class="PicotooPet.Desktop.Views.Pages.OperatorTaskListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28" MaxWidth="980" HorizontalAlignment="Left">
      <TextBlock Text="{Binding EmptyMessage, Mode=OneWay}" Foreground="#FF6B7280" Margin="0,0,0,12" />
      <ItemsControl ItemsSource="{Binding Items, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding StageText, Mode=OneWay}" Margin="0,5,0,0" Foreground="#FF4B5563" />
                  <TextBlock Text="{Binding ErrorText, Mode=OneWay}" Margin="0,5,0,0" Foreground="#FFB91C1C" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="20,0,0,0" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding UpdatedAtText, Mode=OneWay}" Margin="0,5,0,0" Foreground="#FF6B7280" FontSize="12" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
