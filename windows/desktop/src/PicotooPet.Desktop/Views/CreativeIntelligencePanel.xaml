<UserControl x:Class="PicotooPet.Desktop.Views.CreativeIntelligencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Panel_Loaded">
  <Border BorderThickness="1" BorderBrush="#33000000" Padding="14">
    <StackPanel>
      <TextBlock Text="创意智能 · Creative Intelligence" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,5,0,0"
                 Text="只消费同一项目、Completed/PASS 的 Result Package；Mac 本地模型生成 Idea → Brief → Script → renderer-neutral Shot Plan。"
                 TextWrapping="Wrap" />
      <TextBlock Margin="0,3,0,0" FontWeight="SemiBold"
                 Text="{Binding BoundaryText, Mode=OneWay}" />
      <TextBlock Margin="0,3,0,8"
                 Text="{Binding CapabilityStatus, Mode=OneWay}"
                 TextWrapping="Wrap" />

      <TextBlock FontWeight="SemiBold" Text="1. 选择 1–8 个同项目 PASS Result Package" />
      <DataGrid Margin="0,5,0,8" Height="170"
                ItemsSource="{Binding Sources, Mode=OneWay}"
                AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected, Mode=TwoWay}" Width="45" />
          <DataGridTextColumn Header="项目" Binding="{Binding ProjectKey, Mode=OneWay}" Width="1.2*" IsReadOnly="True" />
          <DataGridTextColumn Header="Profile" Binding="{Binding AnalysisProfile, Mode=OneWay}" Width="1.6*" IsReadOnly="True" />
          <DataGridTextColumn Header="摘要" Binding="{Binding Summary, Mode=OneWay}" Width="2.8*" IsReadOnly="True" />
          <DataGridTextColumn Header="Result ID" Binding="{Binding ResultPackageId, Mode=OneWay}" Width="1.8*" IsReadOnly="True" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock FontWeight="SemiBold" Text="2. 可选 Creative Objective（业务目标，不是系统 Prompt）" />
      <TextBox Margin="0,5,0,3" MaxLength="2000" AcceptsReturn="True" Height="62"
               Text="{Binding CreativeObjective, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
      <TextBlock Text="{Binding ObjectiveCharacterCount, Mode=OneWay, StringFormat=已输入 {0}/2000 字符}" />

      <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
        <Button Content="准备创意方案" Click="Prepare_Click" IsEnabled="{Binding CanPrepare, Mode=OneWay}" />
        <Button Content="刷新创意状态" Click="Refresh_Click" />
        <Button Content="取消所选创意任务" Click="Cancel_Click" IsEnabled="{Binding CanCancel, Mode=OneWay}" />
        <Button Content="导出 Creative Package" Click="ExportPackage_Click" IsEnabled="{Binding CanExportPackage, Mode=OneWay}" />
        <Button Content="导出 Creative Deep-AI Handoff" Click="ExportHandoff_Click" IsEnabled="{Binding CanExportHandoff, Mode=OneWay}" />
      </StackPanel>

      <DataGrid Height="160"
                ItemsSource="{Binding Jobs, Mode=OneWay}"
                SelectedItem="{Binding SelectedJob, Mode=TwoWay}"
                AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="项目" Binding="{Binding ProjectKey, Mode=OneWay}" Width="1.2*" />
          <DataGridTextColumn Header="状态" Binding="{Binding Status, Mode=OneWay}" Width="120" />
          <DataGridTextColumn Header="阶段" Binding="{Binding CurrentStage, Mode=OneWay}" Width="150" />
          <DataGridTextColumn Header="Creative Package" Binding="{Binding CreativePackageId, Mode=OneWay}" Width="1.8*" />
          <DataGridTextColumn Header="Failure" Binding="{Binding FailureCode, Mode=OneWay}" Width="1.2*" />
          <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt, Mode=OneWay}" Width="175" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Margin="0,7,0,0" Text="{Binding StatusMessage, Mode=OneWay}" TextWrapping="Wrap" />
      <TextBlock Margin="0,4,0,0" FontWeight="SemiBold"
                 Text="不会调用付费 AI，不执行 ComfyUI，不接受 Model / Endpoint / System Prompt / Command / Path / Tool / Workflow 输入。"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
