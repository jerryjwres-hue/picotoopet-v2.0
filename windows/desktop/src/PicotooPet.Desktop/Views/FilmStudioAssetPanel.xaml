<UserControl x:Class="PicotooPet.Desktop.Views.FilmStudioAssetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderThickness="1" BorderBrush="#33000000" Padding="14" Margin="0,0,0,16">
    <StackPanel>
      <TextBlock Text="本地素材 · 角色 / 场景 / 风格" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="先载入剧本，再选择已有项目和素材。Core 登记副本并核验内容；不移动原文件，不批准 Owner、MASTER 或 GPU。"
                 Margin="0,5,0,8" TextWrapping="Wrap" />
      <StackPanel x:Name="AssetControls">
        <WrapPanel>
          <ComboBox x:Name="AssetProjectSelector" Width="280" Margin="0,4,8,4"
                    DisplayMemberPath="Title" SelectionChanged="Project_SelectionChanged"
                    AutomationProperties.Name="影视素材所属项目" />
          <Button x:Name="RefreshAssetProjectsButton" Content="读取已有项目"
                  Click="RefreshProjects_Click" />
        </WrapPanel>
        <WrapPanel>
          <Button x:Name="ImportCharacterButton" Tag="character" Content="选择角色图片"
                  Click="ImportAsset_Click" IsEnabled="False" />
          <Button x:Name="ImportSceneButton" Tag="scene" Content="选择场景图片"
                  Click="ImportAsset_Click" IsEnabled="False" />
          <Button x:Name="ImportStyleButton" Tag="style" Content="选择风格锁"
                  Click="ImportAsset_Click" IsEnabled="False" />
        </WrapPanel>
      </StackPanel>
      <TextBlock x:Name="AssetStatus" Margin="0,7,0,0" TextWrapping="Wrap"
                 Text="选择项目后方可登记。没有项目时，请先通过高级 → 项目创建；不会自动创建。" />
    </StackPanel>
  </Border>
</UserControl>
