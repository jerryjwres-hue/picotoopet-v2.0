<UserControl x:Class="PicotooPet.Desktop.Views.FilmStudioAssetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border BorderThickness="1" BorderBrush="#33000000" Padding="14" Margin="0,0,0,16">
    <StackPanel>
      <TextBlock Text="本地素材 · 角色 / 场景 / 风格" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="先载入剧本，再选择已有项目和素材。Core 登记副本并核验内容；不移动原文件，不批准 Owner、MASTER 或 GPU。"
                 Margin="0,5,0,8" TextWrapping="Wrap" />
      <StackPanel x:Name="AssetControls">
        <Button x:Name="LoadDynamicPilotButton" Content="载入茅台动态三镜示例（发现 → 接近 → 进食）"
                HorizontalAlignment="Left" Click="LoadDynamicPilot_Click" Margin="0,0,0,5" />
        <WrapPanel>
          <ComboBox x:Name="AssetProjectSelector" Width="280" Margin="0,4,8,4"
                    DisplayMemberPath="Title" SelectionChanged="Project_SelectionChanged"
                    AutomationProperties.Name="影视素材所属项目" />
          <Button x:Name="RefreshAssetProjectsButton" Content="读取已有项目"
                  Click="RefreshProjects_Click" />
        </WrapPanel>
        <WrapPanel>
          <Button x:Name="ImportCharacterButton" Tag="character" Content="选择角色图片"
                  Click="ImportAsset_Click" IsEnabled="False" />
          <Button x:Name="ImportSceneButton" Tag="scene" Content="选择场景图片"
                  Click="ImportAsset_Click" IsEnabled="False" />
          <Button x:Name="ImportStyleButton" Tag="style" Content="选择风格锁"
                  Click="ImportAsset_Click" IsEnabled="False" />
          <Button x:Name="RegisterLoraButton" Content="登记已有茅台 LoRA（仅摘要，不上传模型）"
                  Click="RegisterLora_Click" IsEnabled="False" Margin="8,0,0,0" />
        </WrapPanel>
        <!-- 设备声明是源证据，不是正式 OwnerPrincipal 审核，也不会打开 GPU。 -->
        <Expander Header="使用已有声明或首次填写宠物事实" IsExpanded="True" Margin="0,10,0,0">
          <StackPanel Margin="5">
            <TextBlock Text="宠物身份键（英文字母，如 pet:maotai）" />
            <TextBox x:Name="ScopedSubjectInput" MaxLength="68" Width="240" HorizontalAlignment="Left" />
            <CheckBox x:Name="ReuseOwnerPacket" IsChecked="True" Margin="0,6,0,3"
                      Content="查找并核对与当前角色字节完全匹配的已有声明" />
            <TextBlock Text="首次使用或更新声明时填写以下真实内容；已有匹配声明时不必重复填写。" TextWrapping="Wrap" />
            <TextBlock Text="角色事实（真实外观，不推测）" Margin="0,5,0,0" />
            <TextBox x:Name="OwnerIdentityInput" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="36" />
            <TextBlock Text="场景事实（已有素材中可确认的环境）" Margin="0,5,0,0" />
            <TextBox x:Name="OwnerSceneInput" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="36" />
            <TextBlock Text="本次故事动作（创作意图，不是已发生事实）" Margin="0,5,0,0" />
            <TextBox x:Name="OwnerIntentInput" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="36" />
          </StackPanel>
        </Expander>
        <Button x:Name="SubmitScopedStoryButton" Content="检查素材并提交动态创意 Goal（需确认）"
                HorizontalAlignment="Left" Margin="0,8,0,0" Click="SubmitScopedStory_Click" IsEnabled="False" />
      </StackPanel>
      <TextBlock x:Name="AssetStatus" Margin="0,7,0,0" TextWrapping="Wrap"
                 Text="选择项目后方可登记。没有项目时，请先通过高级 → 项目创建；不会自动创建。" />
    </StackPanel>
  </Border>
</UserControl>
