<UserControl x:Class="PicotooPet.Desktop.Views.AssistantPetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220"
             Height="246"
             Focusable="False">
  <UserControl.Resources>
    <LinearGradientBrush x:Key="PetDarkBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF111827" Offset="0" />
      <GradientStop Color="#FF34415A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PetCreamBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFF7E8" Offset="0" />
      <GradientStop Color="#FFE9DCC6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeadphoneBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF4BA3FF" Offset="0" />
      <GradientStop Color="#FF185DDC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LaptopBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFC8D1DF" Offset="0" />
      <GradientStop Color="#FF7E8A9D" Offset="1" />
    </LinearGradientBrush>
  </UserControl.Resources>

  <Grid x:Name="PetSurface"
        Background="Transparent"
        ClipToBounds="False"
        MouseMove="PetSurface_MouseMove"
        MouseLeave="PetSurface_MouseLeave"
        MouseLeftButtonDown="PetSurface_MouseLeftButtonDown">
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="*" />
      <RowDefinition Height="44" />
    </Grid.RowDefinitions>

    <!-- 状态栏与主程序事实分离，仅显示只读投影。 -->
    <Grid Grid.Row="0" Margin="4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="AI 助手状态"
                 Foreground="White"
                 FontSize="14"
                 FontWeight="SemiBold"
                 VerticalAlignment="Center" />
      <Ellipse x:Name="StatusLamp"
               Grid.Column="1"
               Width="10"
               Height="10"
               Margin="8,0,2,0"
               Fill="#FF20C878"
               VerticalAlignment="Center" />
    </Grid>

    <Canvas Grid.Row="1"
            Width="214"
            Height="170"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ClipToBounds="False">
      <!-- 接触阴影独立于角色部件，不参与交互动画。 -->
      <Ellipse Canvas.Left="33"
               Canvas.Top="147"
               Width="154"
               Height="18"
               Fill="#59000000" />

      <!-- 尾巴为独立部件，可单独摇摆。 -->
      <Canvas x:Name="TailGroup"
              Canvas.Left="24"
              Canvas.Top="84"
              Width="62"
              Height="60"
              RenderTransformOrigin="0.85,0.75">
        <Canvas.RenderTransform>
          <RotateTransform x:Name="TailRotate" Angle="-8" />
        </Canvas.RenderTransform>
        <Path Data="M52,48 C18,50 5,25 18,10 C26,1 40,4 44,14 C31,17 27,25 31,31 C36,38 45,37 55,34 Z"
              Fill="{StaticResource PetDarkBrush}" />
        <Path Data="M23,12 C17,14 13,21 14,27 C19,22 25,20 31,20 C30,16 27,13 23,12 Z"
              Fill="{StaticResource PetCreamBrush}" />
      </Canvas>

      <!-- 躯干与胸口使用不同变换，呼吸不是整张图片位移。 -->
      <Canvas x:Name="BodyGroup"
              Canvas.Left="55"
              Canvas.Top="67"
              Width="112"
              Height="92"
              RenderTransformOrigin="0.5,0.85">
        <Canvas.RenderTransform>
          <ScaleTransform x:Name="BodyScale" ScaleX="1" ScaleY="1" />
        </Canvas.RenderTransform>
        <Ellipse Width="112" Height="92" Fill="{StaticResource PetDarkBrush}" />
        <Ellipse Canvas.Left="28"
                 Canvas.Top="24"
                 Width="60"
                 Height="67"
                 Fill="{StaticResource PetCreamBrush}" />
      </Canvas>

      <!-- 头、耳、眼、口鼻、耳机均为独立 WPF 图层，可分别运动。 -->
      <Canvas x:Name="HeadGroup"
              Canvas.Left="52"
              Canvas.Top="4"
              Width="118"
              Height="105"
              RenderTransformOrigin="0.5,0.75">
        <Canvas.RenderTransform>
          <RotateTransform x:Name="HeadRotate" Angle="0" />
        </Canvas.RenderTransform>

        <Polygon Points="10,37 20,2 47,28"
                 Fill="#FF202B3B" />
        <Polygon Points="72,27 98,2 109,39"
                 Fill="#FF202B3B" />
        <Polygon Points="17,29 23,10 38,29"
                 Fill="#FFE8B8A5" />
        <Polygon Points="82,28 96,10 102,31"
                 Fill="#FFE8B8A5" />

        <Ellipse Canvas.Left="9"
                 Canvas.Top="18"
                 Width="100"
                 Height="83"
                 Fill="{StaticResource PetDarkBrush}" />
        <Ellipse Canvas.Left="18"
                 Canvas.Top="40"
                 Width="41"
                 Height="43"
                 Fill="{StaticResource PetCreamBrush}" />
        <Ellipse Canvas.Left="59"
                 Canvas.Top="40"
                 Width="41"
                 Height="43"
                 Fill="{StaticResource PetCreamBrush}" />
        <Ellipse Canvas.Left="34"
                 Canvas.Top="58"
                 Width="50"
                 Height="37"
                 Fill="#FFFFF9EE" />

        <Canvas x:Name="EyeGroup"
                Canvas.Left="27"
                Canvas.Top="46"
                Width="66"
                Height="24"
                RenderTransformOrigin="0.5,0.5">
          <Canvas.RenderTransform>
            <ScaleTransform x:Name="EyeScale" ScaleX="1" ScaleY="1" />
          </Canvas.RenderTransform>
          <Ellipse Width="20" Height="20" Fill="#FFFDFEFF" />
          <Ellipse Canvas.Left="46" Width="20" Height="20" Fill="#FFFDFEFF" />
          <Ellipse x:Name="LeftPupil"
                   Canvas.Left="6"
                   Canvas.Top="5"
                   Width="10"
                   Height="11"
                   Fill="#FF1C2430">
            <Ellipse.RenderTransform>
              <TranslateTransform x:Name="LeftPupilTranslate" />
            </Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse x:Name="RightPupil"
                   Canvas.Left="52"
                   Canvas.Top="5"
                   Width="10"
                   Height="11"
                   Fill="#FF1C2430">
            <Ellipse.RenderTransform>
              <TranslateTransform x:Name="RightPupilTranslate" />
            </Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Canvas.Left="9" Canvas.Top="6" Width="3" Height="3" Fill="White" />
          <Ellipse Canvas.Left="55" Canvas.Top="6" Width="3" Height="3" Fill="White" />
        </Canvas>

        <Ellipse Canvas.Left="52"
                 Canvas.Top="70"
                 Width="15"
                 Height="10"
                 Fill="#FF121821" />
        <Path x:Name="SmilePath"
              Data="M48,83 C55,91 64,91 71,83"
              Stroke="#FF252A32"
              StrokeThickness="3"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" />
        <Path Data="M22,44 C18,17 33,9 46,8"
              Stroke="#FF3488F6"
              StrokeThickness="6"
              StrokeStartLineCap="Round" />
        <Path Data="M96,44 C100,17 85,9 72,8"
              Stroke="#FF3488F6"
              StrokeThickness="6"
              StrokeStartLineCap="Round" />
        <Ellipse Canvas.Left="13"
                 Canvas.Top="38"
                 Width="18"
                 Height="29"
                 Fill="{StaticResource HeadphoneBrush}" />
        <Ellipse Canvas.Left="87"
                 Canvas.Top="38"
                 Width="18"
                 Height="29"
                 Fill="{StaticResource HeadphoneBrush}" />
      </Canvas>

      <!-- 左右前爪独立，工作状态会交替敲击。 -->
      <Ellipse x:Name="LeftPaw"
               Canvas.Left="65"
               Canvas.Top="119"
               Width="42"
               Height="36"
               Fill="{StaticResource PetCreamBrush}"
               RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <TranslateTransform x:Name="LeftPawTranslate" />
        </Ellipse.RenderTransform>
      </Ellipse>
      <Ellipse x:Name="RightPaw"
               Canvas.Left="118"
               Canvas.Top="119"
               Width="42"
               Height="36"
               Fill="{StaticResource PetCreamBrush}"
               RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform>
          <TranslateTransform x:Name="RightPawTranslate" />
        </Ellipse.RenderTransform>
      </Ellipse>

      <!-- 笔记本和饮料是独立道具，点击下半区时会反馈。 -->
      <Border x:Name="LaptopScreen"
              Canvas.Left="84"
              Canvas.Top="108"
              Width="93"
              Height="53"
              Background="{StaticResource LaptopBrush}"
              BorderBrush="#FFDCE4F0"
              BorderThickness="1"
              CornerRadius="7"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <ScaleTransform x:Name="LaptopScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <TextBlock Text="●"
                   Foreground="#FF6B7688"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <Border Canvas.Left="32"
              Canvas.Top="124"
              Width="24"
              Height="34"
              Background="#E9F6D59D"
              BorderBrush="#FFF9E8BE"
              BorderThickness="1"
              CornerRadius="4">
        <Grid>
          <Rectangle Width="2"
                     Height="24"
                     Fill="#FFEAF7FF"
                     VerticalAlignment="Top"
                     Margin="7,-14,0,0"
                     HorizontalAlignment="Left"
                     RenderTransformOrigin="0.5,1">
            <Rectangle.RenderTransform>
              <RotateTransform Angle="7" />
            </Rectangle.RenderTransform>
          </Rectangle>
        </Grid>
      </Border>

      <TextBlock x:Name="HeartParticle"
                 Canvas.Left="171"
                 Canvas.Top="43"
                 Text="♥"
                 Foreground="#FFFF6C9A"
                 FontSize="24"
                 FontWeight="Bold"
                 Opacity="0">
        <TextBlock.RenderTransform>
          <TranslateTransform x:Name="HeartTranslate" />
        </TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock x:Name="OfflineZzz"
                 Canvas.Left="166"
                 Canvas.Top="24"
                 Text="Z z z"
                 Foreground="#FFBDD0EC"
                 FontSize="15"
                 FontWeight="SemiBold"
                 Opacity="0" />
      <TextBlock x:Name="AttentionMark"
                 Canvas.Left="176"
                 Canvas.Top="42"
                 Text="!"
                 Foreground="#FFFFB044"
                 FontSize="26"
                 FontWeight="Bold"
                 Opacity="0" />
    </Canvas>

    <StackPanel Grid.Row="2"
                Margin="4,1,4,0">
      <TextBlock x:Name="PetTitle"
                 Foreground="White"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Text="休息中" />
      <TextBlock x:Name="PetDetail"
                 Margin="0,2,0,0"
                 Foreground="#FF9EC7EA"
                 FontSize="11"
                 Text="在线 · 当前空闲"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>
  </Grid>
</UserControl>
