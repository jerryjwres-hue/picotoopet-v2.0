<UserControl x:Class="PicotooPet.Desktop.Views.QualityPromotionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Panel_Loaded">
  <Border BorderThickness="1" BorderBrush="#33000000" Padding="14">
    <StackPanel>
      <TextBlock Text="受控晋级 / 回滚 · Controlled Promotion" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,5,0,0"
                 Text="25.1 只把 Supported + AcceptedForPromotionReview Shadow 证据登记为版本化治理事实；Mac Core 分配 slot/version，并要求 exact request digest 人工批准。"
                 TextWrapping="Wrap" />
      <TextBlock Margin="0,3,0,8"
                 FontWeight="SemiBold"
                 Text="Active Promotion 在 25.1 不会被 runtime 读取为可执行 Prompt/Model/Provider/Budget/Workflow；晋级与回滚均不触发 Paid-AI、ComfyUI、Git/GitHub 或发布。"
                 TextWrapping="Wrap" />

      <TextBlock Text="{Binding ProjectText, Mode=OneWay}" TextWrapping="Wrap" />
      <TextBlock Margin="0,3,0,0" Text="{Binding PromotionText, Mode=OneWay}" TextWrapping="Wrap" />
      <TextBlock Margin="0,3,0,0" Text="{Binding ApprovalText, Mode=OneWay}" TextWrapping="Wrap" />
      <TextBlock Margin="0,3,0,8" Text="{Binding RollbackText, Mode=OneWay}" TextWrapping="Wrap" />

      <TextBlock Text="Supported Shadow Evidence" FontWeight="SemiBold" />
      <DataGrid Height="130"
                Margin="0,5,0,0"
                ItemsSource="{Binding SupportedShadows, Mode=OneWay}"
                SelectedItem="{Binding SelectedShadow, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Class" Binding="{Binding CandidateClass, Mode=OneWay}" Width="1.2*" />
          <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict, Mode=OneWay}" Width="110" />
          <DataGridTextColumn Header="Shadow Run" Binding="{Binding ShadowRunId, Mode=OneWay}" Width="1.7*" />
          <DataGridTextColumn Header="Report Digest" Binding="{Binding ReportDigest, Mode=OneWay}" Width="1.7*" />
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel Orientation="Horizontal" Margin="0,7,0,8">
        <Button Content="创建 Promotion Proposal"
                Click="Create_Click"
                IsEnabled="{Binding CanCreate, Mode=OneWay}" />
        <Button Content="刷新 Promotion"
                Click="Refresh_Click" />
      </StackPanel>

      <TextBlock Text="Promotion Versions" FontWeight="SemiBold" />
      <DataGrid Height="160"
                Margin="0,5,0,0"
                ItemsSource="{Binding Promotions, Mode=OneWay}"
                SelectedItem="{Binding SelectedPromotion, Mode=TwoWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Version" Binding="{Binding VersionNo, Mode=OneWay}" Width="75" />
          <DataGridTextColumn Header="Class" Binding="{Binding CandidateClass, Mode=OneWay}" Width="1.1*" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="120" />
          <DataGridTextColumn Header="Proposal Digest" Binding="{Binding ProposalDigest, Mode=OneWay}" Width="1.8*" />
          <DataGridTextColumn Header="Supersedes" Binding="{Binding SupersedesPromotionId, Mode=OneWay}" Width="1.5*" />
        </DataGrid.Columns>
      </DataGrid>

      <StackPanel Orientation="Horizontal" Margin="0,7,0,8">
        <Button Content="批准晋级"
                Click="ApproveActivation_Click"
                IsEnabled="{Binding CanDecideActivation, Mode=OneWay}" />
        <Button Content="拒绝晋级"
                Click="RejectActivation_Click"
                IsEnabled="{Binding CanDecideActivation, Mode=OneWay}" />
        <Button Content="取消晋级"
                Click="CancelActivation_Click"
                IsEnabled="{Binding CanDecideActivation, Mode=OneWay}" />
        <Button Content="Reconcile"
                Click="Reconcile_Click" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Text="Rollback reason" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Width="190"
                  ItemsSource="{Binding RollbackReasons, Mode=OneWay}"
                  SelectedItem="{Binding SelectedRollbackReason, Mode=TwoWay}" />
        <Button Content="申请回滚"
                Click="RequestRollback_Click"
                IsEnabled="{Binding CanRequestRollback, Mode=OneWay}" />
        <Button Content="批准回滚"
                Click="ApproveRollback_Click"
                IsEnabled="{Binding CanDecideRollback, Mode=OneWay}" />
        <Button Content="拒绝回滚"
                Click="RejectRollback_Click"
                IsEnabled="{Binding CanDecideRollback, Mode=OneWay}" />
        <Button Content="取消回滚"
                Click="CancelRollback_Click"
                IsEnabled="{Binding CanDecideRollback, Mode=OneWay}" />
      </StackPanel>

      <TextBlock Text="Immutable Decision History" FontWeight="SemiBold" />
      <DataGrid Height="120"
                Margin="0,5,0,0"
                ItemsSource="{Binding History.Decisions, Mode=OneWay}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Decision" Binding="{Binding Decision, Mode=OneWay}" Width="100" />
          <DataGridTextColumn Header="Request Digest" Binding="{Binding RequestDigest, Mode=OneWay}" Width="1.8*" />
          <DataGridTextColumn Header="Decision Digest" Binding="{Binding DecisionDigest, Mode=OneWay}" Width="1.8*" />
          <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, Mode=OneWay}" Width="180" />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Margin="0,7,0,0"
                 Text="{Binding StatusMessage, Mode=OneWay}"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
