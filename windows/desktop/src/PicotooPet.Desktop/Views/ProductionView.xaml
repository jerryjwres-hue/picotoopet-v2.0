<UserControl x:Class="PicotooPet.Desktop.Views.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="ShowWhenTrue"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,6" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#CFE8E6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Resources>
  <Grid Margin="16" Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,12" LastChildFill="False">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="生产审片" FontSize="23" FontWeight="SemiBold" Foreground="#192536" />
        <TextBlock Text="为每个分镜选用一个视频后可合成。" Foreground="#536174" Margin="0,4,0,0" />
        <TextBlock Text="{Binding WorkerProjectStatus}" Foreground="#536174"
                   Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="选择视频目录（首次）" Click="ChooseWorkerProject"
                ToolTip="仅首次选择已有 Windows Worker 视频工程根目录，后续自动记住。" />
        <Button Content="同步已审核首帧" Command="{Binding SyncApprovedFramesCommand}"
                ToolTip="只下载 Mac 已批准且 SHA 匹配的参考图；不创建视频任务或放行 GPU。" />
        <Button Content="打开本地批次" Click="OpenBatch" IsEnabled="{Binding CanOpenBatch}" />
        <Button Content="刷新" Command="{Binding RefreshCommand}" />
        <Button Content="合成本集" Command="{Binding AssembleCommand}" Style="{StaticResource PrimaryAction}" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="243" />
      </Grid.ColumnDefinitions>

      <Border Background="#F3F5F8" Padding="12" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
          </Grid.RowDefinitions>
          <TextBlock Text="剧集" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Episodes}" SelectedItem="{Binding Episode}"
                   DisplayMemberPath="Title" Background="Transparent" BorderThickness="0"
                   AutomationProperties.Name="剧集" />
          <TextBlock Grid.Row="2" Text="分镜" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,6" />
          <ListBox Grid.Row="3" ItemsSource="{Binding Shots}" SelectedItem="{Binding Shot}"
                   Background="Transparent" BorderThickness="0" AutomationProperties.Name="分镜">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="3,4">
                  <TextBlock Text="{Binding ShotId}" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Status}" Foreground="#49576A" />
                    <TextBlock Text="{Binding RedoCount, StringFormat=重做 {0} 次}"
                               Margin="9,0,0,0" Foreground="#49576A" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="16,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,9">
          <Run Text="候选 " /><Run Text="{Binding Shot.ShotId, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Grid.Row="1" Text="暂无候选" Foreground="#536174"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Candidates.Count}" Value="0">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <ListBox Grid.Row="1" ItemsSource="{Binding Candidates}" SelectedItem="{Binding Candidate}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxWidth="760"
                 Background="Transparent" BorderThickness="0" AutomationProperties.Name="候选产物"
                 MouseDoubleClick="PlayCandidate">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="158" Margin="3" BorderBrush="#E0E5EC" BorderThickness="1" CornerRadius="5">
                <StackPanel>
                  <Grid Height="94" Background="#E9EDF2" ClipToBounds="True">
                    <TextBlock Text="{Binding KindName}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="#5C6879" />
                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                  </Grid>
                  <StackPanel Margin="8,5">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FileName}" Foreground="#49576A"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                    <TextBlock Text="{Binding Origin}" Foreground="#49576A" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Origin}" />
                    <TextBlock Text="{Binding DecisionName}" Foreground="#206260" Margin="0,3,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <Border Grid.Column="2" Background="#F3F5F8" Padding="12" CornerRadius="8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="质检报告" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
          <DockPanel Grid.Row="1">
            <Image DockPanel.Dock="Bottom" Source="{Binding Candidate.Report}" MaxHeight="160" Stretch="Uniform" AutomationProperties.Name="质检报告图" />
            <TextBox Text="{Binding QcText, Mode=OneWay}" IsReadOnly="True"
                   VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0"
                   AutomationProperties.Name="质检报告" />
          </DockPanel>
          <Button Grid.Row="2" Content="本地播放" Command="{Binding PlayCommand}" Margin="0,8,0,0"
                  ToolTip="{Binding CandidateHint}" />
          <TextBlock Grid.Row="3" Text="审片备注" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,3" />
          <StackPanel Grid.Row="4">
          <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                   Height="61" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000"
                   VerticalScrollBarVisibility="Auto" Margin="0" AutomationProperties.Name="审片备注" />
            <StackPanel Visibility="{Binding HasNoteConflict, Converter={StaticResource ShowWhenTrue}}">
              <TextBlock Text="Mac 备注已更新，请选择要保留的版本。" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Candidate.Record.Note}" TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Candidate.Record.Note}"/>
              <UniformGrid Columns="2"><Button Content="用 Mac 备注" Command="{Binding UseMacNoteCommand}" Padding="2"/>
                <Button Content="保留草稿" Command="{Binding KeepDraftCommand}" Padding="2"/></UniformGrid>
            </StackPanel>
          </StackPanel>
          <UniformGrid Grid.Row="5" Columns="3" Margin="-3,6,-3,0">
            <Button Content="{Binding PickLabel}" Command="{Binding PickCommand}" Padding="4,4" Margin="3"
                    Style="{StaticResource PrimaryAction}" />
            <Button Content="重做" Command="{Binding RedoCommand}" Padding="4,4" Margin="3" />
            <Button Content="不要" Command="{Binding RejectCommand}" Padding="4,4" Margin="3" />
          </UniformGrid>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="#445365" Margin="0,8,0,0"
               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </Grid>
</UserControl>
