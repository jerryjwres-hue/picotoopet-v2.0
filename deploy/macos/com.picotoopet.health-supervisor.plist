<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.picotoopet.health-supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Library/Application Support/PicotooPetV2/current/.venv/bin/picotoopet-core</string>
    <string>supervise</string>
    <string>--loop</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PICOTOO_RUNTIME_ROOT</key>
    <string>__HOME__/Library/Application Support/PicotooPetV2</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>__HOME__/Library/Application Support/PicotooPetV2/current</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Application Support/PicotooPetV2/logs/health-supervisor.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Application Support/PicotooPetV2/logs/health-supervisor.stderr.log</string>
</dict>
</plist>
