<UserControl x:Class="PicotooPet.Desktop.Views.Pages.GoalCenterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="258">
  <UserControl.Resources>
    <Style x:Key="GoalChipButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#26FFFFFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#52FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Margin" Value="0,0,6,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChipBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChipBorder" Property="Background" Value="#40FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ChipBorder" Property="Opacity" Value="0.78" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GoalPrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#FF1769DE" />
      <Setter Property="BorderBrush" Value="#AAFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="PrimaryBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="PrimaryBorder" Property="Background" Value="#FFF0F7FF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.52" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GoalHandoffButtonStyle" TargetType="Button">
      <Setter Property="Visibility" Value="Collapsed" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding HandoffReady}" Value="True">
          <Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Border CornerRadius="18" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF47B2FF" Offset="0" />
        <GradientStop Color="#FF187BF3" Offset="0.48" />
        <GradientStop Color="#FF1764D9" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>

    <Grid Margin="22,16,18,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="226" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Margin="0,0,18,0">
        <StackPanel Orientation="Horizontal">
          <Border Width="38" Height="38" CornerRadius="12"
                  Background="#28FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1"
                  Margin="0,0,10,0">
            <TextBlock Text="✦" Foreground="White" FontSize="18"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="告诉茅台，你想得到什么结果"
                       Foreground="White" FontSize="21" FontWeight="Bold" />
            <TextBlock Text="Windows 只发送目标；Mac 自动研究、筛选、分析并生成结果。"
                       Margin="0,2,0,0" Foreground="#E8FFFFFF" FontSize="9.5" />
          </StackPanel>
        </StackPanel>

        <TextBox x:Name="GoalObjectiveTextBox"
                 Text="{Binding GoalObjective, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,10,0,7"
                 MinHeight="48"
                 MaxLength="2000"
                 Padding="11,8"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 BorderBrush="#68FFFFFF"
                 BorderThickness="1"
                 Background="#F9FFFFFF"
                 Foreground="#FF17243A"
                 FontSize="11"
                 ToolTip="例如：研究大型犬耐咬玩具，找消费者痛点并生成 TikTok AI 视频方案" />

        <ItemsControl x:Name="GoalTemplateItems"
                      ItemsSource="{Binding GoalTemplates, Mode=OneWay}"
                      Margin="0,0,0,3">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Title}"
                      ToolTip="{Binding Description}"
                      Style="{StaticResource GoalChipButtonStyle}"
                      Click="GoalTemplate_Click" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="GoalDepthComboBox"
                    Grid.Column="0"
                    ItemsSource="{Binding GoalDepthOptions, Mode=OneWay}"
                    SelectedItem="{Binding SelectedGoalDepth, Mode=TwoWay}"
                    Height="34"
                    Padding="9,3"
                    ToolTip="选择研究深度；所有研究仍保持只读和有界" />
          <TextBlock Grid.Column="1"
                     Text="{Binding SelectedGoalTemplateTitle, Mode=OneWay}"
                     Margin="10,0,10,0"
                     Foreground="#E8FFFFFF"
                     FontSize="9"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
          <Button x:Name="CreateGoalButton"
                  Grid.Column="2"
                  Content="发送目标  →"
                  IsEnabled="{Binding CanCreateGoal, Mode=OneWay}"
                  Style="{StaticResource GoalPrimaryButtonStyle}"
                  Click="CreateGoal_Click" />
        </Grid>
      </StackPanel>

      <Border x:Name="GoalStatusCard"
              Grid.Column="1"
              Padding="13"
              CornerRadius="14"
              Background="#20FFFFFF"
              BorderBrush="#45FFFFFF"
              BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#FFFFFFFF" VerticalAlignment="Center" Margin="0,0,7,0" />
            <TextBlock Text="{Binding GoalStatusText, Mode=OneWay}"
                       Foreground="White" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock Grid.Row="1"
                     Text="{Binding CurrentGoal.Objective, Mode=OneWay, TargetNullValue=暂无运行中的目标}"
                     Margin="0,9,0,5"
                     Foreground="White"
                     FontSize="10"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     MaxHeight="42" />
          <TextBlock Grid.Row="2"
                     Text="{Binding GoalStatusDetail, Mode=OneWay}"
                     Foreground="#DAFFFFFF"
                     FontSize="8.7"
                     TextWrapping="Wrap"
                     VerticalAlignment="Top" />

          <StackPanel Grid.Row="3" Margin="0,9,0,0">
            <TextBlock Text="{Binding HandoffSummary, Mode=OneWay}"
                       Foreground="#D8FFFFFF" FontSize="8" TextWrapping="Wrap" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
              <Button Content="复制 GPT 提示词"
                      Margin="0,0,5,0"
                      Style="{StaticResource GoalHandoffButtonStyle}"
                      Click="CopyPrompt_Click" />
              <Button Content="保存交接 ZIP"
                      Style="{StaticResource GoalHandoffButtonStyle}"
                      Click="SaveHandoff_Click" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <Button Grid.Column="1"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,-5,-5,0"
              Padding="5,2"
              Content="传统任务入口"
              FontSize="7.5"
              Foreground="#D8FFFFFF"
              Background="Transparent"
              BorderThickness="0"
              Cursor="Hand"
              Click="AdvancedTask_Click" />
    </Grid>
  </Border>
</UserControl>
