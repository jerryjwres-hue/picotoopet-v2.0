{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.picotoopet.local/connector/v1/artifact_manifest.schema.json",
  "title": "Picotoo Pet Connector ArtifactManifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627776
    },
    "mime_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "source_artifact_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "time_range": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start_seconds": {
              "type": "number",
              "minimum": 0
            },
            "end_seconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": ["start_seconds", "end_seconds"]
        }
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "permission_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "artifact_id",
    "project_id",
    "role",
    "uri",
    "sha256",
    "size",
    "mime_type",
    "source_artifact_id",
    "source_revision",
    "time_range",
    "version",
    "permission_tags",
    "created_at"
  ]
}
