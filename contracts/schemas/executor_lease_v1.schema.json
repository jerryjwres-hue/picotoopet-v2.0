{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lease_seconds": {
      "maximum": 3600,
      "minimum": 30,
      "title": "Lease Seconds",
      "type": "integer"
    },
    "resource_tags": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Resource Tags",
      "type": "array"
    },
    "resume_task_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resume Task Id"
    },
    "worker_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "worker_id",
    "resource_tags",
    "lease_seconds"
  ],
  "title": "ExecutorLease",
  "type": "object"
}
