{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picotoopet.local/schemas/performance_report_v2.schema.json",
  "title": "Picotoo Pet V2 Performance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "environment",
    "metrics",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "2.2.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "incomplete"]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine",
        "operating_system",
        "architecture",
        "base_url",
        "rest_samples",
        "task_samples",
        "socket_samples"
      ],
      "properties": {
        "machine": {"type": "string", "minLength": 1},
        "operating_system": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "format": "uri"},
        "rest_samples": {"type": "integer", "minimum": 1},
        "task_samples": {"type": "integer", "minimum": 1},
        "socket_samples": {"type": "integer", "minimum": 1}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metric"
      }
    },
    "last_sequence": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "sample_task_first_id": {
      "type": ["string", "null"]
    },
    "sample_task_last_id": {
      "type": ["string", "null"]
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "p50_ms",
        "p95_ms",
        "p99_ms",
        "max_ms",
        "p95_limit_ms",
        "p99_limit_ms",
        "passed"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "p50_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "p99_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_ms": {
          "type": "number",
          "minimum": 0
        },
        "p95_limit_ms": {
          "type": "number",
          "minimum": 0
        },
        "p99_limit_ms": {
          "type": "number",
          "minimum": 0
        },
        "passed": {
          "type": "boolean"
        }
      }
    }
  }
}
