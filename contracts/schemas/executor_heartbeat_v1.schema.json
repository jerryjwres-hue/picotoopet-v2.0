{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Count"
    },
    "message": {
      "maxLength": 500,
      "title": "Message",
      "type": "string"
    },
    "progress": {
      "maximum": 1,
      "minimum": 0,
      "title": "Progress",
      "type": "number"
    },
    "worker_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "worker_id",
    "progress",
    "message"
  ],
  "title": "ExecutorHeartbeat",
  "type": "object"
}
