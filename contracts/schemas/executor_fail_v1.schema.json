{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Count"
    },
    "error": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Error",
      "type": "string"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "worker_id": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Worker Id",
      "type": "string"
    }
  },
  "required": [
    "worker_id",
    "error",
    "retryable"
  ],
  "title": "ExecutorFail",
  "type": "object"
}
