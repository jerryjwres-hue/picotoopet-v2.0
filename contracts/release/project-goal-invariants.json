{
  "schema_version": "1.0",
  "policy_id": "GOV-GOAL-001",
  "status_semantics": {
    "blocked_environment": [
      "BLOCKED",
      "UNVERIFIED",
      "DIAGNOSTIC"
    ],
    "blocked_environment_must_not_change_goal": true
  },
  "windows": {
    "required_manifest_values": {
      "release_type": "prebuilt",
      "target": "win-x64",
      "source_build_on_user_pc": false,
      "delivery_surface": "existing-native-wpf-desktop",
      "ui_framework": "WPF",
      "entry_executable": "Picotoo Pet AI.exe",
      "integration_target": "TaskCenter",
      "browser_ui": false,
      "local_http_ui": false,
      "github_repository": "jerryjwres-hue/picotoopet-v2.0"
    },
    "product_version": {
      "value": "2.3.18.1",
      "source_path": "src/picotoopet_core/product-version.txt",
      "payload_path": "product-version.txt"
    },
    "required_native_ci_provenance_fields": [
      "github_run_id",
      "github_run_attempt",
      "github_workflow_ref",
      "source_head",
      "source_ref",
      "build_commit"
    ],
    "allowed_native_ci_workflow_paths": [
      ".github/workflows/windows-control-center-ci.yml",
      ".github/workflows/windows-phase2-release.yml"
    ],
    "required_archive_paths": [
      "payload/product-version.txt",
      "payload/Picotoo Pet AI.exe",
      "payload/tools/diagnostics/PicotooPet.Desktop.Diagnostics.exe",
      "Phase2Prebuilt.Common.ps1",
      "Install-Phase2Prebuilt.ps1",
      "Verify-Phase2Prebuilt.ps1",
      "Rollback-Phase2Prebuilt.ps1",
      "INSTALL_PHASE2_WINDOWS.vbs",
      "VERIFY_PHASE2_WINDOWS.vbs",
      "ROLLBACK_PHASE2_WINDOWS.vbs"
    ],
    "allowed_payload_executable_paths": [
      "Picotoo Pet AI.exe",
      "tools/diagnostics/PicotooPet.Desktop.Diagnostics.exe"
    ],
    "forbidden_name_fragments": [
      "slicedhelper",
      "windows-helper",
      "picotoopet slice d.exe"
    ],
    "forbidden_suffixes": [
      ".html",
      ".htm",
      ".js",
      ".css"
    ],
    "user_install_requires_native_ci": true
  },
  "architecture": {
    "fact_source": "Mac Core + SQLite Queue/Outbox",
    "windows_role": "native WPF observation, controlled-command UI, bounded business Inbox/Outbox bridge",
    "worker_role": "explicitly registered task execution and loopback-only local intelligence",
    "historical_analysis_tasks": "unsupported-unleased-unmodified",
    "platform_automation_v1": {
      "workflow_persistence": "Mac Core SQLite",
      "workflow_execution": "existing registered task queue",
      "restart_safe": true,
      "arbitrary_shell": false,
      "implicit_paid_provider_call": false,
      "business_adapters": "business-work-package-v1"
    },
    "business_automation_v1": {
      "work_package_schema": "1.0",
      "result_package_schema": "1.0",
      "database_schema": 11,
      "windows_ingress": "fixed-localappdata-inbox",
      "windows_egress": "fixed-localappdata-outbox",
      "upload_chunk_bytes": 4194304,
      "analysis_profiles": [
        "reviews.voice_of_customer.v1",
        "ideas.pattern_analysis.v1"
      ],
      "worker_capability": "local.intelligence.v1",
      "worker_task_type": "business.local_intelligence.v1",
      "local_model_transport": "mac-loopback-openai-compatible",
      "default_local_model": "gpt-oss:20b",
      "producer_supplied_model_endpoint_prompt_path_command_tool": false,
      "model_tools": false,
      "automatic_paid_ai": false,
      "automatic_comfyui": false,
      "manual_deep_ai_handoff_only": true,
      "max_model_attempts_per_stage": 2
    },
    "phase10d_c_commit_boundary": {
      "source_state": "adoption_ready",
      "success_state": "commit_ready",
      "approval_type": "provider.commit.create-v1",
      "local_ref_prefix": "refs/picotoopet/commit-candidates/",
      "git_hooks": false,
      "git_filters": false,
      "network": false,
      "automatic_branch": false,
      "automatic_push": false,
      "automatic_pr": false,
      "automatic_merge": false,
      "automatic_tag": false,
      "automatic_release": false
    },
    "phase10e_publication_boundary": {
      "source_state": "commit_ready",
      "success_state": "pr_ready",
      "approval_type": "provider.publish.pr-create-v1",
      "remote_ref_prefix": "refs/heads/picotoopet/commit-candidates/",
      "base_source": "immutable Handoff base_ref + base_commit",
      "push_requires_human_approval": true,
      "draft_pr_creation_requires_same_approval": true,
      "force_push": false,
      "user_supplied_repo_ref_base_head_title_body": false,
      "automatic_merge": false,
      "automatic_tag": false,
      "automatic_release": false
    }
  },
  "change_control": {
    "explicit_user_approval_required_before_implementation": [
      "product_form",
      "ui_technology",
      "host_application",
      "integration_point",
      "control_execution_boundary",
      "fact_source",
      "persistence_model",
      "install_verify_rollback_workflow",
      "acceptance_criteria",
      "native_platform_gates",
      "security_privacy_approval_boundaries"
    ]
  }
}
