{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.picotoopet.local/handoff/v1/handoff.schema.json",
  "title": "Picotoo Pet Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sandbox_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))D:/PicotooPet/DevSandbox/(?:worktrees|handoff-inbox|sessions|return-packages|quarantine)/[A-Za-z0-9._~!$&'()*+,;=:@%/\\-]+$"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "project_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider": {
      "enum": ["grok_build", "codex", "claude_code", "chatgpt_work", "manual"]
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sensitivity": {
      "enum": ["public", "internal", "confidential", "protected_derived"]
    },
    "repo_url": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+/[A-Za-z0-9._~/-]+(?:\\.git)?$",
      "maxLength": 2048
    },
    "base_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {
        "enum": ["main", "master", "refs/heads/main", "refs/heads/master"]
      }
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "allowed_read": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sandbox_path"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "allowed_write": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sandbox_path"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 1,
      "maxItems": 128
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400
    },
    "budget": {
      "$ref": "https://schemas.picotoopet.local/handoff/v1/cost_budget.schema.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schema_version",
    "handoff_id",
    "task_id",
    "project_id",
    "trace_id",
    "provider",
    "adapter_version",
    "request_digest",
    "package_digest",
    "sensitivity",
    "repo_url",
    "base_ref",
    "base_commit",
    "allowed_read",
    "allowed_write",
    "required_tests",
    "max_turns",
    "timeout_seconds",
    "budget",
    "created_at",
    "expires_at",
    "approval_id"
  ]
}
