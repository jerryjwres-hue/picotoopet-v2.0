{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.picotoopet.local/handoff/v1/test_report.schema.json",
  "title": "Picotoo Pet Return TestReport v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "environment": {
            "type": "object",
            "additionalProperties": true
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "ended_at": {
            "type": "string",
            "format": "date-time"
          },
          "exit_code": {
            "type": ["integer", "null"]
          },
          "status": {
            "enum": ["pass", "fail", "not_run"]
          },
          "stdout_ref": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 2048
          },
          "stderr_ref": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 2048
          },
          "truncated": {
            "type": "boolean"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          }
        },
        "required": [
          "command",
          "environment",
          "started_at",
          "ended_at",
          "exit_code",
          "status",
          "stdout_ref",
          "stderr_ref",
          "truncated",
          "timeout_seconds"
        ]
      }
    }
  },
  "required": ["schema_version", "commands"]
}
