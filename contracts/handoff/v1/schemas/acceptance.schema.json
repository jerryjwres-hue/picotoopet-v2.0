{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.picotoopet.local/handoff/v1/acceptance.schema.json",
  "title": "Picotoo Pet Handoff Acceptance v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "type": {
            "enum": ["command", "assertion", "human_review"]
          },
          "command": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 2000
          },
          "assertion": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 2000
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "required": {
            "type": "boolean"
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "id",
          "description",
          "type",
          "command",
          "assertion",
          "expected",
          "required",
          "evidence_path"
        ]
      }
    }
  },
  "required": ["schema_version", "items"]
}
