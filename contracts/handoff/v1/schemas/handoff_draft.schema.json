{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.picotoopet.local/handoff/v1/handoff_draft.schema.json",
  "title": "Picotoo Pet Phase 10A Handoff Draft",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0-draft"
    },
    "template_id": {
      "const": "picotoopet-repo-maintenance-v1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "objective_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "provider": {
      "const": "manual"
    },
    "provider_configured": {
      "const": false
    },
    "sensitivity": {
      "const": "internal"
    },
    "repo_url": {
      "const": "https://github.com/jerryjwres-hue/picotoopet-v2.0"
    },
    "base_ref": {
      "const": "feature/phase23-slice-d-diagnostic-snapshot-release"
    },
    "base_commit": {
      "const": "5db6b1f9340ff5abe0d38bbb7b6e3ee9b48c34bb"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schema_version",
    "template_id",
    "title",
    "objective_summary",
    "provider",
    "provider_configured",
    "sensitivity",
    "repo_url",
    "base_ref",
    "base_commit",
    "request_digest",
    "package_digest",
    "approval_id"
  ]
}
